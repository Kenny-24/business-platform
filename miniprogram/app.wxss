page {
  --color-bg: #fbfaf7;
  --color-surface: #ffffff;
  --color-primary: #68764b;
  --color-primary-dark: #53613a;
  --color-accent: #db7278;
  --color-text: #24231f;
  --color-text-secondary: #858077;
  --color-line: #ece9e2;
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view,
scroll-view,
swiper,
swiper-item,
image,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  min-width: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1;
  text-align: inherit;
}

button::after {
  border: 0;
}

image {
  display: block;
}

.safe-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: 38rpx;
}

.card {
  background: var(--color-surface);
  border: 1rpx solid rgba(71, 66, 55, 0.045);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(65, 58, 45, 0.035);
}

.muted { color: var(--color-text-secondary); }
.price { color: var(--color-accent); }
.song-font { font-family: "Songti SC", "STSong", "SimSun", serif; }
