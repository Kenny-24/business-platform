.category-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.category-layout {
  display: flex;
  width: 100%;
  min-height: 320px;
  overflow: hidden;
  background: #fafbf8;
}

.category-sidebar {
  flex: 0 0 auto;
  height: 100%;
  overflow: hidden;
  border-right: 1rpx solid #e8ebe4;
  background: #f5f7f2;
}

.category-sidebar__inner {
  width: 100%;
  min-height: 100%;
  padding: 8rpx 0 28rpx;
}

.category-tab {
  position: relative;
  display: flex;
  width: 100%;
  height: 90rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0 12rpx;
  background: transparent;
  color: #777c73;
}

.category-tab__text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-tab--active {
  background: #edf2e8;
  color: #55663f;
  font-weight: 600;
}

.category-tab--active::before {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: #708253;
  content: "";
}

.category-main {
  flex: 1 1 auto;
  width: 0;
  min-width: 0;
  height: 100%;
  overflow: hidden;
  background: #fafbf8;
}

.category-main-inner {
  width: 100%;
  min-width: 0;
  padding-top: 18rpx;
}

.search-box {
  display: flex;
  width: 100%;
  height: 68rpx;
  align-items: center;
  overflow: hidden;
  padding: 0 18rpx;
  border: 1rpx solid #e3e7df;
  border-radius: 16rpx;
  background: #ffffff;
}

.search-icon {
  position: relative;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
  border: 3rpx solid #899086;
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #899086;
  content: "";
  transform: rotate(45deg);
  transform-origin: left center;
}

.search-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 66rpx;
  padding: 0;
  color: #2b2f29;
  font-size: 22rpx;
  line-height: 66rpx;
}

.search-placeholder { color: #a1a69e; }

.search-clear {
  display: flex;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
  color: #92988f;
  font-size: 33rpx;
  font-weight: 300;
  line-height: 1;
}

.category-hero {
  display: flex;
  width: 100%;
  height: 154rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e5e9e1;
  border-radius: 18rpx;
  background: #eef3e9;
}

.category-hero__copy {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
  padding: 18rpx 20rpx 18rpx 22rpx;
}

.category-hero__eyebrow {
  color: #7b886a;
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.category-hero__title {
  margin-top: 6rpx;
  overflow: hidden;
  color: #2b3128;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-hero__subtitle {
  margin-top: 8rpx;
  overflow: hidden;
  color: #7b8178;
  font-size: 19rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-hero__link {
  margin-top: 10rpx;
  color: #607148;
  font-size: 18rpx;
}

.category-hero__image {
  flex: 0 0 174rpx;
  width: 174rpx;
  height: 154rpx;
  background: #e7ebe2;
}

.category-layout--compact .category-hero { height: 142rpx; }
.category-layout--compact .category-hero__copy {
  padding-right: 14rpx;
  padding-left: 18rpx;
}
.category-layout--compact .category-hero__image {
  flex-basis: 136rpx;
  width: 136rpx;
  height: 142rpx;
}
.category-layout--compact .category-hero__eyebrow { display: none; }

.color-filter { margin-top: 22rpx; }

.section-label {
  display: block;
  margin-bottom: 12rpx;
  color: #555b52;
  font-size: 21rpx;
  font-weight: 600;
}

.color-scroll {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

.color-list {
  display: inline-flex;
  width: auto;
  min-width: max-content;
  align-items: center;
  padding-right: 10rpx;
}

.color-chip {
  display: inline-flex;
  width: auto;
  min-width: 0;
  height: 52rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e0e5dc;
  border-radius: 26rpx;
  background: #ffffff;
  color: #696e66;
  font-size: 20rpx;
  line-height: 50rpx;
  white-space: nowrap;
}

.color-chip--active {
  border-color: #d6e0cd;
  background: #eaf1e4;
  color: #56673f;
  font-weight: 600;
}

.color-chip__dot {
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 18rpx;
  margin-right: 8rpx;
  border: 1rpx solid rgba(70, 72, 66, 0.14);
  border-radius: 50%;
}

.color-chip__dot--pink { background: #f2a7b5; }
.color-chip__dot--white { background: #fffefa; }
.color-chip__dot--red { background: #cf5c62; }
.color-chip__dot--purple { background: #bda6db; }
.color-chip__dot--yellow { background: #efc35f; }
.color-chip__dot--green { background: #8ba67a; }
.color-chip__dot--champagne { background: #d8b79c; }
.color-chip__dot--cream { background: #f1dfbd; }
.color-chip__dot--neutral,
.color-chip__dot--mixed { background: #d6d9d2; }

.result-head {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  margin: 25rpx 0 14rpx;
}

.result-title {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #292d27;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-count {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: #959a92;
  font-size: 19rpx;
}

.category-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  align-items: flex-start;
}

.category-product {
  min-width: 0;
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e7eae3;
  border-radius: 16rpx;
  background: #ffffff;
}

.category-grid--1 .category-product { width: 100%; }
.category-grid--2,
.category-grid--3,
.category-grid--4 { column-gap: 10px; }
.category-grid--2 .category-product { width: calc((100% - 10px) / 2); }
.category-grid--3 .category-product { width: calc((100% - 20px) / 3); }
.category-grid--4 .category-product { width: calc((100% - 30px) / 4); }

.category-product__image {
  display: block;
  width: 100%;
  border-bottom: 1rpx solid #eceee9;
  background: #f0f2ed;
}

.category-product__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6c7d54;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.category-product__body {
  min-height: 106rpx;
  padding: 13rpx 13rpx 12rpx;
  background: #ffffff;
}

.category-product__name {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #2d302a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-product__footer {
  display: flex;
  min-height: 46rpx;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 10rpx;
}

.category-product__price {
  display: flex;
  min-width: 0;
  align-items: baseline;
  overflow: hidden;
  color: #53643d;
  white-space: nowrap;
}

.category-product__currency {
  font-size: 17rpx;
  font-weight: 600;
}

.category-product__amount {
  margin-left: 2rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.category-product__unit {
  margin-left: 3rpx;
  overflow: hidden;
  color: #8e938a;
  font-size: 16rpx;
  text-overflow: ellipsis;
}

.category-product__add {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  padding-bottom: 2rpx;
  border-radius: 50%;
  background: #6f8152;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 300;
  line-height: 1;
}

.category-product__stock {
  display: block;
  margin-top: 7rpx;
  color: #ad735d;
  font-size: 16rpx;
}

.category-empty {
  display: flex;
  width: 100%;
  min-height: 280rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e7eae3;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.category-empty__title {
  color: #666b63;
  font-size: 22rpx;
}

.category-empty__sub {
  margin-top: 10rpx;
  color: #a0a49c;
  font-size: 19rpx;
}

.category-empty__button {
  display: flex;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 0 23rpx;
  border: 1rpx solid #dce3d5;
  border-radius: 26rpx;
  background: #edf2e8;
  color: #5e7046;
  font-size: 20rpx;
}

.bottom-space {
  height: calc(76rpx + env(safe-area-inset-bottom));
}
