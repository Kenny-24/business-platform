<view class="safe-page category-page">
  <app-nav title="分类"></app-nav>
  <view class="category-layout" style="height: {{contentHeight}}px;">
    <scroll-view class="category-sidebar" scroll-y enhanced show-scrollbar="{{false}}">
      <button
        wx:for="{{categories}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="selectCategory"
        class="category-tab {{activeCategory === index ? 'category-tab--active' : ''}}"
      >{{item}}</button>
    </scroll-view>

    <scroll-view class="category-main" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="category-main-inner">
        <view class="season-card">
          <view class="season-copy">
            <text class="season-title">当季精选</text>
            <text class="season-sub">只展示当前可售商品</text>
            <text class="season-link">新鲜直达 ›</text>
          </view>
          <image class="season-image" src="{{banner.image}}" mode="aspectFill"></image>
        </view>

        <text class="grid-title">商品列表</text>
        <view wx:if="{{products.length}}" class="category-grid">
          <button
            class="category-product"
            wx:for="{{products}}"
            wx:key="id"
            data-item="{{item}}"
            bindtap="openProduct"
          >
            <image wx:if="{{item.image}}" class="category-product__image" src="{{item.image}}" mode="aspectFill" lazy-load></image>
            <view wx:else class="category-product__image category-product__placeholder">花予</view>
            <text class="category-product__name">{{item.name}}</text>
          </button>
        </view>
        <view wx:else class="category-empty">
          <text>{{loading ? '正在加载商品…' : '该分类暂时没有在售商品'}}</text>
        </view>

        <view wx:if="{{activeCategory === 0 || activeCategory === 1}}" class="color-section">
          <text class="grid-title">按颜色选花</text>
          <view class="color-row">
            <button
              wx:for="{{colors}}"
              wx:key="*this"
              data-color="{{item}}"
              bindtap="selectColor"
              class="color-item {{activeColor === item ? 'color-item--active' : ''}}"
            >
              <view class="color-dot color-dot--{{index}}"></view>
              <text>{{item}}</text>
            </button>
          </view>
        </view>

        <view class="bottom-space"></view>
      </view>
    </scroll-view>
  </view>
</view>
