<view class="safe-page category-page">
  <app-nav title="分类"></app-nav>

  <view
    class="category-layout {{compactLayout ? 'category-layout--compact' : ''}}"
    style="height: {{contentHeight}}px;"
  >
    <scroll-view
      class="category-sidebar"
      style="width: {{sidebarWidth}}px;"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="category-sidebar__inner">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="selectCategory"
          class="category-tab {{activeCategory === index ? 'category-tab--active' : ''}}"
          role="button"
          aria-label="{{item}}"
        >
          <text class="category-tab__text">{{item}}</text>
        </view>
      </view>
    </scroll-view>

    <scroll-view
      class="category-main"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view
        class="category-main-inner"
        style="padding-left: {{mainHorizontalPadding}}px; padding-right: {{mainHorizontalPadding}}px;"
      >
        <view class="search-box">
          <view class="search-icon"></view>
          <input
            class="search-input"
            value="{{searchQuery}}"
            placeholder="搜索商品、颜色或场景"
            placeholder-class="search-placeholder"
            confirm-type="search"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
          />
          <view
            wx:if="{{searchQuery}}"
            class="search-clear"
            bindtap="clearSearch"
            role="button"
            aria-label="清空搜索"
          >×</view>
        </view>

        <view
          wx:if="{{showCategoryHero}}"
          class="category-hero {{categoryHero.image ? 'category-hero--with-image' : 'category-hero--text-only'}}"
          bindtap="openCategoryHero"
          role="button"
        >
          <view class="category-hero__copy">
            <text class="category-hero__eyebrow">{{categoryHero.scene || '当季精选'}}</text>
            <text class="category-hero__title">{{categoryHero.title || '当季精选'}}</text>
            <text class="category-hero__subtitle">{{categoryHero.subtitle || '只展示当前可售商品'}}</text>
            <text class="category-hero__link">{{categoryHero.cta || '查看推荐'}} ›</text>
          </view>
          <image
            wx:if="{{categoryHero.image}}"
            class="category-hero__image"
            src="{{categoryHero.image}}"
            mode="aspectFill"
            lazy-load
          ></image>
        </view>

        <view wx:if="{{showColorFilter}}" class="color-filter">
          <text class="section-label">按颜色筛选</text>
          <scroll-view
            class="color-scroll"
            scroll-x
            enhanced
            show-scrollbar="{{false}}"
          >
            <view class="color-list">
              <view
                class="color-chip {{activeColor === '' ? 'color-chip--active' : ''}}"
                data-color=""
                bindtap="selectColor"
                role="button"
              ><text>全部</text></view>

              <view
                wx:for="{{colorOptions}}"
                wx:key="value"
                class="color-chip {{activeColor === item.value ? 'color-chip--active' : ''}}"
                data-color="{{item.value}}"
                bindtap="selectColor"
                role="button"
              >
                <view class="color-chip__dot color-chip__dot--{{item.tone}}"></view>
                <text>{{item.label}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="result-head">
          <text class="result-title">{{resultTitle}}</text>
          <text class="result-count">{{resultCount}} 款</text>
        </view>

        <view
          wx:if="{{products.length}}"
          class="category-grid category-grid--{{gridColumns}}"
        >
          <view
            class="category-product"
            wx:for="{{products}}"
            wx:key="id"
            data-product-id="{{item.id}}"
            bindtap="openProduct"
          >
            <image
              wx:if="{{item.image}}"
              class="category-product__image"
              style="height: {{productImageHeight}}px;"
              src="{{item.image}}"
              mode="aspectFill"
              lazy-load
            ></image>
            <view
              wx:else
              class="category-product__image category-product__placeholder"
              style="height: {{productImageHeight}}px;"
            >花予</view>

            <view class="category-product__body">
              <text class="category-product__name">{{item.name}}</text>
              <view class="category-product__footer">
                <view class="category-product__price">
                  <text class="category-product__currency">¥</text>
                  <text class="category-product__amount">{{item.priceText}}</text>
                  <text class="category-product__unit">/{{item.unit}}</text>
                </view>
                <view
                  class="category-product__add"
                  data-product-id="{{item.id}}"
                  catchtap="addProduct"
                  role="button"
                  aria-label="加入购物车"
                >＋</view>
              </view>
              <text
                wx:if="{{item.stock > 0 && item.stock <= 5}}"
                class="category-product__stock"
              >仅剩 {{item.stock}}{{item.unit}}</text>
            </view>
          </view>
        </view>

        <view wx:else class="category-empty">
          <text class="category-empty__title">{{loading ? '正在加载商品…' : '没有找到可售商品'}}</text>
          <text wx:if="{{!loading}}" class="category-empty__sub">{{searchQuery ? '换一个关键词试试' : '商品正在后台更新中'}}</text>
          <view
            wx:if="{{searchQuery && !loading}}"
            class="category-empty__button"
            bindtap="clearSearch"
            role="button"
          >清空搜索</view>
        </view>

        <view class="bottom-space"></view>
      </view>
    </scroll-view>
  </view>
</view>
