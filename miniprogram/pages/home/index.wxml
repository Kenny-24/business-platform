<view class="safe-page home-page">
  <app-nav
    title="花予"
    brand
    overlay
    light="{{!navSolid}}"
    solid="{{navSolid}}"
    showLocation
    locationText="{{locationText}}"
    bind:location="chooseLocation"
  ></app-nav>

  <view class="hero-shell" style="height: {{heroHeight}}px;">
    <swiper
      class="hero"
      circular="{{banners.length > 1}}"
      autoplay="{{banners.length > 1}}"
      interval="5600"
      duration="520"
      bindchange="onBannerChange"
    >
      <swiper-item
        wx:for="{{banners}}"
        wx:for-item="banner"
        wx:for-index="bannerIndex"
        wx:key="id"
      >
        <view class="hero-slide">
          <image
            class="hero-image"
            src="{{banner.image}}"
            mode="aspectFill"
            lazy-load="{{bannerIndex > 0}}"
          ></image>
          <view class="hero-overlay"></view>

          <view class="hero-copy">
            <text class="hero-eyebrow">{{banner.scene}}</text>
            <text class="hero-title">{{banner.title}}</text>
            <text class="hero-subtitle">{{banner.subtitle}}</text>
            <button
              class="hero-button"
              hover-class="hero-button--pressed"
              data-action="{{banner.action}}"
              bindtap="onHeroAction"
            >
              {{banner.cta}}
            </button>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view wx:if="{{banners.length > 1}}" class="hero-progress">
      <view
        wx:for="{{banners}}"
        wx:for-item="dot"
        wx:for-index="dotIndex"
        wx:key="id"
        class="hero-progress__track"
      >
        <view
          class="hero-progress__fill {{dotIndex === currentBanner ? 'hero-progress__fill--active' : ''}}"
        ></view>
      </view>
    </view>
  </view>

  <view class="home-content">
    <view wx:if="{{loadFailed}}" class="cloud-notice" bindtap="loadHomeData">
      <text>云端内容暂时没有加载成功，点击重试</text>
    </view>

    <view class="home-section home-section--first">
      <section-title title="今日有花" showMore="{{false}}"></section-title>
      <view wx:if="{{flowers.length}}" class="home-product-grid">
        <view class="home-product-cell" wx:for="{{flowers}}" wx:key="id">
          <product-card item="{{item}}" compact bind:add="addProduct"></product-card>
        </view>
      </view>
      <view wx:else class="section-empty">
        <text>{{loading ? '正在准备今日花材…' : '今日花材正在更新中'}}</text>
      </view>
      <section-more target="flowers" bind:more="openSectionMore"></section-more>
    </view>

    <view class="home-section">
      <section-title title="推荐成品花束" showMore="{{false}}"></section-title>
      <scroll-view wx:if="{{bouquets.length}}" class="horizontal-list" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="horizontal-inner">
          <view class="bouquet-item" wx:for="{{bouquets}}" wx:key="id">
            <product-card item="{{item}}" showAdd="{{false}}"></product-card>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="section-empty">
        <text>{{loading ? '正在加载花束…' : '成品花束即将上新'}}</text>
      </view>
      <section-more target="bouquets" bind:more="openSectionMore"></section-more>
    </view>

    <view class="home-section">
      <section-title title="多肉与绿植" showMore="{{false}}"></section-title>
      <view wx:if="{{succulents.length}}" class="home-product-grid">
        <view class="home-product-cell" wx:for="{{succulents}}" wx:key="id">
          <product-card item="{{item}}" compact bind:add="addProduct"></product-card>
        </view>
      </view>
      <view wx:else class="section-empty">
        <text>{{loading ? '正在加载绿植…' : '多肉与绿植即将上新'}}</text>
      </view>
      <section-more target="succulents" bind:more="openSectionMore"></section-more>
    </view>

    <view class="home-section">
      <section-title title="节日提醒" showMore="{{false}}"></section-title>
      <view class="festival" bindtap="openCalendar">
        <view class="festival-date"><text class="festival-month">5月12日</text></view>
        <view class="festival-copy">
          <text class="festival-title">母亲节</text>
          <text class="festival-sub">推荐康乃馨、粉玫瑰</text>
          <text class="festival-link">去选花 ›</text>
        </view>
        <image class="festival-flower" src="/images/flowers/carnation.jpg" mode="aspectFill"></image>
      </view>
      <section-more target="calendar" bind:more="openSectionMore"></section-more>
    </view>

    <view class="home-section">
      <section-title title="花予图鉴" showMore="{{false}}"></section-title>
      <view class="atlas-grid">
        <view class="atlas-card" wx:for="{{atlasItems}}" wx:key="id">
          <image class="atlas-card__image" src="{{item.image}}" mode="aspectFill" lazy-load></image>
          <view class="atlas-card__shade"></view>
          <view class="atlas-card__copy">
            <text class="atlas-card__name">{{item.name}}</text>
            <text class="atlas-card__latin">{{item.latin}}</text>
            <text class="atlas-card__meaning">{{item.meaning}}</text>
          </view>
        </view>
      </view>
      <section-more target="atlas" bind:more="openSectionMore"></section-more>
    </view>
  </view>
</view>
