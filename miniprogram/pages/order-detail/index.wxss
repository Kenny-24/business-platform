.order-detail-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.order-detail-scroll,
.order-detail-content,
.order-detail-layout,
.order-detail-main,
.order-detail-side {
  width: 100%;
  min-width: 0;
}

.order-detail-content {
  min-height: 100%;
  padding-top: 15rpx;
}

.order-detail-loading {
  padding: 130rpx 0;
  color: #92988f;
  font-size: 18rpx;
  text-align: center;
}

.status-card {
  padding: 25rpx 23rpx;
  border: 1rpx solid #dfe6da;
  border-radius: 18rpx;
  background: #eef3e9;
}

.status-card--cancelled,
.status-card--refunded {
  border-color: #e7e1dd;
  background: #f4f1ef;
}

.status-card__label,
.status-card__description,
.status-card__number {
  display: block;
}

.status-card__label {
  color: #52633c;
  font-size: 28rpx;
  font-weight: 700;
}

.status-card__description {
  margin-top: 8rpx;
  color: #737c6e;
  font-size: 17rpx;
}

.status-card__number {
  margin-top: 14rpx;
  color: #9a9f97;
  font-size: 14rpx;
}

.detail-card {
  width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e5e9e2;
  border-radius: 18rpx;
  background: #ffffff;
}

.detail-card__title {
  display: block;
  padding: 18rpx 21rpx 11rpx;
  color: #30342e;
  font-size: 21rpx;
  font-weight: 600;
}

.detail-row {
  display: flex;
  min-height: 44rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 21rpx;
  color: #757c72;
  font-size: 17rpx;
}

.detail-row text:last-child {
  max-width: 64%;
  color: #4f564d;
  text-align: right;
}

.detail-row--total {
  min-height: 54rpx;
  color: #30342e;
  font-weight: 600;
}

.detail-row--total text:last-child {
  color: #53633e;
  font-size: 24rpx;
}

.detail-line {
  height: 1rpx;
  margin: 8rpx 21rpx;
  background: #edf0ea;
}

.address-block {
  margin: 12rpx 21rpx 19rpx;
  padding: 15rpx 17rpx;
  border-radius: 13rpx;
  background: #f7f9f5;
}

.address-block__person {
  display: flex;
  align-items: center;
}

.address-block__person text:first-child {
  color: #343832;
  font-size: 18rpx;
  font-weight: 600;
}

.address-block__person text:last-child {
  margin-left: 12rpx;
  color: #7c8379;
  font-size: 16rpx;
}

.address-block__full {
  display: block;
  margin-top: 8rpx;
  color: #6e756b;
  font-size: 16rpx;
  line-height: 1.5;
}

.detail-product {
  display: flex;
  align-items: center;
  padding: 14rpx 21rpx;
  border-top: 1rpx solid #edf0ea;
}

.detail-product__image {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #eef1eb;
}

.detail-product__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #68784f;
  font-size: 15rpx;
  font-weight: 700;
}

.detail-product__copy {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 14rpx;
}

.detail-product__name,
.detail-product__price {
  display: block;
}

.detail-product__name {
  color: #30342e;
  font-size: 19rpx;
  font-weight: 600;
}

.detail-product__price {
  margin-top: 7rpx;
  color: #8f958c;
  font-size: 16rpx;
}

.detail-product__right {
  flex: 0 0 auto;
  margin-left: 12rpx;
  text-align: right;
}

.detail-product__right text {
  display: block;
}

.detail-product__right text:first-child {
  color: #8b9188;
  font-size: 15rpx;
}

.detail-product__right text:last-child {
  margin-top: 7rpx;
  color: #53633e;
  font-size: 18rpx;
  font-weight: 600;
}

.message-detail {
  padding: 16rpx 21rpx;
  border-top: 1rpx solid #edf0ea;
}

.message-detail text {
  display: block;
}

.message-detail text:first-child {
  color: #343832;
  font-size: 17rpx;
  font-weight: 600;
}

.message-detail text:last-child {
  margin-top: 8rpx;
  color: #727970;
  font-size: 16rpx;
  line-height: 1.6;
}

.timeline-item {
  position: relative;
  display: flex;
  padding: 10rpx 21rpx 18rpx;
}

.timeline-item::before {
  position: absolute;
  top: 22rpx;
  bottom: -10rpx;
  left: 28rpx;
  width: 1rpx;
  background: #dfe5da;
  content: "";
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item__dot {
  position: relative;
  z-index: 1;
  width: 15rpx;
  height: 15rpx;
  flex: 0 0 15rpx;
  margin-top: 5rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #6f8050;
  box-shadow: 0 0 0 1rpx #cfd8c8;
}

.timeline-item__copy {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 13rpx;
}

.timeline-item__title,
.timeline-item__note,
.timeline-item__time {
  display: block;
}

.timeline-item__title {
  color: #343832;
  font-size: 17rpx;
  font-weight: 600;
}

.timeline-item__note {
  margin-top: 5rpx;
  color: #777e74;
  font-size: 15rpx;
  line-height: 1.5;
}

.timeline-item__time {
  margin-top: 5rpx;
  color: #a0a59d;
  font-size: 13rpx;
}

.info-card {
  padding: 14rpx 0;
}

.order-detail-bottom-space {
  height: calc(120rpx + env(safe-area-inset-bottom));
}

.order-detail-fixed-bar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e6e9e3;
  background: rgba(255, 255, 255, 0.97);
}

.detail-secondary-button,
.detail-primary-button {
  display: flex;
  min-width: 148rpx;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 30rpx;
  font-size: 18rpx;
}

.detail-secondary-button {
  border: 1rpx solid #d8ded4;
  color: #6f766c;
  background: #ffffff;
}

.detail-primary-button {
  background: #6f8050;
  color: #ffffff;
}

.order-detail-page--wide .order-detail-content {
  max-width: 1180rpx;
  margin: 0 auto;
}

.order-detail-page--wide .order-detail-layout {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.order-detail-page--wide .order-detail-main {
  width: 64%;
  flex: 0 0 64%;
}

.order-detail-page--wide .order-detail-side {
  width: calc(36% - 20rpx);
  flex: 0 0 calc(36% - 20rpx);
}

.order-detail-page--compact .detail-product,
.order-detail-page--compact .detail-row {
  padding-right: 17rpx;
  padding-left: 17rpx;
}
