.profile-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.profile-scroll {
  width: 100%;
  overflow: hidden;
}

.profile-content {
  width: 100%;
  min-height: 100%;
  padding-top: 16rpx;
}

.identity-card {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  padding: 21rpx;
  border: 1rpx solid #e2e8dc;
  border-radius: 19rpx;
  background: #eef3e9;
}

.identity-card__avatar {
  display: block;
  flex: 0 0 auto;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: #e2e7dd;
}

.identity-card__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #627247;
  font-size: 30rpx;
  font-weight: 700;
}

.identity-card__copy {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 18rpx;
}

.identity-card__name-line {
  display: flex;
  min-width: 0;
  align-items: center;
}

.identity-card__name {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #293027;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-card__level {
  flex: 0 0 auto;
  margin-left: 9rpx;
  padding: 4rpx 9rpx;
  border: 1rpx solid #d8e0d0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #627149;
  font-size: 14rpx;
  line-height: 1.2;
}

.identity-card__description {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  color: #82897e;
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-card__arrow {
  flex: 0 0 auto;
  margin-left: 13rpx;
  color: #969d92;
  font-size: 31rpx;
  line-height: 1;
}

.profile-main-grid {
  width: 100%;
}

.profile-card {
  width: 100%;
  margin-top: 17rpx;
  overflow: hidden;
  border: 1rpx solid #e6eae3;
  border-radius: 19rpx;
  background: #ffffff;
}

.card-head {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 21rpx 10rpx;
}

.card-head--plain {
  justify-content: flex-start;
}

.card-head__title {
  color: #2d312b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card-head__more {
  display: flex;
  align-items: center;
  padding: 8rpx 0 8rpx 13rpx;
  color: #8b9188;
  font-size: 17rpx;
}

.card-head__arrow {
  margin-left: 5rpx;
  color: #a6aca3;
  font-size: 25rpx;
  line-height: 1;
}

.order-grid {
  display: flex;
  width: 100%;
  align-items: flex-start;
  padding: 7rpx 7rpx 23rpx;
}

.order-entry {
  display: flex;
  width: 20%;
  min-width: 0;
  flex: 0 0 20%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.order-entry__icon {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d8ded3;
  border-radius: 14rpx;
  background: #f8faf6;
  color: #65744e;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}

.order-entry__badge {
  position: absolute;
  top: -11rpx;
  right: -16rpx;
  display: flex;
  min-width: 27rpx;
  height: 27rpx;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border: 3rpx solid #ffffff;
  border-radius: 14rpx;
  background: #6f8050;
  color: #ffffff;
  font-size: 12rpx;
  line-height: 1;
}

.order-entry__label {
  display: block;
  max-width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: #686e65;
  font-size: 16rpx;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-grid {
  display: flex;
  width: 100%;
  align-items: stretch;
  padding: 4rpx 8rpx 21rpx;
}

.asset-entry {
  position: relative;
  display: flex;
  width: 33.333%;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 9rpx 4rpx;
}

.asset-entry + .asset-entry::before {
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 0;
  width: 1rpx;
  background: #ecefe9;
  content: "";
}

.asset-entry__value {
  color: #56663f;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.asset-entry__label {
  margin-top: 7rpx;
  color: #8b9188;
  font-size: 16rpx;
}

.service-entry {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 78rpx;
  align-items: center;
  padding: 0 21rpx;
  border-top: 1rpx solid #ecefe9;
}

.service-entry__icon {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce2d7;
  border-radius: 11rpx;
  background: #f8faf6;
  color: #687750;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1;
}

.service-entry__label {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 15rpx;
  overflow: hidden;
  color: #343832;
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-entry__value {
  flex: 0 1 auto;
  max-width: 180rpx;
  margin-left: 12rpx;
  overflow: hidden;
  color: #92988f;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-entry__arrow {
  flex: 0 0 auto;
  margin-left: 9rpx;
  color: #afb5ac;
  font-size: 27rpx;
  line-height: 1;
}

.profile-slogan {
  display: block;
  padding: 27rpx 0 4rpx;
  color: #b0b5ad;
  font-size: 15rpx;
  text-align: center;
}

.profile-bottom-space {
  height: calc(106rpx + env(safe-area-inset-bottom));
}

.profile-page--wide .profile-content {
  max-width: 1120rpx;
  margin: 0 auto;
}

.profile-page--wide .profile-main-grid {
  display: flex;
  align-items: stretch;
}

.profile-page--wide .order-card {
  width: 62%;
  flex: 0 0 62%;
  margin-right: 10rpx;
}

.profile-page--wide .asset-card {
  width: calc(38% - 10rpx);
  flex: 0 0 calc(38% - 10rpx);
  margin-left: 10rpx;
}

.profile-page--compact .identity-card {
  padding: 18rpx;
}

.profile-page--compact .identity-card__copy {
  margin-left: 14rpx;
}

.profile-page--compact .identity-card__name {
  font-size: 25rpx;
}

.profile-page--compact .identity-card__description {
  font-size: 15rpx;
}

.profile-page--compact .order-entry__icon {
  width: 43rpx;
  height: 43rpx;
}

.profile-page--compact .order-entry__label {
  font-size: 14rpx;
}

.profile-page--compact .service-entry {
  min-height: 74rpx;
  padding: 0 18rpx;
}
