.profile-page {
  width: 100%;
  min-height: 100vh;
  padding: 0 24rpx 54rpx;
  background: linear-gradient(180deg, #e8eadc 0, #f8f6f0 350rpx, #f8f6f0 100%);
}

.profile-hero {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding: 46rpx 14rpx 38rpx;
}

.avatar {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 104rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: #e2e4da;
}

.profile-user {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 24rpx;
}

.profile-name-row {
  display: flex;
  align-items: center;
}

.profile-name {
  display: block;
  overflow: hidden;
  color: #272620;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22rpx;
  height: 22rpx;
  margin-left: 10rpx;
  border: 1rpx solid #7a8560;
  border-radius: 50%;
  color: #68764b;
  font-size: 14rpx;
}

.profile-level {
  display: inline-block;
  margin-top: 9rpx;
  padding: 7rpx 15rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.66);
  color: #696f55;
  font-size: 19rpx;
}

.profile-card {
  width: 100%;
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(82, 75, 63, 0.045);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 24rpx rgba(60, 54, 44, 0.025);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  padding: 25rpx 24rpx 20rpx;
  color: #292823;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 27rpx;
}

.card-more {
  flex: 0 0 auto;
  margin-left: 18rpx;
  color: #908b82;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 20rpx;
}

.order-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  padding: 10rpx 5rpx 28rpx;
}

.order-row button {
  display: flex;
  flex: 0 0 20%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 20%;
  min-width: 0;
  margin: 0;
  padding: 0 2rpx;
  border: 0;
  color: #5f5b53;
  font-size: 18rpx;
  line-height: 1.25;
  text-align: center;
}

.order-row button::after {
  border: 0;
}

.order-icon {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 10rpx;
}

.points-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  padding: 25rpx 24rpx;
}

.points-card > view {
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 18rpx;
}

.points-label,
.points-tip {
  display: block;
  max-width: 100%;
}

.points-label {
  color: #292823;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
}

.points-tip {
  margin-top: 7rpx;
  overflow: hidden;
  color: #9a958c;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.points-value {
  flex: 0 0 auto;
  color: #68764b;
  font-size: 23rpx;
  white-space: nowrap;
}

button.menu-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-bottom: 1rpx solid #efede7;
  background: transparent;
  text-align: left;
}

button.menu-row::after {
  border: 0;
}

button.menu-row:last-child {
  border-bottom: 0;
}

.menu-icon {
  flex: 0 0 36rpx;
  width: 36rpx;
  height: 36rpx;
}

.menu-label {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 19rpx;
  overflow: hidden;
  color: #292823;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-value {
  flex: 0 1 auto;
  max-width: 220rpx;
  margin-left: 14rpx;
  overflow: hidden;
  color: #9a958c;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #bab5ac;
  font-size: 29rpx;
}
