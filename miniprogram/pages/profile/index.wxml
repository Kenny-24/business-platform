<view class="safe-page profile-page {{wideLayout ? 'profile-page--wide' : ''}} {{compactLayout ? 'profile-page--compact' : ''}}">
  <app-nav title="我的" solid></app-nav>

  <scroll-view class="profile-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <view class="identity-card" bindtap="openProfile" role="button">
        <image wx:if="{{profile.avatarUrl}}" class="identity-card__avatar" style="width: {{avatarSize}}px; height: {{avatarSize}}px;" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="identity-card__avatar identity-card__avatar--placeholder" style="width: {{avatarSize}}px; height: {{avatarSize}}px;">花</view>

        <view class="identity-card__copy">
          <view class="identity-card__name-line">
            <text class="identity-card__name">{{profile.nickname}}</text>
            <text wx:if="{{profile.memberLevel}}" class="identity-card__level">{{profile.memberLevel}}</text>
          </view>
          <text class="identity-card__description">{{profile.description}}</text>
        </view>

        <text class="identity-card__arrow">›</text>
      </view>

      <view class="profile-main-grid">
        <view class="profile-card order-card">
          <view class="card-head">
            <text class="card-head__title">我的订单</text>
            <view class="card-head__more" bindtap="openAllOrders" role="button">
              <text>全部订单</text>
              <text class="card-head__arrow">›</text>
            </view>
          </view>

          <view class="order-grid">
            <view wx:for="{{orderItems}}" wx:key="key" class="order-entry" data-key="{{item.key}}" data-label="{{item.label}}" bindtap="openOrder" role="button">
              <view class="order-entry__icon">
                <text>{{item.glyph}}</text>
                <text wx:if="{{item.showCount}}" class="order-entry__badge">{{item.count > 99 ? '99+' : item.count}}</text>
              </view>
              <text class="order-entry__label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="profile-card asset-card">
          <view class="card-head card-head--plain">
            <text class="card-head__title">我的资产</text>
          </view>

          <view class="asset-grid">
            <view wx:for="{{assetItems}}" wx:key="key" class="asset-entry" data-key="{{item.key}}" bindtap="openAsset" role="button">
              <text class="asset-entry__value">{{item.value}}</text>
              <text class="asset-entry__label">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="profile-card service-card">
        <view class="card-head card-head--plain">
          <text class="card-head__title">常用服务</text>
        </view>

        <view wx:for="{{serviceItems}}" wx:key="key" class="service-entry" data-key="{{item.key}}" bindtap="openService" role="button">
          <view class="service-entry__icon">{{item.glyph}}</view>
          <text class="service-entry__label">{{item.label}}</text>
          <text wx:if="{{item.value}}" class="service-entry__value">{{item.value}}</text>
          <text class="service-entry__arrow">›</text>
        </view>
      </view>

      <text class="profile-slogan">花予 · 认真对待每一个重要日子</text>
      <view class="profile-bottom-space"></view>
    </view>
  </scroll-view>
</view>
