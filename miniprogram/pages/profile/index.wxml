<view class="safe-page profile-page">
  <app-nav title="我的" transparent></app-nav>

  <view class="profile-hero">
    <image class="avatar" src="/images/profile/avatar.png" mode="aspectFill"></image>
    <view class="profile-user">
      <view class="profile-name-row">
        <text class="profile-name">花予生活</text>
        <text class="profile-badge">✓</text>
      </view>
      <text class="profile-level">普通会员</text>
    </view>
  </view>

  <view class="profile-card orders-card">
    <view class="card-head">
      <text>我的订单</text>
      <text class="card-more">全部订单 ›</text>
    </view>
    <view class="order-row">
      <button wx:for="{{orders}}" wx:key="label">
        <image class="order-icon" src="{{item.icon}}"></image>
        <text>{{item.label}}</text>
      </button>
    </view>
  </view>

  <view class="profile-card points-card">
    <view>
      <text class="points-label">我的积分</text>
      <text class="points-tip">下单与支付抵扣时使用</text>
    </view>
    <text class="points-value">{{points}} 积分 ›</text>
  </view>

  <view class="profile-card menu-card">
    <button wx:for="{{menus}}" wx:key="label" data-label="{{item.label}}" bindtap="openMenu" class="menu-row">
      <image class="menu-icon" src="{{item.icon}}"></image>
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-value">{{item.value}}</text>
      <text class="menu-arrow">›</text>
    </button>
  </view>
</view>
