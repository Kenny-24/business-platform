.atlas-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.atlas-scroll {
  width: 100%;
  overflow: hidden;
}

.atlas-content {
  width: 100%;
  min-height: 100%;
  padding-top: 17rpx;
}

.atlas-intro {
  padding: 21rpx;
  border: 1rpx solid #e2e8dc;
  border-radius: 18rpx;
  background: #eef3e9;
}

.atlas-intro__title,
.atlas-intro__description {
  display: block;
}

.atlas-intro__title {
  color: #2d332b;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.atlas-intro__description {
  margin-top: 8rpx;
  color: #7f877c;
  font-size: 17rpx;
  line-height: 1.55;
}

.atlas-tabs {
  display: flex;
  width: 100%;
  height: 62rpx;
  margin-top: 17rpx;
  padding: 4rpx;
  border: 1rpx solid #e3e7df;
  border-radius: 16rpx;
  background: #f2f4ef;
}

.atlas-tab {
  display: flex;
  width: 50%;
  flex: 0 0 50%;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #7b8178;
  font-size: 20rpx;
}

.atlas-tab--active {
  background: #ffffff;
  color: #596a42;
  font-weight: 600;
}

.atlas-search {
  display: flex;
  width: 100%;
  height: 66rpx;
  align-items: center;
  margin-top: 13rpx;
  padding: 0 17rpx;
  border: 1rpx solid #e3e7df;
  border-radius: 16rpx;
  background: #ffffff;
}

.atlas-search__icon {
  position: relative;
  width: 23rpx;
  height: 23rpx;
  flex: 0 0 23rpx;
  margin-right: 14rpx;
  border: 3rpx solid #899087;
  border-radius: 50%;
}

.atlas-search__icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #899087;
  content: "";
  transform: rotate(45deg);
}

.atlas-search__input {
  flex: 1 1 auto;
  min-width: 0;
  height: 64rpx;
  padding: 0;
  color: #2d312b;
  font-size: 20rpx;
  line-height: 64rpx;
}

.atlas-search__placeholder {
  color: #a1a69e;
}

.atlas-search__clear {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  color: #92988f;
  font-size: 30rpx;
}

.atlas-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 0 13rpx;
  color: #2c302a;
  font-size: 24rpx;
  font-weight: 600;
}

.atlas-result-head__count {
  color: #969c93;
  font-size: 17rpx;
  font-weight: 400;
}

.atlas-card-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12px;
}

.atlas-card-grid--1 .atlas-item-card {
  width: 100%;
}

.atlas-card-grid--2 .atlas-item-card {
  width: calc((100% - 12px) / 2);
}

.atlas-card-grid--3 .atlas-item-card {
  width: calc((100% - 24px) / 3);
}

.atlas-card-grid--4 .atlas-item-card {
  width: calc((100% - 36px) / 4);
}

.atlas-item-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #e5e9e2;
  border-radius: 17rpx;
  background: #ffffff;
}

.atlas-item-card__image {
  display: block;
  width: 100%;
  border-bottom: 1rpx solid #ecefe9;
  background: #eef1eb;
}

.atlas-item-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7b53;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.atlas-item-card__body {
  padding: 13rpx 14rpx 14rpx;
}

.atlas-item-card__title-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
}

.atlas-item-card__name-wrap {
  flex: 1 1 auto;
  min-width: 0;
}

.atlas-item-card__name,
.atlas-item-card__latin,
.atlas-item-card__meaning {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.atlas-item-card__name {
  color: #2d312b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.atlas-item-card__latin {
  margin-top: 3rpx;
  color: #a0a59d;
  font-size: 15rpx;
}

.atlas-item-card__owned {
  flex: 0 0 auto;
  margin-left: 7rpx;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: #edf2e8;
  color: #607047;
  font-size: 13rpx;
}

.atlas-item-card__meaning {
  margin-top: 9rpx;
  color: #656b62;
  font-size: 17rpx;
  line-height: 1.4;
}

.atlas-item-card__footer {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.atlas-item-card__tags {
  display: flex;
  min-width: 0;
  align-items: center;
  overflow: hidden;
}

.atlas-item-card__tag {
  flex: 0 0 auto;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: #edf2e8;
  color: #627149;
  font-size: 13rpx;
  white-space: nowrap;
}

.atlas-item-card__tag--light {
  margin-left: 6rpx;
  background: #f4f5f1;
  color: #8a9087;
}

.atlas-item-card__detail {
  flex: 0 0 auto;
  margin-left: 8rpx;
  color: #7b8670;
  font-size: 15rpx;
  white-space: nowrap;
}

.atlas-empty {
  display: flex;
  min-height: 300rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e6eae3;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.atlas-empty__title {
  color: #656b62;
  font-size: 21rpx;
}

.atlas-empty__description {
  max-width: 80%;
  margin-top: 9rpx;
  color: #9ba098;
  font-size: 17rpx;
  line-height: 1.55;
}

.atlas-retry {
  margin-top: 15rpx;
  padding: 15rpx;
  color: #7a826f;
  font-size: 17rpx;
  text-align: center;
}

.atlas-bottom-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

.atlas-page--compact .atlas-card-grid {
  gap: 10px;
}

.atlas-page--compact .atlas-card-grid--2 .atlas-item-card {
  width: calc((100% - 10px) / 2);
}

.atlas-page--compact .atlas-item-card__body {
  padding-right: 11rpx;
  padding-left: 11rpx;
}

.atlas-page--compact .atlas-item-card__name {
  font-size: 20rpx;
}

.atlas-page--compact .atlas-item-card__owned,
.atlas-page--compact .atlas-item-card__tag--light {
  display: none;
}
