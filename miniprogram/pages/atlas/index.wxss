.atlas-page {
  width: 100%;
  min-height: 100vh;
  padding-bottom: 0;
  background: #fbfbf8;
}

.atlas-scroll,
.atlas-content {
  width: 100%;
}

.atlas-content {
  min-height: 100%;
  padding-top: 18rpx;
}

.atlas-intro {
  padding: 23rpx 22rpx;
  border: 1rpx solid #e1e7dc;
  border-radius: 18rpx;
  background: #eef3e9;
}

.atlas-intro__eyebrow,
.atlas-intro__title,
.atlas-intro__description {
  display: block;
}

.atlas-intro__eyebrow {
  color: #7b896b;
  font-size: 12rpx;
  font-weight: 600;
  letter-spacing: 2.5rpx;
}

.atlas-intro__title {
  margin-top: 7rpx;
  color: #2a3028;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.3;
}

.atlas-intro__description {
  margin-top: 8rpx;
  color: #727a70;
  font-size: 16rpx;
  line-height: 1.65;
}

.atlas-tabs {
  display: flex;
  width: 100%;
  height: 62rpx;
  margin-top: 17rpx;
  padding: 4rpx;
  border: 1rpx solid #e3e7df;
  border-radius: 16rpx;
  background: #f1f3ef;
}

.atlas-tab {
  display: flex;
  width: 50%;
  flex: 0 0 50%;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #7a8076;
  font-size: 20rpx;
}

.atlas-tab--active {
  background: #ffffff;
  color: #56683e;
  font-weight: 650;
  box-shadow: 0 2rpx 8rpx rgba(52, 59, 47, 0.05);
}

.atlas-search {
  display: flex;
  width: 100%;
  height: 66rpx;
  align-items: center;
  margin-top: 13rpx;
  padding: 0 17rpx;
  border: 1rpx solid #e3e7df;
  border-radius: 16rpx;
  background: #ffffff;
}

.atlas-search__icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 22rpx;
  margin-right: 14rpx;
  border: 3rpx solid #8a9087;
  border-radius: 50%;
}

.atlas-search__icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #8a9087;
  content: "";
  transform: rotate(45deg);
}

.atlas-search__input {
  flex: 1 1 auto;
  min-width: 0;
  height: 64rpx;
  padding: 0;
  color: #2d312b;
  font-size: 19rpx;
  line-height: 64rpx;
}

.atlas-search__placeholder {
  color: #a1a69e;
}

.atlas-search__clear {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  color: #92988f;
  font-size: 30rpx;
}

.atlas-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 22rpx 0 13rpx;
  color: #2b3029;
  font-size: 24rpx;
  font-weight: 650;
}

.atlas-result-head__count {
  color: #969c93;
  font-size: 16rpx;
  font-weight: 400;
}

.atlas-card-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12px;
}

.atlas-card-grid--1 .atlas-item-card {
  width: 100%;
}

.atlas-card-grid--2 .atlas-item-card {
  width: calc((100% - 12px) / 2);
}

.atlas-card-grid--3 .atlas-item-card {
  width: calc((100% - 24px) / 3);
}

.atlas-card-grid--4 .atlas-item-card {
  width: calc((100% - 36px) / 4);
}

.atlas-item-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #e5e8e2;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 18rpx rgba(49, 54, 45, 0.035);
}

.atlas-item-card__media {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.atlas-item-card__media--dark {
  background: #090a09;
}

.atlas-item-card__media--light {
  background: #ffffff;
}

.atlas-item-card__media--soft {
  background: #eef1eb;
}

.atlas-item-card__image,
.atlas-item-card__placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.atlas-item-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #687850;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.atlas-item-card__purchased {
  position: absolute;
  z-index: 2;
  top: 11rpx;
  left: 11rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(103, 121, 73, 0.92);
  color: #ffffff;
  font-size: 12rpx;
  font-weight: 600;
  line-height: 1;
}

.atlas-item-card__favorite {
  position: absolute;
  z-index: 3;
  top: 9rpx;
  right: 9rpx;
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.08);
}

.favorite-star {
  display: block;
  color: #7a8177;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-1rpx);
}

.atlas-item-card__favorite--active {
  background: rgba(111, 128, 80, 0.96);
}

.atlas-item-card__favorite--active .favorite-star {
  color: #ffffff;
}

.atlas-item-card__body {
  padding: 14rpx 14rpx 15rpx;
}

.atlas-item-card__title,
.atlas-item-card__latin,
.atlas-item-card__description {
  display: block;
}

.atlas-item-card__title {
  overflow: hidden;
  color: #262b25;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.atlas-item-card__latin {
  margin-top: 4rpx;
  overflow: hidden;
  color: #9a9f97;
  font-size: 14rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.atlas-item-card__description {
  min-height: 47rpx;
  margin-top: 9rpx;
  overflow: hidden;
  color: #626961;
  font-size: 16rpx;
  line-height: 1.48;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.atlas-item-card__meta {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #eef0eb;
  color: #7d8579;
  font-size: 13rpx;
}

.atlas-item-card__meta text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.atlas-item-card__chevron {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-left: 8rpx;
  border-top: 2rpx solid #8e958a;
  border-right: 2rpx solid #8e958a;
  transform: rotate(45deg);
}

.atlas-empty {
  display: flex;
  min-height: 300rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e6eae3;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
}

.atlas-empty__title {
  color: #656b62;
  font-size: 21rpx;
}

.atlas-empty__description {
  max-width: 80%;
  margin-top: 9rpx;
  color: #9ba098;
  font-size: 17rpx;
  line-height: 1.55;
}

.atlas-retry {
  margin-top: 15rpx;
  padding: 15rpx;
  color: #7a826f;
  font-size: 17rpx;
  text-align: center;
}

.atlas-bottom-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

.atlas-page--compact .atlas-card-grid {
  gap: 10px;
}

.atlas-page--compact .atlas-card-grid--2 .atlas-item-card {
  width: calc((100% - 10px) / 2);
}

.atlas-page--compact .atlas-item-card__body {
  padding-right: 11rpx;
  padding-left: 11rpx;
}

.atlas-page--compact .atlas-item-card__title {
  font-size: 19rpx;
}

.atlas-page--compact .atlas-item-card__description {
  font-size: 15rpx;
}
