.result-page {
  width: 100%;
  min-height: 100vh;
  padding-bottom: 0;
  background: #fafbf8;
}

.result-content {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 44rpx 120rpx;
  text-align: center;
}

.result-mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf3e9;
  color: #617148;
  font-size: 43rpx;
  font-weight: 700;
}

.result-title {
  margin-top: 25rpx;
  color: #2f342d;
  font-size: 30rpx;
  font-weight: 700;
}

.result-description {
  margin-top: 10rpx;
  color: #7e857b;
  font-size: 18rpx;
}

.result-number {
  margin-top: 18rpx;
  color: #9aa097;
  font-size: 15rpx;
}

.result-notice {
  max-width: 620rpx;
  margin-top: 28rpx;
  padding: 17rpx 20rpx;
  border: 1rpx solid #e0e6dc;
  border-radius: 14rpx;
  background: #f1f5ee;
  color: #727a6f;
  font-size: 15rpx;
  line-height: 1.65;
}

.result-actions {
  display: flex;
  gap: 13rpx;
  margin-top: 30rpx;
}

.result-button {
  display: flex;
  min-width: 160rpx;
  height: 60rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid #dce2d8;
  border-radius: 30rpx;
  background: #ffffff;
  color: #697167;
  font-size: 18rpx;
}

.result-button--primary {
  border-color: #6f8050;
  background: #6f8050;
  color: #ffffff;
}
