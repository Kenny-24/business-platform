<view class="safe-page cart-page {{wideLayout ? 'cart-page--wide' : ''}} {{compactLayout ? 'cart-page--compact' : ''}}">
  <app-nav title="购物车" solid></app-nav>

  <scroll-view class="cart-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onCartRefresh" bindrefresherrestore="onCartRefreshRestore" bindrefresherabort="onCartRefreshAbort">
    <view class="cart-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <block wx:if="{{cart.length}}">
        <view class="cart-head">
          <view class="cart-head__copy">
            <text class="cart-head__title">{{cartTitle}}</text>
            <text wx:if="{{syncText}}" class="cart-head__status">{{syncText}}</text>
          </view>
          <view class="cart-head__edit" bindtap="toggleEdit" role="button">{{editing ? '完成' : '编辑'}}</view>
        </view>

        <view class="cart-layout">
          <view class="cart-products">
            <view wx:for="{{cart}}" wx:key="id" class="cart-product {{item.invalid ? 'cart-product--invalid' : ''}}">
              <view class="cart-product__select">
                <view class="select-dot {{item.selected ? 'select-dot--active' : ''}} {{item.invalid ? 'select-dot--disabled' : ''}}" data-id="{{item.id}}" bindtap="toggleItem" role="button">
                  <text wx:if="{{item.selected}}">✓</text>
                </view>
              </view>

              <image wx:if="{{item.image}}" class="cart-product__image" style="width: {{productImageSize}}px; height: {{productImageSize}}px;" src="{{item.image}}" mode="aspectFill" lazy-load></image>
              <view wx:else class="cart-product__image cart-product__placeholder" style="width: {{productImageSize}}px; height: {{productImageSize}}px;">花予</view>

              <view class="cart-product__info">
                <view class="cart-product__title-row">
                  <text class="cart-product__name">{{item.name}}</text>
                  <view wx:if="{{editing}}" class="cart-product__delete" data-id="{{item.id}}" bindtap="removeOne" role="button">删除</view>
                </view>

                <view class="cart-product__price-row">
                  <text class="cart-product__price">¥{{item.priceText}}</text>
                  <text class="cart-product__unit">/{{item.unit}}</text>
                  <text wx:if="{{item.priceChanged}}" class="cart-product__updated">价格已更新</text>
                </view>

                <text wx:if="{{item.invalid}}" class="cart-product__message cart-product__message--invalid">{{item.invalidReason}}</text>
                <text wx:elif="{{item.lowStock}}" class="cart-product__message">仅剩{{item.stock}}{{item.unit}}</text>

                <view class="cart-product__action-row">
                  <view class="cart-product__subtotal">
                    <text class="cart-product__subtotal-label">小计</text>
                    <text class="cart-product__subtotal-value">¥{{item.subtotalText}}</text>
                  </view>

                  <view class="stepper">
                    <view class="stepper__button" data-id="{{item.id}}" data-delta="-1" bindtap="changeQty" role="button">−</view>
                    <text class="stepper__number">{{item.quantity}}</text>
                    <view class="stepper__button" data-id="{{item.id}}" data-delta="1" bindtap="changeQty" role="button">＋</view>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="cart-side">
            <view class="cart-card option-card">
              <view class="option-item" bindtap="chooseDelivery" role="button">
                <view class="option-item__copy">
                  <text class="option-item__title">收货方式</text>
                  <text class="option-item__description">{{selectedDelivery.description}}</text>
                </view>
                <view class="option-item__right">
                  <text class="option-item__value">{{selectedDelivery.name}}</text>
                  <text class="option-item__arrow">›</text>
                </view>
              </view>

              <view class="option-item" bindtap="choosePackaging" role="button">
                <view class="option-item__copy">
                  <text class="option-item__title">包装方式</text>
                  <text class="option-item__description">{{selectedPackaging.description}}</text>
                </view>
                <view class="option-item__right">
                  <text class="option-item__value">{{selectedPackaging.name}}</text>
                  <text class="option-item__fee">{{packagingFeeText}}</text>
                  <text class="option-item__arrow">›</text>
                </view>
              </view>

              <view class="option-item" bindtap="openPoints" role="button">
                <view class="option-item__copy">
                  <text class="option-item__title">积分抵扣</text>
                  <text class="option-item__description">抵扣金额在结算页计算</text>
                </view>
                <view class="option-item__right">
                  <text class="option-item__value">{{pointsText}}</text>
                  <text class="option-item__arrow">›</text>
                </view>
              </view>
            </view>

            <view class="cart-card fee-card">
              <text class="fee-card__title">费用明细</text>

              <view class="fee-row">
                <text>商品金额</text>
                <text>¥{{goodsTotalText}}</text>
              </view>
              <view class="fee-row">
                <text>包装费用</text>
                <text>{{packagingFeeText}}</text>
              </view>
              <view class="fee-row">
                <text>配送费用</text>
                <text>{{deliveryFeeText}}</text>
              </view>

              <view class="fee-line"></view>

              <view class="fee-row fee-row--total">
                <text>当前合计</text>
                <text>¥{{totalText}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="cart-bottom-space"></view>
      </block>

      <view wx:else class="cart-empty">
        <view class="cart-empty__mark">花</view>
        <text class="cart-empty__title">购物车还是空的</text>
        <text class="cart-empty__description">去挑选一份喜欢的鲜花</text>
        <view class="cart-empty__button" bindtap="goShopping" role="button">去选花</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{cart.length}}" class="checkout-bar">
    <view class="checkout-all" bindtap="toggleAll" role="button">
      <view class="select-dot {{allSelected ? 'select-dot--active' : ''}}">
        <text wx:if="{{allSelected}}">✓</text>
      </view>
      <text class="checkout-all__text">全选</text>
    </view>

    <view class="checkout-total">
      <view class="checkout-total__line">
        <text class="checkout-total__label">合计</text>
        <text class="checkout-total__currency">¥</text>
        <text class="checkout-total__amount">{{totalText}}</text>
      </view>
      <text class="checkout-total__hint">{{checkoutHint}}</text>
    </view>

    <view class="checkout-button {{selectedCount <= 0 ? 'checkout-button--disabled' : ''}} {{editing ? 'checkout-button--delete' : ''}}" bindtap="checkout" role="button">{{checkoutButtonText}}</view>
  </view>
</view>
