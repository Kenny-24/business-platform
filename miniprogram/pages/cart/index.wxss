.cart-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.cart-scroll {
  width: 100%;
  overflow: hidden;
}

.cart-content {
  width: 100%;
  min-height: 100%;
  padding-top: 12rpx;
}

.cart-head {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
}

.cart-head__copy {
  flex: 1 1 auto;
  min-width: 0;
}

.cart-head__title,
.cart-head__status {
  display: block;
}

.cart-head__title {
  color: #292d27;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
}

.cart-head__status {
  margin-top: 5rpx;
  color: #969c93;
  font-size: 17rpx;
  line-height: 1.3;
}

.cart-head__edit {
  flex: 0 0 auto;
  padding: 16rpx 0 16rpx 24rpx;
  color: #617148;
  font-size: 20rpx;
}

.cart-layout,
.cart-products,
.cart-side {
  width: 100%;
  min-width: 0;
}

.cart-product {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8ebe5;
}

.cart-product--invalid {
  opacity: 0.55;
}

.cart-product__select {
  display: flex;
  width: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: flex-start;
}

.select-dot {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #bdc4b9;
  border-radius: 50%;
  background: #ffffff;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1;
}

.select-dot--active {
  border-color: #6f8050;
  background: #6f8050;
}

.select-dot--disabled {
  border-color: #d8dcd5;
  background: #edf0eb;
}

.cart-product__image {
  display: block;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 14rpx;
  background: #eef1eb;
}

.cart-product__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #697951;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.cart-product__info {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 18rpx;
}

.cart-product__title-row {
  display: flex;
  min-width: 0;
  align-items: center;
}

.cart-product__name {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #292d27;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-product__delete {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #9d7163;
  font-size: 17rpx;
}

.cart-product__price-row {
  display: flex;
  min-width: 0;
  align-items: baseline;
  margin-top: 8rpx;
}

.cart-product__price {
  color: #68764b;
  font-size: 21rpx;
  font-weight: 600;
}

.cart-product__unit {
  margin-left: 3rpx;
  color: #91968e;
  font-size: 17rpx;
}

.cart-product__updated {
  flex: 0 0 auto;
  margin-left: 9rpx;
  padding: 3rpx 8rpx;
  border-radius: 7rpx;
  background: #f3ece7;
  color: #a16e5a;
  font-size: 14rpx;
}

.cart-product__message {
  display: block;
  margin-top: 6rpx;
  color: #ab735e;
  font-size: 16rpx;
  line-height: 1.3;
}

.cart-product__message--invalid {
  color: #956f65;
}

.cart-product__action-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.cart-product__subtotal {
  display: flex;
  min-width: 0;
  align-items: baseline;
}

.cart-product__subtotal-label {
  color: #9aa097;
  font-size: 15rpx;
}

.cart-product__subtotal-value {
  margin-left: 6rpx;
  color: #53633e;
  font-size: 23rpx;
  font-weight: 700;
}

.stepper {
  display: flex;
  height: 43rpx;
  flex: 0 0 auto;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #dfe3dc;
  border-radius: 22rpx;
  background: #ffffff;
}

.stepper__button,
.stepper__number {
  display: flex;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.stepper__button {
  width: 44rpx;
  color: #52584f;
  font-size: 22rpx;
}

.stepper__number {
  width: 44rpx;
  border-right: 1rpx solid #ecefe9;
  border-left: 1rpx solid #ecefe9;
  color: #30342e;
  font-size: 18rpx;
}

.cart-card {
  width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e5e9e2;
  border-radius: 18rpx;
  background: #ffffff;
}

.option-item {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 21rpx;
  border-bottom: 1rpx solid #ecefe9;
}

.option-item:last-child {
  border-bottom: 0;
}

.option-item__copy {
  flex: 1 1 auto;
  min-width: 0;
}

.option-item__title,
.option-item__description {
  display: block;
}

.option-item__title {
  color: #30342e;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.3;
}

.option-item__description {
  margin-top: 5rpx;
  overflow: hidden;
  color: #989d95;
  font-size: 16rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-item__right {
  display: flex;
  max-width: 50%;
  flex: 0 0 auto;
  align-items: center;
  margin-left: 14rpx;
}

.option-item__value {
  overflow: hidden;
  color: #6c7269;
  font-size: 18rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-item__fee {
  flex: 0 0 auto;
  margin-left: 7rpx;
  color: #5b6a43;
  font-size: 17rpx;
}

.option-item__arrow {
  flex: 0 0 auto;
  margin-left: 7rpx;
  color: #a5aaa2;
  font-size: 27rpx;
  line-height: 1;
}

.fee-card {
  padding: 21rpx;
}

.fee-card__title {
  display: block;
  margin-bottom: 9rpx;
  color: #30342e;
  font-size: 21rpx;
  font-weight: 600;
}

.fee-row {
  display: flex;
  min-height: 43rpx;
  align-items: center;
  justify-content: space-between;
  color: #777d74;
  font-size: 18rpx;
}

.fee-line {
  height: 1rpx;
  margin: 8rpx 0;
  background: #ecefe9;
}

.fee-row--total {
  color: #30342e;
  font-weight: 600;
}

.fee-row--total text:last-child {
  color: #53633e;
  font-size: 25rpx;
}

.cart-bottom-space {
  height: calc(148rpx + env(safe-area-inset-bottom));
}

.cart-empty {
  display: flex;
  min-height: 570rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.cart-empty__mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf2e8;
  color: #68784f;
  font-size: 27rpx;
  font-weight: 700;
}

.cart-empty__title {
  margin-top: 22rpx;
  color: #30342e;
  font-size: 25rpx;
  font-weight: 600;
}

.cart-empty__description {
  margin-top: 8rpx;
  color: #989d95;
  font-size: 18rpx;
}

.cart-empty__button {
  display: flex;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  margin-top: 23rpx;
  padding: 0 34rpx;
  border-radius: 29rpx;
  background: #6f8050;
  color: #ffffff;
  font-size: 20rpx;
}

.checkout-bar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 104rpx;
  align-items: center;
  padding: 13rpx 20rpx calc(13rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5e9e2;
  background: rgba(255, 255, 255, 0.97);
}

.checkout-all {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.checkout-all__text {
  margin-left: 8rpx;
  color: #646a61;
  font-size: 19rpx;
}

.checkout-total {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0 13rpx;
  text-align: right;
}

.checkout-total__line {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  white-space: nowrap;
}

.checkout-total__label {
  color: #575d54;
  font-size: 17rpx;
}

.checkout-total__currency {
  margin-left: 6rpx;
  color: #53633e;
  font-size: 17rpx;
}

.checkout-total__amount {
  color: #53633e;
  font-size: 29rpx;
  font-weight: 700;
}

.checkout-total__hint {
  display: block;
  margin-top: 2rpx;
  overflow: hidden;
  color: #a0a59d;
  font-size: 13rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-button {
  display: flex;
  min-width: 176rpx;
  height: 64rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: #6f8050;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.checkout-button--disabled {
  background: #c7ccc3;
}

.checkout-button--delete {
  background: #8c6d61;
}

.cart-page--compact .cart-product__select {
  width: 42rpx;
  flex-basis: 42rpx;
}

.cart-page--compact .cart-product__info {
  margin-left: 13rpx;
}

.cart-page--compact .cart-product__name {
  font-size: 22rpx;
}

.cart-page--compact .checkout-button {
  min-width: 136rpx;
  padding: 0 14rpx;
}

.cart-page--compact .checkout-total__hint {
  display: none;
}

.cart-page--wide .cart-layout {
  display: flex;
  align-items: flex-start;
}

.cart-page--wide .cart-products {
  width: 61%;
  flex: 0 0 61%;
  padding-right: 12rpx;
}

.cart-page--wide .cart-side {
  width: 39%;
  flex: 0 0 39%;
  padding-left: 12rpx;
}

.cart-page--wide .cart-side .cart-card:first-child {
  margin-top: 0;
}
