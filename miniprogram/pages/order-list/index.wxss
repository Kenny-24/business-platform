.order-list-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.order-tabs {
  width: 100%;
  height: 52px;
  border-bottom: 1rpx solid #e7eae4;
  background: #ffffff;
}

.order-tabs__scroll,
.order-tabs__inner {
  height: 52px;
}

.order-tabs__inner {
  display: flex;
  min-width: max-content;
  align-items: stretch;
  padding: 0 10rpx;
}

.order-tab {
  position: relative;
  display: flex;
  min-width: 112rpx;
  height: 52px;
  align-items: center;
  justify-content: center;
  padding: 0 13rpx;
  color: #7f867c;
  font-size: 17rpx;
  white-space: nowrap;
}

.order-tab--active {
  color: #596942;
  font-weight: 600;
}

.order-tab--active::after {
  position: absolute;
  right: 25rpx;
  bottom: 0;
  left: 25rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #6f8050;
  content: "";
}

.order-tab__count {
  margin-left: 5rpx;
  color: #8e957f;
  font-size: 13rpx;
}

.order-list-scroll,
.order-list-content {
  width: 100%;
}

.order-list-content {
  min-height: 100%;
  padding-top: 16rpx;
}

.order-list-state {
  padding: 130rpx 0;
  color: #92988f;
  font-size: 18rpx;
  text-align: center;
}

.order-card {
  margin-top: 15rpx;
  overflow: hidden;
  border: 1rpx solid #e5e9e2;
  border-radius: 18rpx;
  background: #ffffff;
}

.order-card:first-child {
  margin-top: 0;
}

.order-card__head,
.order-card__product,
.order-card__footer,
.order-card__meta {
  display: flex;
}

.order-card__head,
.order-card__footer {
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
}

.order-card__head {
  border-bottom: 1rpx solid #edf0ea;
}

.order-card__meta {
  min-width: 0;
  flex-direction: column;
}

.order-card__number {
  color: #30342e;
  font-size: 17rpx;
  font-weight: 600;
}

.order-card__time {
  margin-top: 5rpx;
  color: #9a9f97;
  font-size: 13rpx;
}

.order-card__status {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #68764b;
  font-size: 17rpx;
  font-weight: 600;
}

.order-card__status--cancelled,
.order-card__status--refunded {
  color: #8e807a;
}

.order-card__product {
  align-items: center;
  padding: 17rpx 20rpx;
}

.order-card__image {
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #eef1eb;
}

.order-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #68784f;
  font-size: 15rpx;
  font-weight: 700;
}

.order-card__copy {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 14rpx;
}

.order-card__name,
.order-card__description,
.order-card__more {
  display: block;
}

.order-card__name {
  overflow: hidden;
  color: #30342e;
  font-size: 19rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card__description,
.order-card__more {
  margin-top: 6rpx;
  color: #91978e;
  font-size: 14rpx;
}

.order-card__amount {
  flex: 0 0 auto;
  margin-left: 12rpx;
  text-align: right;
}

.order-card__amount text {
  display: block;
}

.order-card__amount text:first-child {
  color: #999f96;
  font-size: 14rpx;
}

.order-card__amount text:last-child {
  margin-top: 7rpx;
  color: #53633e;
  font-size: 21rpx;
  font-weight: 700;
}

.order-card__footer {
  border-top: 1rpx solid #edf0ea;
  color: #8d938a;
  font-size: 14rpx;
}

.order-card__detail {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  margin-left: 12rpx;
  color: #64734b;
}

.order-card__chevron {
  width: 11rpx;
  height: 11rpx;
  flex: 0 0 11rpx;
  margin-left: 8rpx;
  border-top: 2rpx solid #788567;
  border-right: 2rpx solid #788567;
  transform: rotate(45deg);
}

.order-empty {
  display: flex;
  min-height: 560rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.order-empty__mark {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf2e8;
  color: #68784f;
  font-size: 26rpx;
  font-weight: 700;
}

.order-empty__title {
  margin-top: 20rpx;
  color: #30342e;
  font-size: 24rpx;
  font-weight: 600;
}

.order-empty__description {
  margin-top: 8rpx;
  color: #989d95;
  font-size: 17rpx;
}

.order-empty__button {
  display: flex;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 32rpx;
  border-radius: 29rpx;
  background: #6f8050;
  color: #ffffff;
  font-size: 18rpx;
}

.order-list-bottom-space {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.order-list-page--wide .order-list-content {
  max-width: 1040rpx;
  margin: 0 auto;
}

.order-list-page--wide .order-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.order-list-page--wide .order-card {
  margin-top: 0;
}

.order-list-page--compact .order-card__head,
.order-list-page--compact .order-card__product,
.order-list-page--compact .order-card__footer {
  padding-right: 17rpx;
  padding-left: 17rpx;
}
