.edit-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.edit-scroll,
.edit-content {
  width: 100%;
}

.edit-content {
  min-height: 100%;
  padding-top: 16rpx;
}

.edit-loading {
  padding: 120rpx 0;
  color: #979d94;
  font-size: 18rpx;
  text-align: center;
}

.edit-card {
  overflow: hidden;
  border: 1rpx solid #e5e9e2;
  border-radius: 18rpx;
  background: #ffffff;
}

.form-row {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  padding: 17rpx 21rpx;
  border-bottom: 1rpx solid #edf0ea;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-row--interactive {
  cursor: pointer;
}

.form-row--textarea {
  min-height: 118rpx;
  align-items: flex-start;
}

.form-row__label {
  width: 138rpx;
  flex: 0 0 138rpx;
  color: #343832;
  font-size: 19rpx;
  line-height: 1.35;
}

.form-row__input,
.form-row__textarea,
.form-row__value {
  flex: 1 1 auto;
  min-width: 0;
  color: #30342e;
  font-size: 19rpx;
}

.form-row__input {
  height: 50rpx;
  text-align: right;
}

.form-row__textarea {
  min-height: 78rpx;
  line-height: 1.55;
  text-align: right;
}

.form-row__end {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  align-items: center;
  justify-content: flex-end;
  margin-left: 12rpx;
}

.form-row__end--location {
  max-width: 58%;
}

.form-row__value {
  overflow: hidden;
  line-height: 1.35;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-row__value.is-placeholder {
  color: #a3a8a0;
}

.form-row__chevron {
  width: 13rpx;
  height: 13rpx;
  flex: 0 0 13rpx;
  margin-left: 12rpx;
  border-top: 2rpx solid #a9afa6;
  border-right: 2rpx solid #a9afa6;
  transform: rotate(45deg);
}

.form-row__copy {
  flex: 1 1 auto;
  min-width: 0;
}

.form-row__copy .form-row__label {
  display: block;
  width: auto;
}

.form-row__description {
  display: block;
  margin-top: 5rpx;
  color: #989d95;
  font-size: 15rpx;
  line-height: 1.35;
}

.form-section {
  padding: 20rpx 21rpx;
  border-bottom: 1rpx solid #edf0ea;
}

.form-section__title {
  color: #343832;
  font-size: 19rpx;
}

.label-options {
  display: flex;
  gap: 12rpx;
  margin-top: 15rpx;
}

.label-option {
  display: flex;
  min-width: 88rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e0e5dc;
  border-radius: 24rpx;
  color: #777e74;
  font-size: 16rpx;
}

.label-option--active {
  border-color: #cdd8c5;
  background: #edf3e9;
  color: #5e6e45;
}

.edit-bottom-space {
  height: calc(118rpx + env(safe-area-inset-bottom));
}

.edit-fixed-bar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e6e9e3;
  background: rgba(255, 255, 255, 0.97);
}

.edit-submit {
  display: flex;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 33rpx;
  background: #6f8050;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
}

.edit-submit--disabled {
  background: #bfc7b9;
}

.edit-page--wide .edit-content {
  max-width: 920rpx;
  margin: 0 auto;
}

.edit-page--compact .form-row {
  padding-right: 18rpx;
  padding-left: 18rpx;
}

.edit-page--compact .form-row__label {
  width: 118rpx;
  flex-basis: 118rpx;
}

.edit-page--compact .form-row__end--location {
  max-width: 52%;
}
