.nav,
.nav-spacer,
.nav__inner,
.nav__center,
.nav__title,
.nav__brand-image,
.nav__subtitle,
.nav__location,
.nav__location-icon,
.nav__location-text {
  box-sizing: border-box;
}

.nav-spacer {
  width: 100%;
}

.nav {
  position: fixed;
  z-index: 1000;
  top: 0;
  left: 0;
  width: 100%;
  overflow: hidden;
  background: rgba(251, 250, 247, 0.98);
  transition:
    background-color 180ms ease,
    box-shadow 180ms ease;
}

.nav--transparent,
.nav--overlay {
  background: transparent;
}

.nav--solid {
  background: rgba(251, 250, 247, 0.98);
  box-shadow: 0 1rpx 0 rgba(72, 66, 54, 0.08);
}

.nav__inner {
  position: relative;
  width: 100%;
}

/*
 * 品牌层以完整导航内容区为基准绝对居中。
 * 图片本身带有对称透明边距，因此不同系统视觉中心保持一致。
 */
.nav__center {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  pointer-events: none;
}

.nav__brand-image {
  display: block;
  width: 126rpx;
  height: 46rpx;
  transform: translateY(-9rpx);
}

.nav__title {
  max-width: 54%;
  overflow: hidden;
  color: #20201d;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav__subtitle {
  margin-top: 8rpx;
  color: #7d786f;
  font-size: 20rpx;
  line-height: 1;
  white-space: nowrap;
}

.nav__location {
  position: absolute;
  z-index: 3;
  top: 50%;
  left: 24rpx;
  display: flex;
  align-items: center;
  max-width: 176rpx;
  height: 54rpx;
  min-width: 0;
  margin: 0;
  padding: 0 17rpx 0 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 27rpx;
  background: rgba(34, 32, 28, 0.25);
  color: #ffffff;
  line-height: 1;
  transform: translateY(-50%);
}

.nav__location::after {
  border: 0;
}

.nav--solid .nav__location {
  border-color: rgba(91, 105, 64, 0.14);
  background: rgba(255, 255, 255, 0.94);
  color: #5f713f;
  box-shadow: 0 5rpx 18rpx rgba(50, 46, 38, 0.05);
}

.nav__location--pressed {
  opacity: 0.78;
}

.nav__location-icon {
  flex: 0 0 28rpx;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.nav__location-text {
  min-width: 0;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .nav__location {
    left: 16rpx;
    max-width: 144rpx;
    height: 50rpx;
    padding-right: 12rpx;
    padding-left: 10rpx;
  }

  .nav__location-icon {
    flex-basis: 25rpx;
    width: 25rpx;
    height: 25rpx;
  }

  .nav__brand-image {
    width: 116rpx;
    height: 43rpx;
    transform: translateY(-8rpx);
  }
}
