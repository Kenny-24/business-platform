.product {
  width: 100%;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(81, 75, 64, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 7rpx 24rpx rgba(58, 52, 43, 0.035);
}

.product__image {
  display: block;
  width: 100%;
  height: 188rpx;
  background: #f3f0e9;
}

.product__body {
  min-width: 0;
  padding: 16rpx 16rpx 14rpx;
}

.product__name,
.product__subtitle {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product__name {
  color: #272621;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 26rpx;
  line-height: 1.3;
}

.product__subtitle {
  margin-top: 5rpx;
  color: #969188;
  font-size: 19rpx;
  line-height: 1.35;
}

.product__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  margin-top: 11rpx;
}

.product__price {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #d96f76;
  font-size: 25rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product__unit {
  color: #9a958c;
  font-size: 17rpx;
}

.product__add {
  display: flex;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  min-width: 38rpx;
  max-width: 38rpx;
  height: 38rpx;
  margin: 0 0 0 8rpx;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #d96f76;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 300;
  line-height: 38rpx;
  text-align: center;
}

.product__add::after {
  border: 0;
}

.product__add--pressed {
  opacity: 0.86;
  transform: scale(0.92);
}

.product--compact .product__image {
  height: 150rpx;
}

.product--compact .product__body {
  padding: 13rpx 13rpx 12rpx;
}

.product--compact .product__name {
  font-size: 23rpx;
}

.product--compact .product__subtitle {
  margin-top: 4rpx;
  font-size: 18rpx;
}

.product--compact .product__price {
  font-size: 23rpx;
}


.product__image--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 38%, rgba(104, 118, 75, 0.12), transparent 34%),
    #f3f0e9;
}

.product__placeholder-text {
  color: #68764b;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
