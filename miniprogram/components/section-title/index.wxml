<view class="section-title">
  <view class="section-title__copy">
    <text class="section-title__main">{{title}}</text>
    <text
      wx:if="{{subtitle}}"
      class="section-title__sub"
    >
      {{subtitle}}
    </text>
  </view>

  <button
    wx:if="{{showMore}}"
    class="section-title__more"
    bindtap="onMore"
    hover-class="none"
  >
    {{moreText}} <text>›</text>
  </button>
</view>
