.section-title,
.section-title__copy,
.section-title__main,
.section-title__sub,
.section-title__more {
  box-sizing: border-box;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  min-height: 50rpx;
  margin-bottom: 24rpx;
}

.section-title__copy {
  flex: 1 1 auto;
  min-width: 0;
}

.section-title__main,
.section-title__sub {
  display: block;
  max-width: 100%;
}

.section-title__main {
  overflow: hidden;
  color: #24231f;
  font-family:
    "PingFang SC",
    "Hiragino Sans GB",
    "Microsoft YaHei",
    "Noto Sans CJK SC",
    sans-serif;
  font-size: 32rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title__sub {
  margin-top: 8rpx;
  overflow: hidden;
  color: #99948b;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title__more {
  flex: 0 0 auto;
  min-width: 0;
  margin: 0;
  padding: 8rpx 0 8rpx 16rpx;
  border: 0;
  color: #8f8b83;
  font-size: 21rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.section-title__more::after {
  border: 0;
}
