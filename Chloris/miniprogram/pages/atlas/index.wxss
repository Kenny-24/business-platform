.atlas-page {
  width: 100%;
  min-height: 100vh;
  padding-bottom: 0;
  background: var(--bg);
}

.atlas-content {
  width: 100%;
  min-height: 100%;
  padding-top: 18rpx;
}

.atlas-intro {
  padding: 24rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 0;
  background: #f6f6f4;
  box-shadow: none;
}

.atlas-intro__eyebrow,
.atlas-intro__title,
.atlas-intro__description {
  display: block;
}

.atlas-intro__eyebrow {
  color: #768262;
  font-family: Georgia, serif;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.atlas-intro__title {
  margin-top: 9rpx;
  color: #2d312a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  line-height: 1.35;
}

.atlas-intro__description {
  margin-top: 9rpx;
  color: #747971;
  font-size: 24rpx;
  line-height: 1.68;
}

.atlas-toolbar {
  margin-top: 17rpx;
}

.atlas-tabs {
  display: flex;
  width: 100%;
  height: 62rpx;
  padding: 4rpx;
  border: 1rpx solid #eeeeeb;
  border-radius: 17rpx;
  background: #eff2ec;
}

.atlas-tab {
  display: flex;
  width: 50%;
  flex: 0 0 50%;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  color: #777e73;
  font-size: 26rpx;
  transition: color 150ms ease, background 150ms ease, box-shadow 150ms ease;
}

.atlas-tab--active {
  background: #ffffff;
  color: #54633e;
  font-weight: 600;
  box-shadow: none;
}

.atlas-search {
  display: flex;
  width: 100%;
  height: 66rpx;
  align-items: center;
  margin-top: 12rpx;
  padding: 0 17rpx;
  border: 1rpx solid #e3e6df;
  border-radius: 17rpx;
  background: #ffffff;
}

.atlas-search__icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 22rpx;
  margin-right: 13rpx;
  border: 3rpx solid #8d8d88;
  border-radius: 50%;
}

.atlas-search__icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #8d8d88;
  content: "";
  transform: rotate(45deg);
}

.atlas-search__input {
  flex: 1 1 auto;
  min-width: 0;
  height: 64rpx;
  padding: 0;
  color: #2d312b;
  font-size: 24rpx;
  line-height: 64rpx;
}

.atlas-search__placeholder {
  color: #a1a69e;
}

.atlas-search__clear {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  color: #8d8d88;
  font-size: 29rpx;
}

.atlas-result-head {
  display: flex;
  min-width: 0;
  align-items: flex-end;
  justify-content: space-between;
  margin: 24rpx 0 14rpx;
}

.atlas-result-head > view {
  flex: 1 1 auto;
  min-width: 0;
}

.atlas-result-head > view > text:first-child {
  display: block;
  color: #2c302a;
  font-size: 28rpx;
  font-weight: 600;
}

.atlas-result-head__sub {
  display: block;
  margin-top: 6rpx;
  color: #959a92;
  font-size: 22rpx;
  font-weight: 400;
}

.atlas-result-head__count {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #8f958b;
  font-size: 22rpx;
}

.atlas-card-grid {
  display: grid;
  width: 100%;
  align-items: start;
  gap: 24rpx;
}

.atlas-card-grid--1 { grid-template-columns: 1fr; }
.atlas-card-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.atlas-card-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.atlas-card-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

.atlas-item-card {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #e3e7df;
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
}

.atlas-item-card__media {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.atlas-item-card__media--dark { background: #111210; }
.atlas-item-card__media--light { background: #ffffff; }
.atlas-item-card__media--soft { background: #f6f6f4; }

.atlas-item-card__image,
.atlas-item-card__placeholder {
  display: block;
  width: 100%;
  height: 100%;
}

.atlas-item-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111111;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.atlas-item-card__purchased {
  position: absolute;
  z-index: 2;
  top: 11rpx;
  left: 11rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.92);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.atlas-item-card__favorite {
  position: absolute;
  z-index: 3;
  top: 9rpx;
  right: 9rpx;
  display: flex;
  width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: none;
}

.favorite-star {
  display: block;
  color: #777772;
  font-size: 30rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.atlas-item-card__favorite--active {
  background: rgba(17, 17, 17, 0.96);
}

.atlas-item-card__favorite--active .favorite-star {
  color: #ffffff;
}

.atlas-item-card__body {
  padding: 14rpx 14rpx 15rpx;
}

.atlas-item-card__title,
.atlas-item-card__latin,
.atlas-item-card__description {
  display: block;
}

.atlas-item-card__title {
  overflow: hidden;
  color: #171717;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.atlas-item-card__latin {
  margin-top: 4rpx;
  overflow: hidden;
  color: #9b9b96;
  font-family: Georgia, serif;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.atlas-item-card__description {
  min-height: 48rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #626961;
  font-size: 22rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.atlas-item-card__meta {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  margin-top: 11rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #eeeeeb;
  color: #7d8579;
  font-size: 20rpx;
}

.atlas-item-card__meta text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.atlas-item-card__chevron {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-left: 8rpx;
  border-top: 2rpx solid #8d8d88;
  border-right: 2rpx solid #8d8d88;
  transform: rotate(45deg);
}

.atlas-empty {
  display: flex;
  min-height: 300rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  border: 1rpx solid #eeeeeb;
  border-radius: 0;
  background: #ffffff;
  text-align: center;
}

.atlas-empty__title {
  color: #5b5b56;
  font-size: 26rpx;
}

.atlas-empty__description {
  max-width: 82%;
  margin-top: 9rpx;
  color: #9b9b96;
  font-size: 22rpx;
  line-height: 1.55;
}

.atlas-retry {
  margin-top: 15rpx;
  padding: 15rpx;
  color: #727b67;
  font-size: 22rpx;
  text-align: center;
}

.atlas-bottom-space {
  height: calc(52rpx + env(safe-area-inset-bottom));
}

.atlas-page--compact .atlas-card-grid {
  gap: 20rpx;
}

.atlas-page--compact .atlas-item-card__body {
  padding-right: 11rpx;
  padding-left: 11rpx;
}

.atlas-page--compact .atlas-item-card__title {
  font-size: 26rpx;
}

.atlas-item-card__chevron { display: block; align-self: center; transform: rotate(45deg); }

/* V6.14 visual consistency for legacy hidden page */
.atlas-page { background:#f7f7f5; }
.atlas-intro,.atlas-toolbar,.atlas-item-card,.atlas-empty { border:1rpx solid #eeeeeb; border-radius:0; background:#fff; box-shadow:none; }
.atlas-intro__title,.atlas-item-card__title,.atlas-empty__title { color:#171717; font-family:inherit; font-weight:650; }
.atlas-tab,.atlas-search { border:1rpx solid #deded9; border-radius:999rpx; background:#fff; color:#5b5b56; }
.atlas-tab--active { border-color:#111; background:#111; color:#fff; }
.atlas-item-card__media { background:#f3f3f1 !important; }
