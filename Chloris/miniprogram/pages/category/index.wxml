<view class="safe-page category-page">
  <app-nav title="分类" solid></app-nav>

  <view
    class="category-layout {{compactLayout ? 'category-layout--compact' : ''}}"
    style="height: {{contentHeight}}px;"
  >
    <scroll-view
      class="category-sidebar"
      style="width: {{sidebarWidth}}px;"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="category-sidebar__inner">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="selectCategory"
          class="category-tab {{activeCategory === index ? 'category-tab--active' : ''}}"
          role="button"
        >
          <text class="category-tab__text">{{item}}</text>
        </view>
      </view>
    </scroll-view>

    <scroll-view
      class="category-main"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view
        class="category-main-inner"
        style="padding-left: {{mainHorizontalPadding}}px; padding-right: {{mainHorizontalPadding}}px;"
      >
        <view class="search-box">
          <view class="search-icon"></view>
          <input
            class="search-input"
            value="{{searchQuery}}"
            placeholder="搜索相关花束或花材"
            placeholder-class="search-placeholder"
            confirm-type="search"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
          />
          <view wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch">×</view>
        </view>

        <view class="sort-bar">
          <view
            class="sort-item {{sortMode === 'comprehensive' ? 'sort-item--active' : ''}}"
            data-mode="comprehensive"
            bindtap="selectSort"
            role="button"
          >综合</view>
          <view
            class="sort-item {{sortMode === 'priceAsc' || sortMode === 'priceDesc' ? 'sort-item--active' : ''}}"
            data-mode="price"
            bindtap="selectSort"
            role="button"
          >
            <text>价格</text>
            <view class="price-sort-arrows">
              <view class="price-sort-arrow price-sort-arrow--up {{sortMode === 'priceAsc' ? 'price-sort-arrow--active' : ''}}"></view>
              <view class="price-sort-arrow price-sort-arrow--down {{sortMode === 'priceDesc' ? 'price-sort-arrow--active' : ''}}"></view>
            </view>
          </view>
          <view
            class="sort-item {{sortMode === 'new' ? 'sort-item--active' : ''}}"
            data-mode="new"
            bindtap="selectSort"
            role="button"
          >新品</view>
        </view>

        <scroll-view
          wx:if="{{isFreshFlowerCategory}}"
          class="color-filter"
          scroll-x
          enhanced
          show-scrollbar="{{false}}"
        >
          <view class="color-filter__inner">
            <view
              wx:for="{{colorFilters}}"
              wx:key="id"
              class="color-filter__item {{activeColor === item.id ? 'color-filter__item--active' : ''}}"
              data-color-id="{{item.id}}"
              bindtap="selectColor"
              role="button"
            >
              <view wx:if="{{item.id !== 'all'}}" class="color-filter__swatch color-filter__swatch--{{item.id}}"></view>
              <text class="color-filter__label">{{item.label}}</text>
            </view>
          </view>
        </scroll-view>

        <view class="result-head">
          <text class="result-title">{{resultTitle}}</text>
          <text class="result-count">{{resultCount}} 款可售</text>
        </view>

        <flower-loader wx:if="{{loading}}" compact text="正在整理可售鲜花…"></flower-loader>

        <view wx:elif="{{products.length}}" class="category-grid category-grid--{{gridColumns}}">
          <view
            class="category-product {{item.cartQuantity > 0 ? 'category-product--in-cart' : ''}} {{item.recentlyAdded ? 'category-product--just-added' : ''}}"
            wx:for="{{products}}"
            wx:key="id"
          >
            <view wx:if="{{item.salesMode === 'preorder' || item.limitedTimeEnabled}}" class="category-product__badge">{{item.salesMode === 'preorder' ? '预约' : '限时'}}</view>
            <image
              wx:if="{{item.image}}"
              class="category-product__image"
              style="height: {{productImageHeight}}px;"
              src="{{item.image}}"
              mode="aspectFill"
              lazy-load
              data-product-id="{{item.id}}"
              bindtap="openProduct"
              role="button"
              aria-label="查看{{item.name}}详情"
            ></image>
            <view
              wx:else
              class="category-product__image category-product__placeholder"
              style="height: {{productImageHeight}}px;"
              data-product-id="{{item.id}}"
              bindtap="openProduct"
              role="button"
              aria-label="查看{{item.name}}详情"
            >CHLORIS</view>

            <view class="category-product__body">
              <text class="category-product__name">{{item.name}}</text>
              <text wx:if="{{item.subtitle}}" class="category-product__subtitle">{{item.subtitle}}</text>
              <view class="category-product__footer">
                <view class="category-product__price">
                  <text class="category-product__currency">¥</text>
                  <text class="category-product__amount">{{item.priceText}}</text>
                  <text class="category-product__unit">/{{item.unit}}</text>
                </view>
                <view wx:if="{{item.cartQuantity > 0}}" class="category-product__quantity" catchtap="stopPropagation">
                  <view
                    class="category-product__quantity-button category-product__quantity-button--minus"
                    data-product-id="{{item.id}}"
                    catchtap="decreaseProduct"
                    role="button"
                    aria-label="减少数量"
                  >−</view>
                  <text class="category-product__quantity-value">{{item.cartQuantity}}</text>
                  <view
                    class="category-product__quantity-button category-product__quantity-button--plus {{item.recentlyAdded ? 'category-product__quantity-button--pulse' : ''}}"
                    data-product-id="{{item.id}}"
                    catchtap="increaseProduct"
                    role="button"
                    aria-label="增加数量"
                  >＋</view>
                </view>
                <view
                  wx:else
                  class="category-product__add {{item.recentlyAdded ? 'category-product__add--pulse' : ''}}"
                  data-product-id="{{item.id}}"
                  catchtap="addProduct"
                  role="button"
                  aria-label="加入购物车"
                >
                  <text class="category-product__add-icon">＋</text>
                </view>
              </view>
              <text wx:if="{{item.stock > 0 && item.stock <= 5}}" class="category-product__stock">仅剩 {{item.stock}}{{item.unit}}</text>
            </view>
          </view>
        </view>

        <view wx:else class="category-empty">
          <text class="category-empty__title">没有找到当前可售商品</text>
          <text class="category-empty__sub">可以切换商品分类或修改关键词</text>
          <view wx:if="{{searchQuery}}" class="category-empty__button" bindtap="clearSearch" role="button">清除搜索</view>
        </view>

        <view class="bottom-space"></view>
      </view>
    </scroll-view>
  </view>

</view>
