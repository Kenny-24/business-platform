.profile-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: linear-gradient(180deg, #f8f4f1 0, #fafbf8 360rpx, #fafbf8 100%);
}

.profile-scroll {
  width: 100%;
  overflow: hidden;
}

.profile-content {
  width: 100%;
  min-height: 100%;
  padding-top: 18rpx;
}

.identity-card {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid #e7dfd8;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #f6ece8 0%, #f6f7f1 100%);
  box-shadow: 0 10rpx 30rpx rgba(67, 56, 49, 0.05);
}

.identity-card__avatar {
  display: block;
  flex: 0 0 auto;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: #e5e5dd;
  box-shadow: 0 5rpx 18rpx rgba(50, 46, 40, 0.08);
}

.identity-card__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7651;
  font-family: Georgia, serif;
  font-size: 32rpx;
  font-weight: 600;
}

.identity-card__copy {
  min-width: 0;
  flex: 1 1 auto;
  margin-left: 18rpx;
}

.identity-card__name,
.identity-card__description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-card__name {
  color: #2c302a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.identity-card__description {
  margin-top: 7rpx;
  color: #84847d;
  font-size: 17rpx;
}

.row-arrow {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.row-arrow__shape {
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid #8d9188;
  border-right: 2rpx solid #8d9188;
  transform: rotate(45deg) translate(-2rpx, 2rpx);
}

.row-arrow--small {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  margin-left: 3rpx;
}

.row-arrow--small .row-arrow__shape {
  width: 10rpx;
  height: 10rpx;
}

.profile-card {
  width: 100%;
  margin-top: 16rpx;
  overflow: visible;
  border: 1rpx solid #e7e5df;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(55, 50, 42, 0.035);
}

.card-head {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 22rpx 10rpx;
}

.card-head--plain { justify-content: flex-start; }

.card-head__title {
  color: #2e312c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card-head__more {
  display: flex;
  min-height: 42rpx;
  align-items: center;
  padding-left: 12rpx;
  color: #92968e;
  font-size: 16rpx;
}

.order-grid {
  display: flex;
  width: 100%;
  align-items: flex-start;
  padding: 12rpx 8rpx 26rpx;
}

.order-entry {
  display: flex;
  width: 20%;
  min-width: 0;
  flex: 0 0 20%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.order-entry__icon-wrap {
  position: relative;
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.order-entry__icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce1d7;
  border-radius: 18rpx;
  background: #f8faf6;
}

.order-entry__icon-image {
  width: 37rpx;
  height: 37rpx;
}

.order-entry__badge {
  position: absolute;
  z-index: 2;
  top: -4rpx;
  right: -7rpx;
  display: flex;
  min-width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  padding: 0 7rpx;
  box-sizing: border-box;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #718251;
  color: #ffffff;
  font-size: 12rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.order-entry__label {
  display: block;
  max-width: 100%;
  margin-top: 10rpx;
  overflow: hidden;
  color: #666c62;
  font-size: 15rpx;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.asset-grid {
  display: flex;
  width: 100%;
  align-items: stretch;
  padding: 6rpx 8rpx 24rpx;
}

.asset-entry {
  position: relative;
  display: flex;
  width: 33.333%;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 4rpx;
}

.asset-entry + .asset-entry::before {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 0;
  width: 1rpx;
  background: #ecefe9;
  content: "";
}

.asset-entry__value {
  color: #596943;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.2;
}

.asset-entry__label {
  margin-top: 7rpx;
  color: #8d9289;
  font-size: 15rpx;
}

.service-card {
  overflow: hidden;
}

.service-entry {
  display: grid;
  width: 100%;
  min-width: 0;
  min-height: 94rpx;
  grid-template-columns: 44rpx minmax(0, 1fr) auto 32rpx;
  align-items: center;
  margin: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 0;
  border-top: 1rpx solid #ecefe9;
  border-radius: 0;
  background: #ffffff;
  color: inherit;
  line-height: normal;
  text-align: left;
}

.service-entry::after { border: 0; }

.service-entry__icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.service-entry__copy {
  min-width: 0;
  margin-left: 15rpx;
}

.service-entry__label,
.service-entry__description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-entry__label {
  color: #343832;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.3;
}

.service-entry__description {
  margin-top: 5rpx;
  color: #9a9e96;
  font-size: 14rpx;
  line-height: 1.3;
}

.service-entry__value {
  max-width: 130rpx;
  margin-left: 12rpx;
  overflow: hidden;
  color: #93988f;
  font-size: 15rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-slogan {
  display: block;
  padding: 28rpx 0 4rpx;
  color: #afb3ac;
  font-size: 14rpx;
  text-align: center;
}

.profile-bottom-space {
  height: calc(108rpx + env(safe-area-inset-bottom));
}

.profile-page--wide .profile-content {
  max-width: 1120rpx;
  margin: 0 auto;
}

.profile-page--compact .identity-card { padding: 19rpx; }
.profile-page--compact .identity-card__copy { margin-left: 13rpx; }
.profile-page--compact .identity-card__name { font-size: 25rpx; }
.profile-page--compact .order-entry__icon-wrap { width: 58rpx; height: 58rpx; }
.profile-page--compact .order-entry__icon { width: 52rpx; height: 52rpx; }
.profile-page--compact .order-entry__icon-image { width: 33rpx; height: 33rpx; }
.profile-page--compact .order-entry__badge { right: -5rpx; }

/* ===== 我的页订单图标与客服行对齐修正 ===== */
.order-grid {
  padding-top: 10rpx;
  padding-bottom: 28rpx;
}

.order-entry__icon-wrap {
  position: relative;
  display: flex;
  width: 68rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.order-entry__icon-image {
  display: block;
  width: 46rpx;
  height: 46rpx;
}

.order-entry__badge {
  position: absolute;
  z-index: 3;
  top: -3rpx;
  right: -1rpx;
  display: flex;
  min-width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  padding: 0 7rpx;
  box-sizing: border-box;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #718251;
  color: #ffffff;
  font-size: 12rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
}

.order-entry__label {
  margin-top: 8rpx;
}

.service-entry {
  position: relative;
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr) auto 32rpx;
  align-items: center;
  justify-items: stretch;
  min-height: 94rpx;
  padding: 0 22rpx;
  text-align: left;
}

.service-entry__icon {
  justify-self: start;
}

.service-entry__copy {
  justify-self: stretch;
  margin-left: 15rpx;
  text-align: left;
}

.service-entry__label,
.service-entry__description {
  text-align: left;
}

.service-entry__value {
  justify-self: end;
  text-align: right;
}

.service-entry .row-arrow {
  justify-self: end;
}

.service-entry__contact-hit {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.service-entry__contact-hit::after {
  border: 0;
}

.profile-page--compact .order-entry__icon-wrap {
  width: 62rpx;
  height: 58rpx;
}

.profile-page--compact .order-entry__icon-image {
  width: 41rpx;
  height: 41rpx;
}

.profile-page--compact .order-entry__badge {
  right: -1rpx;
}


/* V6.5 订单状态图标：无外框、细线、尺寸更清晰 */
.order-entry__icon-wrap {
  width: 76rpx;
  height: 70rpx;
}

.order-entry__icon-image {
  width: 54rpx;
  height: 54rpx;
}

.order-entry__badge {
  top: -1rpx;
  right: 0;
}

.profile-page--compact .order-entry__icon-wrap {
  width: 68rpx;
  height: 64rpx;
}

.profile-page--compact .order-entry__icon-image {
  width: 49rpx;
  height: 49rpx;
}
