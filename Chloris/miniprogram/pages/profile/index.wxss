.profile-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f6f6f4;
  color: #1f211e;
}

.profile-scroll {
  width: 100%;
  overflow: hidden;
}

.profile-content {
  width: 100%;
  min-height: 100%;
  padding-top: 18rpx;
  box-sizing: border-box;
}

.identity-card {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e7dfd8;
  border-radius: 0;
  background: #f6f6f4;
  box-shadow: none;
}

.identity-card__avatar {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-sizing: border-box;
  background: #e5e5dd;
  box-shadow: none;
}

.identity-card__avatar--placeholder {
  color: #6b7651;
  font-family: Georgia, serif;
  font-size: 32rpx;
  font-weight: 600;
}

.identity-card__copy {
  min-width: 0;
  flex: 1 1 auto;
  margin-left: 18rpx;
}

.identity-card__name,
.identity-card__description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-card__name {
  color: #2c302a;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.identity-card__description {
  margin-top: 7rpx;
  color: #84847d;
  font-size: 24rpx;
}

.identity-card__arrow {
  width: 13rpx;
  height: 13rpx;
  flex: 0 0 13rpx;
  margin: 0 10rpx 0 14rpx;
  border-top: 2rpx solid #8d8d88;
  border-right: 2rpx solid #8d8d88;
  transform: rotate(45deg);
}

.section-card,
.merchant-card,
.service-card {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #dfe2dd;
  background: #ffffff;
}

.section-card__head {
  display: flex;
  min-height: 106rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e8eae7;
}

.section-card__title {
  color: #222420;
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.section-card__arrow {
  width: 15rpx;
  height: 15rpx;
  border-top: 2rpx solid #8d8d88;
  border-right: 2rpx solid #8d8d88;
  transform: rotate(45deg);
}

.section-card__arrow--muted {
  margin-left: 12rpx;
  border-color: #a8aba5;
}

.order-grid {
  display: flex;
  width: 100%;
  align-items: flex-start;
  justify-content: space-between;
  padding: 34rpx 10rpx 38rpx;
  box-sizing: border-box;
}

.order-entry {
  display: flex;
  width: 20%;
  min-width: 0;
  flex: 0 0 20%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.order-entry__icon-wrap {
  position: relative;
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
}

.order-entry__icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
  filter: grayscale(1) brightness(0.48);
}

.order-entry__badge,
.service-entry__badge {
  position: absolute;
  z-index: 2;
  display: flex;
  min-width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  padding: 0 7rpx;
  box-sizing: border-box;
  border: 3rpx solid #ffffff;
  border-radius: 999rpx;
  background: #6f7d58;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.order-entry__badge {
  top: -2rpx;
  right: -1rpx;
}

.order-entry__label {
  display: block;
  max-width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: #6e716c;
  font-size: 24rpx;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-card {
  display: flex;
  min-height: 150rpx;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx 30rpx;
}

.merchant-card__logo-shell {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #e9e4dc;
}

.merchant-card__logo {
  display: block;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}

.merchant-card__copy {
  min-width: 0;
  flex: 1 1 auto;
  margin-left: 25rpx;
}

.merchant-card__title,
.merchant-card__sub {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-card__title {
  color: #30322f;
  font-size: 28rpx;
  font-weight: 550;
}

.merchant-card__sub {
  margin-top: 8rpx;
  color: #989b95;
  font-size: 22rpx;
}

.merchant-card__action {
  flex: 0 0 auto;
  margin-left: 18rpx;
  color: #4e514c;
  font-size: 28rpx;
  white-space: nowrap;
}

.service-card {
  margin-top: 20rpx;
  padding: 16rpx 4rpx 26rpx;
}

.service-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
}

.service-entry {
  position: relative;
  display: flex;
  width: 33.333%;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 35rpx 8rpx 30rpx;
  box-sizing: border-box;
}

.service-entry__icon-wrap {
  position: relative;
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
}

.service-entry__icon {
  display: block;
  width: 51rpx;
  height: 51rpx;
  filter: grayscale(1) brightness(0.48);
}

.service-entry__badge {
  top: -3rpx;
  right: -4rpx;
}

.service-entry__label {
  display: block;
  max-width: 100%;
  margin-top: 13rpx;
  overflow: hidden;
  color: #474a45;
  font-size: 26rpx;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-entry__contact-hit {
  position: absolute;
  z-index: 5;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  opacity: 0;
}

.service-entry__contact-hit::after {
  border: 0;
}

.profile-slogan {
  display: block;
  padding: 31rpx 0 5rpx;
  color: #a7aaa4;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  text-align: center;
}

.profile-bottom-space {
  height: calc(116rpx + env(safe-area-inset-bottom));
}

.wechat-modal {
  position: fixed;
  z-index: 9999;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  box-sizing: border-box;
  background: rgba(19, 20, 18, 0.58);
}

.wechat-modal__panel {
  width: 100%;
  max-width: 610rpx;
  padding: 34rpx 34rpx 31rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: none;
}

.wechat-modal__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.wechat-modal__eyebrow,
.wechat-modal__title,
.wechat-modal__merchant-name,
.wechat-modal__merchant-wechat,
.wechat-modal__hint {
  display: block;
}

.wechat-modal__eyebrow {
  color: #8d8d88;
  font-family: Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.wechat-modal__title {
  margin-top: 9rpx;
  color: #20221f;
  font-size: 30rpx;
  font-weight: 650;
}

.wechat-modal__close {
  position: relative;
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 50rpx;
}

.wechat-modal__close-line {
  position: absolute;
  top: 24rpx;
  left: 9rpx;
  width: 32rpx;
  height: 2rpx;
  background: #565a54;
}

.wechat-modal__close-line--one {
  transform: rotate(45deg);
}

.wechat-modal__close-line--two {
  transform: rotate(-45deg);
}

.wechat-modal__merchant {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 18rpx 20rpx;
  background: #f6f6f4;
}

.wechat-modal__merchant-logo {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 50%;
}

.wechat-modal__merchant-copy {
  min-width: 0;
  margin-left: 18rpx;
}

.wechat-modal__merchant-name {
  overflow: hidden;
  color: #333630;
  font-size: 28rpx;
  font-weight: 550;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wechat-modal__merchant-wechat {
  margin-top: 7rpx;
  overflow: hidden;
  color: #858a81;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wechat-modal__qr-shell {
  display: flex;
  width: 390rpx;
  height: 390rpx;
  align-items: center;
  justify-content: center;
  margin: 30rpx auto 0;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3e5e1;
  background: #ffffff;
}

.wechat-modal__qr {
  width: 100%;
  height: 100%;
}

.wechat-modal__qr-empty {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f7f5;
  color: #91958e;
  font-size: 24rpx;
}

.wechat-modal__qr-empty image {
  width: 180rpx;
  margin-bottom: 22rpx;
  opacity: 0.7;
}

.wechat-modal__hint {
  margin-top: 20rpx;
  color: #92968f;
  font-size: 22rpx;
  text-align: center;
}

.wechat-modal__copy {
  display: flex;
  width: 100%;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin-top: 25rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: #1f211e;
  color: #ffffff;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.wechat-modal__copy::after {
  border: 0;
}

.profile-page--wide .profile-content {
  max-width: 1120rpx;
  margin: 0 auto;
}

.profile-page--compact .section-card__head {
  min-height: 94rpx;
  padding: 0 25rpx;
}

.profile-page--compact .order-grid {
  padding-right: 4rpx;
  padding-left: 4rpx;
}

.profile-page--compact .order-entry__icon-wrap,
.profile-page--compact .service-entry__icon-wrap {
  width: 61rpx;
  height: 61rpx;
}

.profile-page--compact .order-entry__icon,
.profile-page--compact .service-entry__icon {
  width: 45rpx;
  height: 45rpx;
}

.profile-page--compact .order-entry__label,
.profile-page--compact .service-entry__label {
  font-size: 22rpx;
}

.profile-page--compact .merchant-card {
  padding-right: 23rpx;
  padding-left: 23rpx;
}

.profile-page--compact .merchant-card__action {
  font-size: 26rpx;
}

.profile-page--compact .wechat-modal__qr-shell {
  width: 330rpx;
  height: 330rpx;
}

/* V6.14 unified luxury-neutral visual layer */
.profile-page { background:#f7f7f5; }
.identity-card { border:1rpx solid #eeeeeb; border-radius:0; background:#fff; box-shadow:none; }
.identity-card__avatar,.identity-card__avatar--placeholder { border:1rpx solid #eeeeeb; background:#f3f3f1; color:#171717; }
.identity-card__name { color:#171717; font-family:inherit; font-weight:650; }
.identity-card__description { color:#777772; }
.section-card,.merchant-card,.service-card { border:1rpx solid #eeeeeb; border-radius:0; background:#fff; box-shadow:none; }
.section-card__head { border-bottom:1rpx solid #eeeeeb; }
.section-card__title,.merchant-card__title { color:#171717; font-family:inherit; font-weight:650; }
.order-entry__icon-wrap,.service-entry__icon-wrap,.merchant-card__logo-shell { border-radius:50%; background:#f6f6f4; }
.order-entry__icon,.service-entry__icon,.merchant-card__logo { filter:grayscale(1) contrast(1.15); }
.order-entry__badge,.service-entry__badge { border:2rpx solid #fff; background:#111; color:#fff; }
.merchant-card__action { color:#111; font-weight:650; }
.profile-slogan { color:#8d8d88; }
.wechat-modal { background:rgba(0,0,0,.48); }
.wechat-modal__panel { border-radius:0; background:#fff; box-shadow:none; }
.wechat-modal__eyebrow { color:#777772; }
.wechat-modal__title { color:#171717; font-family:inherit; font-weight:650; }
.wechat-modal__merchant-logo,.wechat-modal__qr-shell { border:1rpx solid #eeeeeb; background:#f6f6f4; }
.wechat-modal__copy { border:2rpx solid #111; border-radius:999rpx; background:#111; color:#fff; }
