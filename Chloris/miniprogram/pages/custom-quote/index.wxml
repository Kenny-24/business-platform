<view class="safe-page quote-page">
  <app-nav title="图片定制报价" showBack solid></app-nav>

  <view class="quote-intro">
    <text class="quote-intro__eyebrow">UPLOAD YOUR INSPIRATION</text>
    <text class="quote-intro__title">上传你喜欢的图片</text>
  </view>

  <view class="quote-card">
    <text class="quote-card__title">1. 上传参考图</text>
    <view class="quote-grid">
      <view wx:for="{{imagePaths}}" wx:key="*this" class="quote-image-card">
        <image class="quote-image-card__image" src="{{item}}" mode="aspectFill"></image>
        <view class="quote-image-card__remove" data-index="{{index}}" bindtap="removeImage">×</view>
      </view>
      <view wx:if="{{imagePaths.length < 4}}" class="quote-add" bindtap="chooseImages" role="button">
        <text class="quote-add__plus">＋</text>
        <text class="quote-add__text">添加图片</text>
      </view>
    </view>
    <text class="quote-card__hint">最多上传 4 张图片。支持花束、桌花、空间软装等参考图。</text>
  </view>

  <view class="quote-card">
    <text class="quote-card__title">2. 留下可联系信息</text>
    <text class="quote-contact-note">联系人和手机号为必填项，将与当前用户账号及本次需求一起保存，方便商户后续确认报价。</text>
    <input class="quote-input" data-field="contactName" value="{{contactName}}" maxlength="24" placeholder="联系人" bindinput="updateField" />
    <input class="quote-input" data-field="contactPhone" value="{{contactPhone}}" type="number" maxlength="11" placeholder="联系电话" bindinput="updateField" />
    <textarea class="quote-textarea" data-field="message" value="{{message}}" maxlength="300" auto-height placeholder="例如：预算、喜欢的色系、送达时间、是否需要类似包装等" bindinput="updateField"></textarea>
  </view>

  <view class="quote-notice">
    <text class="quote-notice__title">商户处理流程</text>
    <text class="quote-notice__line">① 提交图片与联系方式</text>
    <text class="quote-notice__line">② 商户查看并确认是否可做</text>
    <text class="quote-notice__line">③ 通过预留手机号或客服渠道回复报价</text>
  </view>

  <view class="quote-bottom-space"></view>

  <view class="quote-fixed-bar">
    <view class="quote-fixed-bar__inner">
      <view class="quote-submit {{submitting ? 'quote-submit--disabled' : ''}}" bindtap="submit" role="button">
        {{submitting ? '提交中…' : '提交定制需求'}}
      </view>
    </view>
  </view>
</view>
