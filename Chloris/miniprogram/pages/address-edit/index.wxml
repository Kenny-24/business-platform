<view class="safe-page edit-page {{wideLayout ? 'edit-page--wide' : ''}} {{compactLayout ? 'edit-page--compact' : ''}}">
  <app-nav title="{{id ? '编辑地址' : '新增地址'}}" showBack solid></app-nav>

  <scroll-view class="edit-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="edit-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <flower-loader wx:if="{{loading}}" compact text="正在准备地址信息…"></flower-loader>

      <view wx:else class="edit-card">
        <view class="form-row">
          <text class="form-row__label">收货人</text>
          <input class="form-row__input" value="{{form.receiverName}}" placeholder="姓名" maxlength="20" data-field="receiverName" bindinput="updateField" />
        </view>

        <view class="form-row">
          <text class="form-row__label">手机号</text>
          <input class="form-row__input" type="number" value="{{form.phone}}" placeholder="11位手机号" maxlength="11" data-field="phone" bindinput="updateField" />
        </view>

        <picker mode="region" value="{{[form.province, form.city, form.district]}}" bindchange="chooseRegion">
          <view class="form-row form-row--interactive">
            <text class="form-row__label">所在地区</text>
            <view class="form-row__end">
              <text class="form-row__value {{form.province ? '' : 'is-placeholder'}}">{{regionText}}</text>
              <view class="form-row__chevron"></view>
            </view>
          </view>
        </picker>

        <view class="form-row form-row--interactive" bindtap="chooseMapLocation" role="button">
          <view class="form-row__copy">
            <text class="form-row__label">地图定位</text>
            <text class="form-row__description">选择小区、写字楼或门店位置</text>
          </view>
          <view class="form-row__end form-row__end--location">
            <text class="form-row__value {{form.locationName || form.locationAddress ? '' : 'is-placeholder'}}">{{locationText}}</text>
            <view class="form-row__chevron"></view>
          </view>
        </view>

        <view class="form-row form-row--textarea">
          <text class="form-row__label">详细地址</text>
          <textarea class="form-row__textarea" value="{{form.detail}}" placeholder="街道、门牌号、小区、楼栋等" maxlength="100" auto-height data-field="detail" bindinput="updateField"></textarea>
        </view>

        <view class="form-section">
          <text class="form-section__title">地址标签</text>
          <view class="label-options">
            <view wx:for="{{['家', '公司', '学校', '其他']}}" wx:key="*this" class="label-option {{form.label === item ? 'label-option--active' : ''}}" data-label="{{item}}" bindtap="chooseLabel" role="button">{{item}}</view>
          </view>
        </view>

        <view class="form-row">
          <view class="form-row__copy">
            <text class="form-row__label">设为默认地址</text>
            <text class="form-row__description">下单时优先使用</text>
          </view>
          <switch checked="{{form.isDefault}}" color="#6f8050" bindchange="toggleDefault" />
        </view>
      </view>

      <view class="edit-bottom-space"></view>
    </view>
  </scroll-view>

  <view class="edit-fixed-bar">
    <view class="edit-submit {{saving ? 'edit-submit--disabled' : ''}}" bindtap="submit" role="button">{{saving ? '保存中…' : '保存地址'}}</view>
  </view>
</view>
