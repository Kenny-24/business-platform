<view class="safe-page confirm-page {{wideLayout ? 'confirm-page--wide' : ''}} {{compactLayout ? 'confirm-page--compact' : ''}}">
  <app-nav title="订单结算" showBack solid></app-nav>
  <scroll-view class="confirm-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="confirm-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <flower-loader wx:if="{{loading}}" compact text="正在核对订单信息…"></flower-loader>
      <block wx:elif="{{preview}}">
        <view class="confirm-section fulfillment-section">
          <view class="section-heading"><text class="section-heading__title">配送方式</text><text class="section-heading__hint">请选择一种方式</text></view>
          <view class="fulfillment-options">
            <view wx:for="{{options.deliveryMethods}}" wx:key="id" class="fulfillment-option" data-id="{{item.id}}" bindtap="selectDeliveryMethod">
              <view class="choice-box {{deliveryMethodId === item.id ? 'choice-box--active' : ''}}"><text wx:if="{{deliveryMethodId === item.id}}">✓</text></view>
              <view><text class="fulfillment-option__name">{{item.name}}</text><text class="fulfillment-option__description">{{item.description}}</text></view>
            </view>
          </view>
        </view>

        <view wx:if="{{deliveryMethodId === 'delivery'}}" class="confirm-row confirm-row--address" bindtap="chooseAddress">
          <view class="row-icon">⌂</view>
          <view class="confirm-row__copy" wx:if="{{address}}"><text class="confirm-row__title">{{address.receiverName}} · {{address.phoneMasked || address.phone}}</text><text class="confirm-row__sub">{{address.fullAddress}}</text></view>
          <view class="confirm-row__copy" wx:else><text class="confirm-row__title">添加收货地址</text><text class="confirm-row__sub">用于配送鲜花与联系收货人</text></view>
          <view class="chevron"></view>
        </view>

        <view wx:else class="confirm-row confirm-row--address" bindtap="choosePickupLocation">
          <view class="row-icon">店</view>
          <view class="confirm-row__copy"><text class="confirm-row__title">{{pickupLocation ? pickupLocation.name : '选择自提门店'}}</text><text class="confirm-row__sub">{{pickupLocation ? pickupLocation.address : '查看门店地址与营业时间'}}</text><text wx:if="{{pickupLocation}}" class="confirm-row__meta">{{pickupLocation.businessHours}}</text></view>
          <view class="chevron"></view>
        </view>

        <view class="confirm-row" bindtap="openDeliveryTimePicker">
          <view class="row-icon">时</view>
          <view class="confirm-row__copy"><text class="confirm-row__title">{{deliveryMethodId === 'pickup' ? '预约自提时间' : '预期送达时间'}}</text><text class="confirm-row__sub">{{deliveryTimeText}}</text></view>
          <view class="chevron"></view>
        </view>

        <view class="confirm-section product-section">
          <view class="section-heading"><text class="section-heading__title">商品信息</text><text class="section-heading__hint">共 {{preview.items.length}} 种商品</text></view>
          <view wx:for="{{preview.items}}" wx:key="productId" class="product-row">
            <image wx:if="{{item.imageUrl}}" class="product-row__image" src="{{item.imageUrl}}" mode="aspectFill"></image>
            <view wx:else class="product-row__image product-row__placeholder">CHLORIS</view>
            <view class="product-row__copy"><text class="product-row__name">{{item.name}}</text><text class="product-row__price">¥{{item.unitPriceText}} / {{item.unit}}</text></view>
            <view class="product-row__right"><text>× {{item.quantity}}</text><text class="product-row__subtotal">¥{{item.subtotalText}}</text></view>
          </view>
        </view>

        <view class="confirm-section message-section">
          <view class="section-heading"><text class="section-heading__title">贺卡与留言</text><text class="section-heading__hint">选填</text></view>
          <view class="message-field"><view class="message-field__head"><text>贺卡内容</text><text>{{cardMessage.length}}/120</text></view><textarea class="message-field__input" value="{{cardMessage}}" maxlength="120" auto-height placeholder="写下想对收花人说的话" bindinput="updateCardMessage"></textarea></view>
          <view class="message-field"><view class="message-field__head"><text>买家留言</text><text>{{buyerMessage.length}}/200</text></view><textarea class="message-field__input message-field__input--buyer" value="{{buyerMessage}}" maxlength="200" auto-height placeholder="颜色偏好、花材替换或其他要求" bindinput="updateBuyerMessage"></textarea></view>
        </view>

        <view class="confirm-section amount-section">
          <view class="section-heading"><text class="section-heading__title">费用明细</text></view>
          <view class="amount-row"><text>商品金额</text><text>¥{{preview.amounts.goodsAmountText}}</text></view>
          <view class="amount-row"><text>{{deliveryMethodId === 'pickup' ? '自提费用' : '配送费用'}}</text><text>{{deliveryMethodId === 'pickup' ? '无需配送费' : (preview.amounts.deliveryFeeFen > 0 ? '¥' + preview.amounts.deliveryFeeText : '按地址核算')}}</text></view>
        </view>

        <view class="confirm-notice">{{deliveryMethodId === 'pickup' ? '付款后，工作室将按预约时间准备商品；到店时请出示订单号。' : '提交后将创建待付款订单，并按所选时间安排配送。'}}</view>
        <view class="confirm-bottom-space"></view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{preview}}" class="confirm-fixed-bar"><view class="confirm-total"><text class="confirm-total__label">订单金额</text><text class="confirm-total__currency">¥</text><text class="confirm-total__amount">{{preview.amounts.totalAmountText}}</text></view><view class="confirm-submit {{submitting ? 'confirm-submit--disabled' : ''}}" bindtap="submitOrder">{{submitting ? '处理中…' : '提交订单'}}</view></view>

  <view wx:if="{{deliveryPickerVisible}}" class="delivery-time-mask" bindtap="closeDeliveryTimePicker"><view class="delivery-time-sheet" catchtap="stopDeliveryPickerTap"><view class="delivery-time-sheet__head"><text class="delivery-time-sheet__title">{{deliveryMethodId === 'pickup' ? '选择自提时间' : '选择配送时间'}}</text><view class="delivery-time-sheet__close" bindtap="closeDeliveryTimePicker"></view></view><view class="delivery-time-columns"><scroll-view class="delivery-time-column delivery-time-column--dates" scroll-y enhanced show-scrollbar="{{false}}"><view wx:for="{{deliveryPickerDates}}" wx:key="value" class="delivery-date-option {{item.selected ? 'delivery-date-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectPickerDate"><text>{{item.label}}</text></view></scroll-view><scroll-view class="delivery-time-column delivery-time-column--slots" scroll-y enhanced show-scrollbar="{{false}}"><view wx:for="{{deliveryPickerSlots}}" wx:key="value" class="delivery-slot-option {{item.selected ? 'delivery-slot-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectPickerSlot"><text>{{item.value}}</text><view wx:if="{{item.selected}}" class="delivery-slot-option__check">✓</view></view></scroll-view></view><view class="delivery-time-confirm" bindtap="confirmDeliveryTimePicker">完成</view></view></view>
</view>
