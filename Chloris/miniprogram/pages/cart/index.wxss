.cart-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fafbf8;
}

.cart-scroll {
  width: 100%;
  overflow: hidden;
}

.cart-content {
  width: 100%;
  min-height: 100%;
  padding-top: 12rpx;
}

.cart-head {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
}

.cart-head__copy {
  flex: 1 1 auto;
  min-width: 0;
}

.cart-head__title,
.cart-head__status {
  display: block;
}

.cart-head__title {
  color: #292d27;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
}

.cart-head__status {
  margin-top: 5rpx;
  color: #969c93;
  font-size: 16rpx;
  line-height: 1.3;
}

.cart-head__edit {
  flex: 0 0 auto;
  padding: 16rpx 0 16rpx 24rpx;
  color: #617148;
  font-size: 19rpx;
}

.cart-assurance {
  padding: 20rpx 21rpx;
  border: 1rpx solid #e4e8df;
  border-radius: 18rpx;
  background: #f2f5ee;
}

.cart-assurance__title,
.cart-assurance__body {
  display: block;
}

.cart-assurance__title {
  color: #52603f;
  font-size: 19rpx;
  font-weight: 600;
}

.cart-assurance__body {
  margin-top: 7rpx;
  color: #727a69;
  font-size: 16rpx;
  line-height: 1.65;
}

.cart-layout,
.cart-products,
.cart-side {
  width: 100%;
  min-width: 0;
}

.cart-products {
  margin-top: 14rpx;
  overflow: hidden;
  border: 1rpx solid #e6e9e2;
  border-radius: 20rpx;
  background: #ffffff;
}

.cart-product {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  padding: 20rpx 17rpx;
  border-bottom: 1rpx solid #e8ebe5;
}

.cart-product:last-child {
  border-bottom: 0;
}

.cart-product--invalid {
  opacity: 0.55;
}

.cart-product__select {
  display: flex;
  width: 46rpx;
  flex: 0 0 46rpx;
  align-items: center;
  justify-content: flex-start;
}

.select-dot {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #bcc3b8;
  border-radius: 50%;
  background: #ffffff;
  color: #ffffff;
  font-size: 17rpx;
  line-height: 1;
}

.select-dot--active {
  border-color: #6f8050;
  background: #6f8050;
}

.select-dot--disabled {
  border-color: #d8dcd5;
  background: #edf0eb;
}

.cart-product__image {
  display: block;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 15rpx;
  background: #eef1eb;
}

.cart-product__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #697951;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.cart-product__info {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 16rpx;
}

.cart-product__title-row,
.cart-product__price-row,
.cart-product__action-row,
.cart-product__subtotal {
  display: flex;
  min-width: 0;
  align-items: center;
}

.cart-product__name {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #292d27;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-product__delete {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #9d7163;
  font-size: 16rpx;
}

.cart-product__price-row {
  align-items: baseline;
  margin-top: 7rpx;
}

.cart-product__price {
  color: #68764b;
  font-size: 20rpx;
  font-weight: 600;
}

.cart-product__unit {
  margin-left: 3rpx;
  color: #91968e;
  font-size: 16rpx;
}

.cart-product__updated {
  flex: 0 0 auto;
  margin-left: 8rpx;
  padding: 3rpx 8rpx;
  border-radius: 7rpx;
  background: #f3ece7;
  color: #a16e5a;
  font-size: 13rpx;
}

.cart-product__message {
  display: block;
  margin-top: 6rpx;
  color: #ab735e;
  font-size: 15rpx;
  line-height: 1.3;
}

.cart-product__message--invalid {
  color: #956f65;
}

.cart-product__action-row {
  justify-content: space-between;
  margin-top: 14rpx;
}

.cart-product__subtotal {
  align-items: baseline;
}

.cart-product__subtotal-label {
  color: #9aa097;
  font-size: 14rpx;
}

.cart-product__subtotal-value {
  margin-left: 6rpx;
  color: #53633e;
  font-size: 21rpx;
  font-weight: 700;
}

.stepper {
  display: flex;
  height: 42rpx;
  flex: 0 0 auto;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #dfe3dc;
  border-radius: 999rpx;
  background: #ffffff;
}

.stepper__button,
.stepper__number {
  display: flex;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.stepper__button {
  width: 43rpx;
  color: #52584f;
  font-size: 21rpx;
}

.stepper__number {
  width: 42rpx;
  border-right: 1rpx solid #ecefe9;
  border-left: 1rpx solid #ecefe9;
  color: #30342e;
  font-size: 17rpx;
}

.cart-card {
  width: 100%;
  margin-top: 17rpx;
  overflow: hidden;
  border: 1rpx solid #e5e9e2;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 22rpx rgba(50, 55, 46, 0.035);
}

.option-item {
  display: flex;
  min-height: 90rpx;
  align-items: center;
  justify-content: space-between;
  padding: 17rpx 20rpx;
  border-bottom: 1rpx solid #ecefe9;
}

.option-item:last-child {
  border-bottom: 0;
}

.option-item__copy {
  flex: 1 1 auto;
  min-width: 0;
}

.option-item__title,
.option-item__description {
  display: block;
}

.option-item__title {
  color: #30342e;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.3;
}

.option-item__description {
  margin-top: 5rpx;
  overflow: hidden;
  color: #969c93;
  font-size: 15rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-item__right {
  display: flex;
  max-width: 48%;
  flex: 0 0 auto;
  align-items: center;
  margin-left: 14rpx;
}

.option-item__value {
  overflow: hidden;
  color: #676d64;
  font-size: 17rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-item__fee {
  flex: 0 0 auto;
  margin-left: 7rpx;
  color: #5b6a43;
  font-size: 16rpx;
}

.option-item__arrow {
  width: 27rpx;
  height: 27rpx;
  flex: 0 0 27rpx;
  margin-left: 7rpx;
  opacity: 0.46;
}

.packaging-scroll {
  width: 100%;
  margin-top: 17rpx;
  white-space: nowrap;
}

.packaging-gallery {
  display: inline-flex;
  align-items: stretch;
  gap: 14rpx;
  padding: 2rpx 2rpx 6rpx;
}

.packaging-card {
  display: inline-flex;
  width: 204rpx;
  flex: 0 0 204rpx;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 18rpx;
  background: transparent;
  vertical-align: top;
  transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
}

.packaging-card--active {
  border-color: rgba(111, 125, 85, 0.55);
  box-shadow: 0 7rpx 18rpx rgba(91, 106, 67, 0.08);
  transform: translateY(-1rpx);
}

.packaging-card__image {
  display: block;
  width: 100%;
  height: 140rpx;
  border-radius: 17rpx;
  background: transparent;
}

.packaging-card__body {
  min-height: 112rpx;
  padding: 12rpx 10rpx 10rpx;
  box-sizing: border-box;
  background: transparent;
  white-space: normal;
}

.packaging-card__title-row {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.packaging-card__name,
.packaging-card__desc,
.packaging-card__fee {
  display: block;
}

.packaging-card__name {
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
  color: #2f332d;
  font-size: 18rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.packaging-card__fee {
  flex: 0 0 auto;
  color: #5b6a43;
  font-size: 15rpx;
  white-space: nowrap;
}

.packaging-card__desc {
  min-height: 42rpx;
  margin-top: 7rpx;
  overflow: hidden;
  color: #8f958d;
  font-size: 14rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.fee-card {
  padding: 21rpx;
}

.fee-card__title {
  display: block;
  margin-bottom: 16rpx;
  color: #30342e;
  font-size: 20rpx;
  font-weight: 600;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #777d74;
  font-size: 17rpx;
}

.fee-row--total {
  color: #2f352d;
  font-size: 20rpx;
  font-weight: 600;
}

.fee-line {
  height: 1rpx;
  margin: 17rpx 0 3rpx;
  background: #ecefe9;
}

.cart-aftercare {
  margin-top: 15rpx;
  padding: 19rpx 20rpx;
  border-radius: 17rpx;
  background: #f7f5f0;
  color: #818078;
  font-size: 15rpx;
  line-height: 1.65;
}

.cart-bottom-space {
  height: calc(154rpx + env(safe-area-inset-bottom));
}

.cart-empty {
  display: flex;
  min-height: 70vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.cart-empty__mark {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f4ed;
  color: #68764b;
  font-family: "Songti SC", serif;
  font-size: 31rpx;
}

.cart-empty__title,
.cart-empty__description {
  display: block;
}

.cart-empty__title {
  margin-top: 20rpx;
  color: #545850;
  font-size: 23rpx;
}

.cart-empty__description {
  margin-top: 8rpx;
  color: #9aa097;
  font-size: 17rpx;
}

.cart-empty__button {
  display: flex;
  width: 202rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #6f7d55;
  color: #ffffff;
  font-size: 19rpx;
}

.checkout-bar {
  position: fixed;
  z-index: 50;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 104rpx;
  align-items: center;
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7eae4;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(48, 52, 44, 0.05);
  backdrop-filter: blur(14px);
}

.checkout-all {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.checkout-all__text {
  margin-left: 8rpx;
  color: #656b62;
  font-size: 17rpx;
}

.checkout-total {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 18rpx;
  text-align: right;
}

.checkout-total__line {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}

.checkout-total__label {
  margin-right: 8rpx;
  color: #6f746c;
  font-size: 16rpx;
}

.checkout-total__currency {
  color: #53623f;
  font-size: 16rpx;
}

.checkout-total__amount {
  color: #53623f;
  font-size: 28rpx;
  font-weight: 700;
}

.checkout-total__hint {
  display: block;
  margin-top: 3rpx;
  color: #9aa097;
  font-size: 13rpx;
}

.checkout-button {
  display: flex;
  min-width: 190rpx;
  height: 70rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #6f7d55;
  color: #ffffff;
  font-size: 20rpx;
}

.checkout-button--disabled {
  opacity: 0.42;
}

.checkout-button--delete {
  background: #aa6c62;
}

.cart-page--wide .cart-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(320px, 0.75fr);
  gap: 22rpx;
  align-items: start;
}

.cart-page--wide .cart-side {
  margin-top: 14rpx;
}

.cart-page--compact .cart-product {
  padding-right: 13rpx;
  padding-left: 13rpx;
}

.cart-page--compact .checkout-button {
  min-width: 164rpx;
  margin-left: 10rpx;
  padding: 0 18rpx;
}

.option-item__right { min-height: 44rpx; }
.option-item__arrow {
  display: block;
  width: 11rpx;
  height: 11rpx;
  flex: 0 0 11rpx;
  align-self: center;
  margin-left: 12rpx;
  border-top: 2rpx solid #92988f;
  border-right: 2rpx solid #92988f;
  opacity: 1;
  transform: rotate(45deg);
}


.option-item__title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.option-item__badge {
  display: inline-flex;
  height: 34rpx;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #edf3e7;
  color: #66764d;
  font-size: 14rpx;
  font-weight: 500;
}

.option-item__value--emphasis {
  color: #586943;
  font-weight: 600;
}
