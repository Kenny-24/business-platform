<view class="safe-page cart-page {{wideLayout ? 'cart-page--wide' : ''}} {{compactLayout ? 'cart-page--compact' : ''}}">
  <app-nav title="购物车" solid></app-nav>

  <scroll-view class="cart-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onCartRefresh">
    <view class="cart-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <block wx:if="{{cart.length}}">
        <view class="cart-head">
          <view>
            <text class="cart-head__title">购物袋</text>
            <text class="cart-head__sub">共 {{cart.length}} 件商品</text>
          </view>
          <view class="cart-head__edit" bindtap="toggleEdit" role="button">{{editing ? '完成' : '编辑'}}</view>
        </view>

        <view class="cart-list">
          <view wx:for="{{cart}}" wx:key="id" class="cart-item {{item.invalid ? 'cart-item--invalid' : ''}}">
            <view class="cart-item__select">
              <view class="select-dot {{item.selected ? 'select-dot--active' : ''}} {{item.invalid ? 'select-dot--disabled' : ''}}" data-id="{{item.id}}" bindtap="toggleItem" role="button">
                <text wx:if="{{item.selected}}">✓</text>
              </view>
            </view>

            <image wx:if="{{item.image}}" class="cart-item__image" src="{{item.image}}" mode="aspectFill" lazy-load data-id="{{item.id}}" bindtap="openProductDetail"></image>
            <view wx:else class="cart-item__image cart-item__placeholder" data-id="{{item.id}}" bindtap="openProductDetail">CHLORIS</view>

            <view class="cart-item__main">
              <view class="cart-item__top">
                <text class="cart-item__name">{{item.name}}</text>
                <view wx:if="{{editing}}" class="cart-item__delete" data-id="{{item.id}}" bindtap="removeOne">删除</view>
              </view>
              <view class="cart-item__price-line">
                <text class="cart-item__price">¥{{item.priceText}}</text>
                <text class="cart-item__unit">/{{item.unit}}</text>
              </view>
              <text wx:if="{{item.invalid}}" class="cart-item__status cart-item__status--invalid">{{item.invalidReason}}</text>
              <text wx:elif="{{item.lowStock}}" class="cart-item__status">仅剩{{item.stock}}{{item.unit}}</text>
              <view class="cart-item__bottom">
                <text class="cart-item__subtotal">小计 ¥{{item.subtotalText}}</text>
                <view class="stepper">
                  <view class="stepper__button" data-id="{{item.id}}" data-delta="-1" bindtap="changeQty">−</view>
                  <text class="stepper__number">{{item.quantity}}</text>
                  <view class="stepper__button" data-id="{{item.id}}" data-delta="1" bindtap="changeQty">＋</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="cart-bottom-space"></view>
      </block>

      <view wx:else class="cart-empty">
        <view class="cart-empty__mark">花</view>
        <text class="cart-empty__title">购物车还是空的</text>
        <text class="cart-empty__description">去挑选一份喜欢的鲜花</text>
        <view class="cart-empty__button" bindtap="goShopping">去选花</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{cart.length}}" class="checkout-bar">
    <view class="checkout-all" bindtap="toggleAll">
      <view class="select-dot {{allSelected ? 'select-dot--active' : ''}}"><text wx:if="{{allSelected}}">✓</text></view>
      <text>全选</text>
    </view>
    <view class="checkout-total">
      <view><text class="checkout-total__label">合计</text><text class="checkout-total__currency">¥</text><text class="checkout-total__amount">{{goodsTotalText}}</text></view>
      <text class="checkout-total__hint">已选 {{selectedCount}} 件</text>
    </view>
    <view class="checkout-button {{selectedCount <= 0 ? 'checkout-button--disabled' : ''}} {{editing ? 'checkout-button--delete' : ''}}" bindtap="checkout">{{editing ? '删除' : '结算'}}</view>
  </view>
</view>
