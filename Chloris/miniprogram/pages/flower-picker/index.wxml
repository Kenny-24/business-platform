<view class="safe-page picker-page">
  <app-nav title="帮我选花" showBack solid></app-nav>

  <flower-loader
    wx:if="{{loading}}"
    overlay
    text="正在查看今天可选的花…"
  ></flower-loader>

  <block wx:else>
    <view class="picker-hero">
      <text class="picker-hero__eyebrow">CHLORIS FLOWER FINDER</text>
      <text class="picker-hero__title">更简单地找到合适的花</text>
      <text class="picker-hero__sub">填写预算区间，再选择送花对象和颜色偏好，即时查看当前可售结果。</text>
    </view>

    <view class="picker-filter-card">
      <view class="picker-filter-title-row">
        <text class="picker-filter-title">筛选条件</text>
        <view class="picker-filter-reset" bindtap="resetFilters" role="button">重置</view>
      </view>

      <view class="price-input-section">
        <text class="price-input-section__label">预算区间（元）</text>
        <view class="price-input-row">
          <view class="price-input-box">
            <input
              type="digit"
              value="{{minPriceInput}}"
              placeholder="最低价"
              placeholder-class="price-input-placeholder"
              data-field="minPriceInput"
              bindinput="onPriceInput"
              bindblur="onPriceBlur"
            />
          </view>
          <text class="price-input-separator">—</text>
          <view class="price-input-box">
            <input
              type="digit"
              value="{{maxPriceInput}}"
              placeholder="最高价"
              placeholder-class="price-input-placeholder"
              data-field="maxPriceInput"
              bindinput="onPriceInput"
              bindblur="onPriceBlur"
            />
          </view>
        </view>
        <text class="price-input-section__hint">价格留空代表不限，输入后会自动更新结果。</text>
      </view>

      <view class="filter-block" wx:for="{{filterSections}}" wx:key="key">
        <text class="filter-block__title">{{item.label}}</text>
        <view class="filter-chip-list">
          <view
            wx:for="{{item.options}}"
            wx:for-item="option"
            wx:key="value"
            class="filter-chip {{item.selectedValue === option.value ? 'filter-chip--active' : ''}}"
            data-key="{{item.key}}"
            data-value="{{option.value}}"
            bindtap="selectOption"
            role="button"
          >
            {{option.label}}
          </view>
        </view>
      </view>
    </view>

    <view class="result-summary">
      <view>
        <text class="result-summary__title">为你匹配的结果</text>
        <text class="result-summary__sub">共 {{results.length}} 款当前可售商品</text>
      </view>
    </view>

    <view wx:if="{{results.length}}" class="result-grid">
      <view class="result-cell" wx:for="{{results}}" wx:key="id">
        <product-card
          item="{{item}}"
          bind:add="addProduct"
          bind:open="openProduct"
        ></product-card>
      </view>
    </view>

    <view wx:else class="result-empty">暂时没有完全匹配的商品，请调整价格、对象或颜色偏好。</view>

    <view class="result-note">
      选好商品、收货方式与预约时间后即可付款；需要替换主要花材时会先与你沟通。
    </view>

    <view class="picker-bottom-space"></view>

    <view class="result-fixed-bar">
      <view class="result-fixed-bar__inner">
        <view class="result-action result-action--light" bindtap="resetFilters" role="button">重新选择</view>
        <view class="result-action" bindtap="seeMore" role="button">查看全部花束</view>
      </view>
    </view>
  </block>
</view>
