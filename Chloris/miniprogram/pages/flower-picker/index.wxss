.picker-page {
  min-height: 100vh;
  padding-bottom: 0;
  background: var(--bg);
}

.picker-hero {
  padding: 30rpx 28rpx 20rpx;
  background: linear-gradient(180deg, #fff6f7 0%, var(--bg) 100%);
}

.picker-hero__eyebrow,
.picker-hero__title,
.picker-hero__sub {
  display: block;
}

.picker-hero__eyebrow {
  color: #b97180;
  font-family: Georgia, serif;
  font-size: 14rpx;
  letter-spacing: 3rpx;
}

.picker-hero__title {
  margin-top: 13rpx;
  color: #302d2b;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  line-height: 1.35;
}

.picker-hero__sub {
  margin-top: 11rpx;
  color: #817b76;
  font-size: 19rpx;
  line-height: 1.7;
}

.picker-filter-card {
  margin: 0 22rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: var(--shadow);
}

.picker-filter-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-filter-title {
  color: #322f2b;
  font-size: 24rpx;
  font-weight: 700;
}

.picker-filter-reset {
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f2ed;
  color: #7e7972;
  font-size: 16rpx;
}

.price-input-section {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #faf9f6;
}

.price-input-section__label,
.price-input-section__hint {
  display: block;
}

.price-input-section__label {
  color: #393530;
  font-size: 20rpx;
  font-weight: 600;
}

.price-input-row {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
}

.price-input-box {
  display: flex;
  height: 68rpx;
  flex: 1 1 0;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid #ebe7df;
  border-radius: 12rpx;
  background: #ffffff;
}

.price-input-box input {
  width: 100%;
  height: 64rpx;
  color: #332f2b;
  font-size: 20rpx;
  text-align: center;
}

.price-input-placeholder {
  color: #b3ada5;
}

.price-input-separator {
  margin: 0 14rpx;
  color: #9e9891;
  font-size: 22rpx;
}

.price-input-section__hint {
  margin-top: 12rpx;
  color: #9a948c;
  font-size: 16rpx;
  line-height: 1.55;
}

.filter-block {
  margin-top: 18rpx;
}

.filter-block__title {
  display: block;
  margin-bottom: 12rpx;
  color: #38342f;
  font-size: 20rpx;
  font-weight: 600;
}

.filter-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  display: inline-flex;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid #e6e0d8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #79746d;
  font-size: 18rpx;
}

.filter-chip--active {
  border-color: #d98899;
  background: #d98899;
  color: #ffffff;
}

.result-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 22rpx 12rpx;
}

.result-summary__title,
.result-summary__sub {
  display: block;
}

.result-summary__title {
  color: #34302c;
  font-size: 25rpx;
  font-weight: 700;
}

.result-summary__sub {
  margin-top: 6rpx;
  color: #918b84;
  font-size: 17rpx;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 0 22rpx;
}

.result-cell {
  width: calc((100% - 14rpx) / 2);
}

.result-empty {
  margin: 0 22rpx;
  padding: 34rpx 24rpx;
  border: 1rpx dashed #ddd7cf;
  border-radius: 20rpx;
  background: #ffffff;
  color: #8e8881;
  font-size: 18rpx;
  line-height: 1.75;
  text-align: center;
}

.result-note {
  margin: 18rpx 22rpx 0;
  color: #9a948c;
  font-size: 16rpx;
  line-height: 1.65;
}

.picker-bottom-space {
  height: calc(156rpx + env(safe-area-inset-bottom));
}

.result-fixed-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(74, 68, 58, 0.08);
  background: rgba(251, 250, 247, 0.98);
  box-shadow: 0 -10rpx 30rpx rgba(55, 50, 42, 0.07);
}

.result-fixed-bar__inner {
  display: flex;
  gap: 16rpx;
}

.result-action {
  display: flex;
  height: 78rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #6f8050;
  border-radius: 39rpx;
  background: #6f8050;
  color: #ffffff;
  font-size: 21rpx;
}

.result-action--light {
  background: #ffffff;
  color: #627148;
}

@media (min-width: 720px) {
  .result-grid {
    gap: 16rpx;
  }

  .result-cell {
    width: calc((100% - 32rpx) / 3);
  }
}
