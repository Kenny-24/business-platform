<view class="safe-page order-detail-page {{wideLayout ? 'order-detail-page--wide' : ''}} {{compactLayout ? 'order-detail-page--compact' : ''}}">
  <app-nav title="订单详情" showBack solid></app-nav>

  <scroll-view class="order-detail-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="order-detail-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <flower-loader wx:if="{{loading}}" compact text="正在同步订单详情…"></flower-loader>

      <block wx:elif="{{order}}">
        <view class="status-card status-card--{{order.status}}">
          <view class="status-card__topline">
            <view class="status-card__copy">
              <text class="status-card__label">{{order.statusLabel}}</text>
              <text class="status-card__description">{{order.statusDescription}}</text>
            </view>
            <view class="status-card__mark"></view>
          </view>
          <view class="status-card__meta">
            <text>订单号</text>
            <text>{{order.orderNo}}</text>
          </view>
        </view>

        <view class="order-detail-layout">
          <view class="order-detail-main">
            <view class="detail-card delivery-card">
              <view class="detail-card__header">
                <view>
                  <text class="detail-card__eyebrow">DELIVERY</text>
                  <text class="detail-card__title">配送信息</text>
                </view>
                <text class="delivery-method-chip">{{order.deliveryMethodName}}</text>
              </view>

              <view wx:if="{{order.hasDeliverySchedule}}" class="schedule-panel">
                <view class="schedule-panel__header">
                  <view class="schedule-panel__heading">
                    <text class="schedule-panel__title">配送安排</text>
                    <text class="schedule-panel__subtitle">顾客填写期望时间，商家确认后形成最终安排</text>
                  </view>
                  <text class="schedule-status schedule-status--{{order.deliveryScheduleStatus}}">{{order.deliveryScheduleStatusLabel}}</text>
                </view>

                <view class="schedule-primary">
                  <text class="schedule-primary__label">你的期望</text>
                  <text class="schedule-primary__value {{order.requestedScheduleText === '未填写' ? 'schedule-primary__value--empty' : ''}}">{{order.requestedScheduleText}}</text>
                </view>

                <view wx:if="{{order.requestedDeliveryNote}}" class="schedule-message">
                  <text class="schedule-message__label">配送备注</text>
                  <text class="schedule-message__text">{{order.requestedDeliveryNote}}</text>
                </view>

                <view wx:if="{{order.confirmedScheduleText}}" class="schedule-result schedule-result--confirmed">
                  <view class="schedule-result__icon">✓</view>
                  <view class="schedule-result__copy">
                    <text class="schedule-result__label">最终配送时间</text>
                    <text class="schedule-result__value">{{order.confirmedScheduleText}}</text>
                  </view>
                </view>

                <view wx:if="{{order.proposedScheduleText && order.deliveryScheduleStatus !== 'confirmed'}}" class="schedule-result schedule-result--proposed">
                  <view class="schedule-result__icon">!</view>
                  <view class="schedule-result__copy">
                    <text class="schedule-result__label">商家建议时间</text>
                    <text class="schedule-result__value">{{order.proposedScheduleText}}</text>
                  </view>
                </view>

                <view wx:if="{{order.deliveryAdjustmentNote}}" class="schedule-message schedule-message--adjustment">
                  <text class="schedule-message__label">调整说明</text>
                  <text class="schedule-message__text">{{order.deliveryAdjustmentNote}}</text>
                </view>

                <view class="schedule-help">
                  <view class="schedule-help__dot"></view>
                  <text>{{order.deliveryScheduleStatusDescription}}</text>
                </view>
              </view>

              <view wx:else class="delivery-simple-row">
                <text class="delivery-simple-row__label">日期时间</text>
                <text class="delivery-simple-row__value">{{order.deliveryScheduleText}}</text>
              </view>

              <view wx:if="{{order.address}}" class="address-panel">
                <view class="address-panel__icon">⌖</view>
                <view class="address-panel__content">
                  <view class="address-panel__person">
                    <text>{{order.address.receiverName}}</text>
                    <text>{{order.address.phoneMasked}}</text>
                  </view>
                  <text class="address-panel__full">{{order.address.fullAddress}}</text>
                </view>
              </view>
            </view>

            <view wx:if="{{order.hasLogistics}}" class="detail-card logistics-card">
              <view class="detail-card__header logistics-card__header">
                <view>
                  <text class="detail-card__eyebrow">LOGISTICS</text>
                  <text class="detail-card__title">快递物流</text>
                  <text class="logistics-card__state">{{order.logisticsStateLabel || '等待物流更新'}}</text>
                </view>
                <view class="text-action" bindtap="refreshCurrentLogistics" role="button">{{logisticsRefreshing ? '查询中…' : '刷新物流'}}</view>
              </view>

              <view class="logistics-summary">
                <view>
                  <text class="logistics-company">{{order.logisticsCompanyName}}</text>
                  <text class="logistics-number">{{order.trackingNo}}</text>
                </view>
                <view class="outline-action" bindtap="copyTrackingNo" role="button">复制单号</view>
              </view>

              <text wx:if="{{order.logisticsUpdatedAtText}}" class="logistics-updated">最近更新：{{order.logisticsUpdatedAtText}}</text>

              <view wx:if="{{order.logisticsTrace.length}}" class="logistics-trace">
                <view wx:for="{{order.logisticsTrace}}" wx:key="id" class="logistics-trace__item">
                  <view class="logistics-trace__rail">
                    <view class="logistics-trace__dot"></view>
                    <view wx:if="{{index < order.logisticsTrace.length - 1}}" class="logistics-trace__line"></view>
                  </view>
                  <view class="logistics-trace__copy">
                    <text class="logistics-trace__context">{{item.context}}</text>
                    <text class="logistics-trace__time">{{item.displayTime}}</text>
                  </view>
                </view>
              </view>
              <view wx:else class="logistics-empty">运单已录入，暂未查询到物流轨迹。</view>
            </view>

            <view class="detail-card product-card">
              <view class="detail-card__header">
                <view>
                  <text class="detail-card__eyebrow">ITEMS</text>
                  <text class="detail-card__title">商品清单</text>
                </view>
                <text class="detail-card__count">共 {{order.items.length}} 件</text>
              </view>

              <view wx:for="{{order.items}}" wx:key="productId" class="detail-product">
                <image wx:if="{{item.imageUrl}}" class="detail-product__image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
                <view wx:else class="detail-product__image detail-product__placeholder">CHLORIS</view>
                <view class="detail-product__copy">
                  <text class="detail-product__name">{{item.name}}</text>
                  <text class="detail-product__price">¥{{item.unitPriceText}} / {{item.unit}}</text>
                </view>
                <view class="detail-product__right">
                  <text>× {{item.quantity}}</text>
                  <text>¥{{item.subtotalText}}</text>
                </view>
              </view>
            </view>

            <view wx:if="{{order.cardMessage || order.buyerMessage || order.merchantNote}}" class="detail-card message-detail-card">
              <view class="detail-card__header">
                <view>
                  <text class="detail-card__eyebrow">MESSAGE</text>
                  <text class="detail-card__title">订单留言</text>
                </view>
              </view>
              <view wx:if="{{order.cardMessage}}" class="message-detail"><text>贺卡内容</text><text>{{order.cardMessage}}</text></view>
              <view wx:if="{{order.buyerMessage}}" class="message-detail"><text>买家留言</text><text>{{order.buyerMessage}}</text></view>
              <view wx:if="{{order.merchantNote}}" class="message-detail"><text>商家备注</text><text>{{order.merchantNote}}</text></view>
            </view>
          </view>

          <view class="order-detail-side">
            <view class="detail-card amount-detail-card">
              <view class="detail-card__header">
                <view>
                  <text class="detail-card__eyebrow">AMOUNT</text>
                  <text class="detail-card__title">费用明细</text>
                </view>
              </view>
              <view class="detail-row"><text>商品金额</text><text>¥{{order.amounts.goodsAmountText}}</text></view>
              <view class="detail-row"><text>包装费用</text><text>¥{{order.amounts.packagingFeeText}}</text></view>
              <view class="detail-row"><text>配送费用</text><text>{{order.amounts.deliveryFeeText === '待确认' ? '待确认' : '¥' + order.amounts.deliveryFeeText}}</text></view>
              <view class="detail-row"><text>优惠金额</text><text>− ¥{{order.amounts.discountText}}</text></view>
              <view class="detail-line"></view>
              <view class="detail-row detail-row--total"><text>应付金额</text><text>¥{{order.amounts.totalAmountText}}</text></view>
            </view>

            <view class="detail-card timeline-card">
              <view class="detail-card__header">
                <view>
                  <text class="detail-card__eyebrow">PROGRESS</text>
                  <text class="detail-card__title">订单进度</text>
                </view>
              </view>
              <view wx:for="{{order.logs}}" wx:key="_id" class="timeline-item">
                <view class="timeline-item__dot"></view>
                <view class="timeline-item__copy">
                  <text class="timeline-item__title">{{item.title}}</text>
                  <text wx:if="{{item.note}}" class="timeline-item__note">{{item.note}}</text>
                  <text class="timeline-item__time">{{item.createdAtText}}</text>
                </view>
              </view>
            </view>

            <view class="detail-card info-card">
              <view class="detail-card__header">
                <view>
                  <text class="detail-card__eyebrow">ORDER INFO</text>
                  <text class="detail-card__title">订单信息</text>
                </view>
              </view>
              <view class="detail-row"><text>下单时间</text><text>{{order.createdAtText}}</text></view>
              <view class="detail-row"><text>包装方式</text><text>{{order.packagingName}}</text></view>
              <view class="detail-row"><text>支付状态</text><text>{{order.paymentStatus === 'offlinePaid' ? '已确认收款' : '未付款'}}</text></view>
              <view class="info-card__bottom"></view>
            </view>
          </view>
        </view>

        <view class="order-detail-bottom-space"></view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{order && order.canRespondDeliverySchedule}}" class="order-detail-fixed-bar">
    <view class="detail-secondary-button" bindtap="rejectDeliverySchedule" role="button">{{scheduleSubmitting ? '处理中…' : '暂不接受'}}</view>
    <view class="detail-primary-button" bindtap="acceptDeliverySchedule" role="button">{{scheduleSubmitting ? '处理中…' : '确认时间'}}</view>
  </view>

  <view wx:elif="{{order && (order.canCancel || order.canPay)}}" class="order-detail-fixed-bar">
    <view wx:if="{{order.canCancel}}" class="detail-secondary-button" bindtap="cancelOrder" role="button">{{cancelling ? '取消中…' : '取消订单'}}</view>
    <view wx:if="{{order.canPay}}" class="detail-primary-button" bindtap="payOrder" role="button">去付款</view>
  </view>
</view>
