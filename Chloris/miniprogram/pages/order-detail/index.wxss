.order-detail-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #f7f8f4;
}

.order-detail-scroll,
.order-detail-content,
.order-detail-layout,
.order-detail-main,
.order-detail-side {
  width: 100%;
  min-width: 0;
}

.order-detail-content {
  min-height: 100%;
  padding-top: 18rpx;
}

.status-card {
  padding: 26rpx 24rpx 21rpx;
  border: 1rpx solid #dce5d6;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #edf4e8 0%, #f4f7f0 100%);
  box-shadow: 0 10rpx 28rpx rgba(66, 78, 52, 0.06);
}

.status-card--cancelled,
.status-card--refunded {
  border-color: #e8e1dc;
  background: linear-gradient(135deg, #f5f2f0 0%, #faf8f6 100%);
}

.status-card__topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.status-card__copy {
  min-width: 0;
  flex: 1;
}

.status-card__label,
.status-card__description,
.status-card__meta text {
  display: block;
}

.status-card__label {
  color: #50613c;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.status-card__description {
  margin-top: 8rpx;
  color: #76806f;
  font-size: 17rpx;
  line-height: 1.5;
}

.status-card__mark {
  width: 20rpx;
  height: 20rpx;
  flex: 0 0 20rpx;
  margin-top: 7rpx;
  border: 5rpx solid rgba(111, 128, 80, 0.17);
  border-radius: 50%;
  background: #6f8050;
}

.status-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(111, 128, 80, 0.12);
}

.status-card__meta text:first-child {
  color: #9a9f96;
  font-size: 14rpx;
}

.status-card__meta text:last-child {
  color: #71796d;
  font-size: 15rpx;
  font-weight: 500;
}

.detail-card {
  width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e4e8e0;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(67, 72, 60, 0.035);
}

.detail-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 22rpx 17rpx;
}

.detail-card__eyebrow,
.detail-card__title,
.detail-card__count {
  display: block;
}

.detail-card__eyebrow {
  color: #9ca492;
  font-family: Georgia, serif;
  font-size: 12rpx;
  letter-spacing: 2rpx;
}

.detail-card__title {
  margin-top: 5rpx;
  color: #30342e;
  font-size: 22rpx;
  font-weight: 700;
}

.detail-card__count {
  margin-top: 17rpx;
  color: #9ba096;
  font-size: 15rpx;
}

.delivery-card {
  position: relative;
}

.delivery-card__header {
  align-items: center;
  padding-bottom: 15rpx;
}

.delivery-status-pill {
  display: inline-flex;
  min-height: 42rpx;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
  padding: 0 15rpx;
  border: 1rpx solid #dfe5d8;
  border-radius: 22rpx;
  background: #f5f7f2;
  color: #667252;
  font-size: 14rpx;
  font-weight: 600;
}

.delivery-status-pill__dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 5rpx rgba(105, 120, 82, 0.09);
}

.delivery-status-pill--confirmed {
  border-color: #d5e3cf;
  background: #edf5e9;
  color: #557149;
}

.delivery-status-pill--action {
  border-color: #eadab7;
  background: #fff8e9;
  color: #95733b;
}

.delivery-status-pill--rejected {
  border-color: #ead7d7;
  background: #fbf1f1;
  color: #916063;
}

.delivery-status-pill--neutral {
  border-color: #e1e3df;
  background: #f7f7f5;
  color: #747970;
}

.delivery-overview {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin: 0 18rpx;
  overflow: hidden;
  padding: 21rpx 20rpx 21rpx 18rpx;
  border: 1rpx solid #e1e8dc;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f5f8f1 0%, #fbfcf9 100%);
}

.delivery-card--confirmed .delivery-overview {
  border-color: #d9e6d3;
  background: linear-gradient(135deg, #eef6ea 0%, #fafcf8 100%);
}

.delivery-card--action .delivery-overview {
  border-color: #eadfca;
  background: linear-gradient(135deg, #fff8eb 0%, #fffdf8 100%);
}

.delivery-card--rejected .delivery-overview {
  border-color: #eadcdc;
  background: linear-gradient(135deg, #fbf2f2 0%, #fffafa 100%);
}

.delivery-card--neutral .delivery-overview {
  border-color: #e5e6e2;
  background: #f8f8f6;
}

.delivery-overview__accent {
  width: 5rpx;
  flex: 0 0 5rpx;
  align-self: stretch;
  border-radius: 5rpx;
  background: #7a8962;
}

.delivery-card--confirmed .delivery-overview__accent {
  background: #668257;
}

.delivery-card--action .delivery-overview__accent {
  background: #c09a57;
}

.delivery-card--rejected .delivery-overview__accent {
  background: #a97a7c;
}

.delivery-card--neutral .delivery-overview__accent {
  background: #92978e;
}

.delivery-overview__content {
  min-width: 0;
  flex: 1;
}

.delivery-overview__topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.delivery-overview__headline,
.delivery-overview__label,
.delivery-overview__time,
.delivery-overview__caption,
.delivery-compare__label,
.delivery-compare__value,
.delivery-note__label,
.delivery-note__value,
.delivery-address__full {
  display: block;
}

.delivery-overview__headline {
  min-width: 0;
  flex: 1;
  color: #394032;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
}

.delivery-method-text {
  flex: 0 0 auto;
  color: #8b9385;
  font-size: 14rpx;
  line-height: 1.5;
}

.delivery-overview__label {
  margin-top: 20rpx;
  color: #949b90;
  font-size: 13rpx;
}

.delivery-overview__time {
  margin-top: 7rpx;
  color: #30372c;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.delivery-overview__time--empty {
  color: #9b9f98;
  font-size: 21rpx;
  font-weight: 500;
}

.delivery-overview__caption {
  margin-top: 9rpx;
  color: #7f877b;
  font-size: 14rpx;
  line-height: 1.55;
}

.delivery-steps {
  display: flex;
  margin: 20rpx 18rpx 0;
  padding: 17rpx 10rpx 15rpx;
  border-radius: 16rpx;
  background: #fafbf8;
}

.delivery-step {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.delivery-step__rail {
  position: relative;
  display: flex;
  height: 30rpx;
  align-items: center;
  justify-content: center;
}

.delivery-step__dot {
  position: relative;
  z-index: 2;
  display: flex;
  width: 22rpx;
  height: 22rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d8ded2;
  border-radius: 50%;
  background: #ffffff;
  color: #ffffff;
  font-size: 12rpx;
  font-weight: 700;
}

.delivery-step__line {
  position: absolute;
  z-index: 1;
  top: 14rpx;
  right: -50%;
  left: 50%;
  height: 2rpx;
  background: #dfe4da;
}

.delivery-step--done .delivery-step__dot {
  border-color: #73835c;
  background: #73835c;
}

.delivery-step--done .delivery-step__line {
  background: #aebba1;
}

.delivery-step--current .delivery-step__dot {
  border: 5rpx solid #e9eee4;
  background: #71815a;
  box-shadow: 0 0 0 1rpx #bac5af;
}

.delivery-card--action .delivery-step--current .delivery-step__dot {
  border-color: #f5ead3;
  background: #b68d48;
  box-shadow: 0 0 0 1rpx #d8bf91;
}

.delivery-card--rejected .delivery-step--current .delivery-step__dot {
  border-color: #f2e4e4;
  background: #9f7072;
  box-shadow: 0 0 0 1rpx #d2b2b3;
}

.delivery-step__title {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  color: #9a9f96;
  font-size: 13rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delivery-step--done .delivery-step__title,
.delivery-step--current .delivery-step__title {
  color: #60695b;
  font-weight: 600;
}

.delivery-compare {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 14rpx 18rpx 0;
  padding: 16rpx 17rpx;
  border: 1rpx dashed #dfe4d9;
  border-radius: 14rpx;
  background: #ffffff;
}

.delivery-compare__label {
  flex: 0 0 auto;
  color: #949a91;
  font-size: 14rpx;
}

.delivery-compare__value {
  min-width: 0;
  color: #555d50;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: right;
}

.delivery-notes {
  margin: 14rpx 18rpx 0;
  overflow: hidden;
  border: 1rpx solid #eaede7;
  border-radius: 15rpx;
  background: #fcfcfa;
}

.delivery-note {
  padding: 15rpx 17rpx;
}

.delivery-note + .delivery-note {
  border-top: 1rpx solid #eaede7;
}

.delivery-note--adjustment {
  background: #fdf9ef;
}

.delivery-note__label {
  color: #989e95;
  font-size: 13rpx;
}

.delivery-note__value {
  margin-top: 6rpx;
  color: #666e62;
  font-size: 16rpx;
  line-height: 1.55;
}

.delivery-address {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 14rpx 18rpx 0;
  padding: 17rpx;
  border-radius: 16rpx;
  background: #f5f7f2;
}

.delivery-address:active {
  background: #eef2e9;
}

.delivery-address__pin {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border: 2rpx solid #7a8962;
  border-radius: 50% 50% 50% 8rpx;
  transform: rotate(-45deg) scale(0.72);
  background: #eef3e9;
}

.delivery-address__pin-core {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #7a8962;
}

.delivery-address__content {
  min-width: 0;
  flex: 1;
}

.delivery-address__person {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.delivery-address__person text:first-child {
  color: #343a31;
  font-size: 18rpx;
  font-weight: 600;
}

.delivery-address__person text:last-child {
  color: #858c82;
  font-size: 14rpx;
}

.delivery-address__full {
  margin-top: 7rpx;
  color: #6c7468;
  font-size: 15rpx;
  line-height: 1.55;
}

.delivery-address__action {
  flex: 0 0 auto;
  color: #778463;
  font-size: 14rpx;
}

.delivery-footnote {
  display: flex;
  align-items: flex-start;
  gap: 9rpx;
  margin: 15rpx 18rpx 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0ea;
  color: #92988f;
  font-size: 13rpx;
  line-height: 1.55;
}

.delivery-footnote__dot {
  width: 8rpx;
  height: 8rpx;
  flex: 0 0 8rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #81906c;
}

.detail-row {
  display: flex;
  min-height: 46rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
  color: #7b8178;
  font-size: 16rpx;
}

.detail-row text:last-child {
  max-width: 64%;
  color: #4f564d;
  text-align: right;
}

.detail-row--total {
  min-height: 63rpx;
  color: #30342e;
  font-weight: 700;
}

.detail-row--total text:last-child {
  color: #53633e;
  font-size: 25rpx;
}

.detail-line {
  height: 1rpx;
  margin: 10rpx 22rpx 4rpx;
  background: #edf0ea;
}

.detail-product {
  display: flex;
  align-items: center;
  padding: 16rpx 22rpx;
  border-top: 1rpx solid #edf0ea;
}

.detail-product__image {
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #eef1eb;
}

.detail-product__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #68784f;
  font-size: 13rpx;
  font-weight: 700;
}

.detail-product__copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.detail-product__name,
.detail-product__price {
  display: block;
}

.detail-product__name {
  color: #30342e;
  font-size: 19rpx;
  font-weight: 600;
}

.detail-product__price {
  margin-top: 7rpx;
  color: #93988f;
  font-size: 15rpx;
}

.detail-product__right {
  flex: 0 0 auto;
  margin-left: 12rpx;
  text-align: right;
}

.detail-product__right text {
  display: block;
}

.detail-product__right text:first-child {
  color: #92978f;
  font-size: 14rpx;
}

.detail-product__right text:last-child {
  margin-top: 7rpx;
  color: #53633e;
  font-size: 18rpx;
  font-weight: 700;
}

.message-detail {
  padding: 16rpx 22rpx;
  border-top: 1rpx solid #edf0ea;
}

.message-detail text {
  display: block;
}

.message-detail text:first-child {
  color: #343832;
  font-size: 16rpx;
  font-weight: 600;
}

.message-detail text:last-child {
  margin-top: 8rpx;
  color: #727970;
  font-size: 16rpx;
  line-height: 1.65;
}

.timeline-item {
  position: relative;
  display: flex;
  padding: 9rpx 22rpx 21rpx;
}

.timeline-item::before {
  position: absolute;
  top: 23rpx;
  bottom: -7rpx;
  left: 30rpx;
  width: 1rpx;
  background: #dfe5da;
  content: "";
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item__dot {
  position: relative;
  z-index: 1;
  width: 16rpx;
  height: 16rpx;
  flex: 0 0 16rpx;
  margin-top: 5rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #6f8050;
  box-shadow: 0 0 0 1rpx #cdd7c5;
}

.timeline-item__copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.timeline-item__title,
.timeline-item__note,
.timeline-item__time {
  display: block;
}

.timeline-item__title {
  color: #343832;
  font-size: 17rpx;
  font-weight: 600;
}

.timeline-item__note {
  margin-top: 6rpx;
  color: #777e74;
  font-size: 15rpx;
  line-height: 1.55;
}

.timeline-item__time {
  margin-top: 6rpx;
  color: #a0a59d;
  font-size: 13rpx;
}

.info-card__bottom {
  height: 14rpx;
}

.logistics-card__header {
  align-items: center;
}

.logistics-card__state {
  display: block;
  margin-top: 7rpx;
  color: #6b7855;
  font-size: 16rpx;
}

.text-action,
.outline-action {
  flex: 0 0 auto;
  color: #627148;
  font-size: 16rpx;
}

.outline-action {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 0 15rpx;
  border: 1rpx solid #d8e0d1;
  border-radius: 21rpx;
  background: #ffffff;
}

.logistics-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f4f6f0;
}

.logistics-company,
.logistics-number,
.logistics-updated,
.logistics-trace__context,
.logistics-trace__time {
  display: block;
}

.logistics-company {
  color: #353a32;
  font-size: 19rpx;
  font-weight: 600;
}

.logistics-number {
  margin-top: 6rpx;
  color: #7c8379;
  font-size: 16rpx;
}

.logistics-updated {
  margin: 12rpx 20rpx 0;
  color: #9aa096;
  font-size: 14rpx;
}

.logistics-trace {
  margin: 17rpx 18rpx 0;
}

.logistics-trace__item {
  display: flex;
  min-height: 86rpx;
}

.logistics-trace__rail {
  position: relative;
  display: flex;
  width: 34rpx;
  flex: 0 0 34rpx;
  justify-content: center;
}

.logistics-trace__dot {
  position: relative;
  z-index: 2;
  width: 15rpx;
  height: 15rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #7b8a63;
  box-shadow: 0 0 0 5rpx #edf1e9;
}

.logistics-trace__line {
  position: absolute;
  top: 24rpx;
  bottom: -2rpx;
  left: 50%;
  width: 2rpx;
  transform: translateX(-50%);
  background: #dce2d7;
}

.logistics-trace__copy {
  min-width: 0;
  flex: 1;
  padding: 0 0 22rpx 12rpx;
}

.logistics-trace__context {
  color: #444941;
  font-size: 17rpx;
  line-height: 1.55;
}

.logistics-trace__time {
  margin-top: 7rpx;
  color: #9ba198;
  font-size: 14rpx;
}

.logistics-empty {
  margin: 16rpx 18rpx 18rpx;
  padding: 22rpx 18rpx;
  border-radius: 14rpx;
  background: #fafbf8;
  color: #959b92;
  font-size: 16rpx;
  text-align: center;
}

.order-detail-bottom-space {
  height: calc(128rpx + env(safe-area-inset-bottom));
}

.order-detail-fixed-bar {
  position: fixed;
  z-index: 90;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 15rpx 22rpx calc(15rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e4e8e0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(56, 61, 50, 0.06);
}

.detail-secondary-button,
.detail-primary-button {
  display: flex;
  min-width: 0;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 33rpx;
  font-size: 18rpx;
}

.detail-secondary-button {
  flex: 0 0 34%;
  border: 1rpx solid #d7ddd2;
  color: #6f766c;
  background: #ffffff;
}

.detail-primary-button {
  flex: 1;
  background: #6f8050;
  color: #ffffff;
}

.order-detail-page--wide .order-detail-content {
  max-width: 1180rpx;
  margin: 0 auto;
}

.order-detail-page--wide .order-detail-layout {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.order-detail-page--wide .order-detail-main {
  width: 64%;
  flex: 0 0 64%;
}

.order-detail-page--wide .order-detail-side {
  width: calc(36% - 20rpx);
  flex: 0 0 calc(36% - 20rpx);
}

.order-detail-page--compact .detail-product,
.order-detail-page--compact .detail-row {
  padding-right: 17rpx;
  padding-left: 17rpx;
}

.order-detail-page--compact .delivery-overview__topline {
  display: block;
}

.order-detail-page--compact .delivery-method-text {
  display: block;
  margin-top: 5rpx;
}

.order-detail-page--compact .delivery-steps {
  padding-right: 4rpx;
  padding-left: 4rpx;
}

.order-detail-page--compact .delivery-step__title {
  font-size: 12rpx;
}
