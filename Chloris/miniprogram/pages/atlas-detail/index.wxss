.atlas-detail-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #fbfbf8;
}

.atlas-detail-scroll,
.atlas-detail-content {
  width: 100%;
}

.atlas-detail-content {
  min-height: 100%;
  padding-top: 18rpx;
}

.atlas-detail-hero {
  position: relative;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid #e4e7e1;
  border-radius: 6rpx;
}

.atlas-detail-hero--dark {
  background: #070807;
}

.atlas-detail-hero--light {
  background: #ffffff;
}

.atlas-detail-hero--soft {
  background: #f6f6f4;
}

.atlas-detail-hero__image {
  display: block;
  width: 90%;
  height: 88%;
  margin: 0 auto;
}

.atlas-detail-hero__placeholder {
  display: flex;
  width: 100%;
  height: 100%;
}

.atlas-detail-hero__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111111;
  font-size: 35rpx;
  font-weight: 700;
  letter-spacing: 7rpx;
}

.atlas-detail-hero__purchased {
  position: absolute;
  z-index: 2;
  top: 15rpx;
  left: 15rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(17, 17, 17, 0.94);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.atlas-detail-favorite {
  position: absolute;
  z-index: 3;
  top: 13rpx;
  right: 13rpx;
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: none;
}

.detail-star {
  display: block;
  color: #777772;
  font-size: 33rpx;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-1rpx);
}

.atlas-detail-favorite--active {
  background: rgba(17, 17, 17, 0.96);
}

.atlas-detail-favorite--active .detail-star {
  color: #ffffff;
}

.atlas-editorial {
  padding: 26rpx 5rpx 10rpx;
}

.atlas-editorial__title,
.atlas-editorial__latin,
.atlas-editorial__meaning,
.atlas-editorial__description,
.atlas-editorial__period {
  display: block;
}

.atlas-editorial__title {
  color: #22262a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.atlas-editorial__latin {
  margin-top: 5rpx;
  color: #939991;
  font-size: 22rpx;
  line-height: 1.4;
}

.atlas-editorial__meaning {
  margin-top: 13rpx;
  color: #292929;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.atlas-editorial__alias {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  color: #777772;
  font-size: 22rpx;
}

.atlas-editorial__alias text:first-child {
  margin-right: 10rpx;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: #f6f6f4;
  color: #637149;
}

.atlas-editorial__description {
  margin-top: 20rpx;
  color: #2f3337;
  font-size: 26rpx;
  line-height: 1.82;
  letter-spacing: 0.3rpx;
}

.atlas-editorial__period {
  margin-top: 22rpx;
  color: #3d4145;
  font-size: 24rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.safety-note {
  display: flex;
  width: 100%;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 18rpx 19rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 15rpx;
  background: #fbf4ef;
}

.safety-note__mark {
  display: flex;
  width: 33rpx;
  height: 33rpx;
  flex: 0 0 33rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #aa765d;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.safety-note__copy {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 13rpx;
}

.safety-note__title,
.safety-note__text {
  display: block;
}

.safety-note__title {
  color: #674c3f;
  font-size: 24rpx;
  font-weight: 650;
}

.safety-note__text {
  margin-top: 5rpx;
  color: #806a5e;
  font-size: 22rpx;
  line-height: 1.65;
}

.atlas-detail-layout {
  width: 100%;
}

.atlas-detail-layout__main,
.atlas-detail-layout__side {
  width: 100%;
  min-width: 0;
}

.detail-card {
  width: 100%;
  margin-top: 18rpx;
  padding: 21rpx;
  border: 1rpx solid #eeeeeb;
  border-radius: 17rpx;
  background: #ffffff;
}

.detail-card__eyebrow,
.detail-card__title,
.detail-card__paragraph {
  display: block;
}

.detail-card__eyebrow {
  color: #829073;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2.5rpx;
}

.detail-card__title {
  margin-top: 4rpx;
  color: #171717;
  font-size: 28rpx;
  font-weight: 650;
}

.detail-card__paragraph {
  margin-top: 12rpx;
  color: #686e65;
  font-size: 24rpx;
  line-height: 1.75;
}

.care-list {
  margin-top: 13rpx;
}

.care-step {
  display: flex;
  width: 100%;
  align-items: flex-start;
  padding: 11rpx 0;
  border-bottom: 1rpx solid #f6f6f4;
}

.care-step:last-child {
  border-bottom: 0;
}

.care-step__number {
  display: flex;
  width: 35rpx;
  height: 35rpx;
  flex: 0 0 35rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f6f6f4;
  color: #292929;
  font-size: 22rpx;
  font-weight: 600;
}

.care-step__text {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 12rpx;
  color: #5b5b56;
  font-size: 24rpx;
  line-height: 1.65;
}

.info-row {
  display: flex;
  min-height: 53rpx;
  align-items: flex-start;
  justify-content: space-between;
  border-bottom: 1rpx solid #f6f6f4;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row__label {
  padding: 13rpx 0;
  color: #8d8d88;
  font-size: 24rpx;
}

.info-row__value {
  max-width: 68%;
  padding: 13rpx 0;
  color: #4f554d;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: left;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 8rpx;
}

.detail-tag {
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  background: #f1f4ee;
  color: #687650;
  font-size: 22rpx;
}

.related-section {
  margin-top: 24rpx;
}

.related-section__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.related-section__title {
  color: #171717;
  font-size: 28rpx;
  font-weight: 650;
}

.related-section__hint {
  color: #9b9b96;
  font-size: 20rpx;
}

.related-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  gap: 12rpx;
}

.related-card {
  display: flex;
  width: calc((100% - 12rpx) / 2);
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #eeeeeb;
  border-radius: 15rpx;
  background: #ffffff;
}

.related-card__image {
  display: block;
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  background: #f6f6f4;
}

.related-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7b53;
  font-size: 24rpx;
  font-weight: 600;
}

.related-card__copy {
  flex: 1 1 auto;
  min-width: 0;
  padding: 13rpx 11rpx;
}

.related-card__name,
.related-card__price {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-card__name {
  color: #171717;
  font-size: 24rpx;
  font-weight: 600;
}

.related-card__price {
  margin-top: 8rpx;
  color: #5b6b44;
  font-size: 22rpx;
}

.atlas-detail-action {
  display: flex;
  width: 100%;
  height: 66rpx;
  align-items: center;
  justify-content: center;
  margin-top: 23rpx;
  border-radius: 33rpx;
  background: #111111;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.atlas-detail-bottom-space {
  height: calc(50rpx + env(safe-area-inset-bottom));
}

.atlas-detail-state {
  display: flex;
  min-height: 520rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8e948b;
  font-size: 26rpx;
}

.atlas-detail-state__title {
  color: #5b5b56;
  font-size: 26rpx;
}

.atlas-detail-state__button {
  margin-top: 18rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f6f6f4;
  color: #607047;
}

.atlas-detail-page--wide .atlas-detail-content {
  max-width: 1120rpx;
  margin: 0 auto;
}

.atlas-detail-page--wide .atlas-detail-layout {
  display: flex;
  align-items: flex-start;
}

.atlas-detail-page--wide .atlas-detail-layout__main {
  width: 64%;
  flex: 0 0 64%;
  padding-right: 12rpx;
}

.atlas-detail-page--wide .atlas-detail-layout__side {
  width: 36%;
  flex: 0 0 36%;
  padding-left: 12rpx;
}

.atlas-detail-bottom-space {
  height: calc(132rpx + env(safe-area-inset-bottom));
}

.atlas-detail-fixed-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(74, 68, 58, 0.08);
  background: rgba(251, 251, 248, 0.98);
  box-shadow: none;
}

.atlas-detail-fixed-bar__inner {
  width: 100%;
}

.atlas-detail-action {
  height: 78rpx;
  margin-top: 0;
  border-radius: 39rpx;
}

/* V6.14 visual consistency for legacy hidden page */
.atlas-detail-page { background:#f7f7f5; }
.atlas-editorial,.detail-card,.related-card,.safety-note { border:1rpx solid #eeeeeb; border-radius:0; background:#fff; box-shadow:none; }
.atlas-editorial__title,.detail-card__title,.related-section__title { color:#171717; font-family:inherit; font-weight:650; }
.atlas-detail-hero { background:#f3f3f1 !important; }
.atlas-detail-action { border:2rpx solid #111; border-radius:999rpx; background:#111; color:#fff; }
