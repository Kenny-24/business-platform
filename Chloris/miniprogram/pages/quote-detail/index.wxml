<view class="safe-page quote-detail-page {{wideLayout ? 'quote-detail-page--wide' : ''}} {{compactLayout ? 'quote-detail-page--compact' : ''}}">
  <app-nav title="定制报价详情" showBack solid></app-nav>

  <scroll-view class="quote-detail-scroll" style="height: {{scrollHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="quote-detail-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <flower-loader wx:if="{{loading}}" compact text="正在同步报价详情…"></flower-loader>

      <block wx:elif="{{item}}">
        <view class="quote-detail-status quote-detail-status--{{item.statusTone}}">
          <view>
            <text class="quote-detail-status__label">{{item.statusLabel}}</text>
            <text class="quote-detail-status__description">{{item.statusDescription}}</text>
          </view>
          <text class="quote-detail-status__number">{{item.requestNo}}</text>
        </view>

        <view class="quote-detail-layout">
          <view class="quote-detail-main">
            <view class="quote-detail-card media-card">
              <swiper wx:if="{{item.images.length}}" class="quote-media" indicator-dots="{{item.images.length > 1}}" bindchange="changeImage">
                <swiper-item wx:for="{{item.images}}" wx:key="*this">
                  <image class="quote-media__image" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage"></image>
                </swiper-item>
              </swiper>
              <view wx:if="{{item.images.length > 1}}" class="quote-media__count">{{currentImage}} / {{item.images.length}}</view>
            </view>

            <view class="quote-detail-card">
              <text class="quote-detail-card__title">我的需求</text>
              <view class="quote-info-row"><text>提交时间</text><text>{{item.createdAtText}}</text></view>
              <view class="quote-info-row"><text>联系人</text><text>{{item.contactName}}</text></view>
              <view class="quote-info-row"><text>联系电话</text><text>{{item.contactPhoneMasked}}</text></view>
              <view class="quote-message-block">
                <text class="quote-message-block__label">需求说明</text>
                <text class="quote-message-block__text">{{item.message || '未填写补充说明'}}</text>
              </view>
            </view>

            <view class="quote-detail-card merchant-card">
              <view class="merchant-card__head">
                <text class="quote-detail-card__title">商户回复</text>
                <text wx:if="{{item.quotedAtText}}" class="merchant-card__time">{{item.quotedAtText}}</text>
              </view>
              <view wx:if="{{item.quotedPriceText}}" class="merchant-price">
                <text class="merchant-price__label">定制报价</text>
                <view><text class="merchant-price__currency">¥</text><text class="merchant-price__amount">{{item.quotedPriceText}}</text></view>
              </view>
              <text class="merchant-reply">{{item.merchantReply || '商户尚未回复，请耐心等待。'}}</text>
            </view>
          </view>

          <view class="quote-detail-side">
            <view class="quote-detail-card process-card">
              <view class="process-card__head">
                <text class="quote-detail-card__title">处理进度</text>
                <text class="process-card__caption">按流程实时更新</text>
              </view>
              <view class="process-list">
                <view
                  wx:for="{{item.timeline}}"
                  wx:key="key"
                  wx:for-item="step"
                  class="process-item {{step.active ? 'process-item--active' : 'process-item--pending'}}"
                >
                  <view class="process-item__rail">
                    <view class="process-item__dot">
                      <text wx:if="{{step.active}}" class="process-item__check">✓</text>
                    </view>
                    <view wx:if="{{index < item.timeline.length - 1}}" class="process-item__line"></view>
                  </view>
                  <view class="process-item__copy">
                    <text class="process-item__title">{{step.title}}</text>
                    <text class="process-item__time">{{step.time || (step.active ? '已完成' : '待处理')}}</text>
                  </view>
                </view>
              </view>
            </view>

            <view class="quote-detail-card contact-card">
              <view class="contact-card__copy">
                <text class="contact-card__title">对方案有疑问？</text>
                <text class="contact-card__sub">联系客服沟通花材、预算和配送安排。</text>
              </view>
              <button class="contact-card__button" open-type="contact" show-message-card="{{true}}" session-from="{{customerSessionFrom}}">联系客服</button>
            </view>
          </view>
        </view>

        <view class="quote-detail-bottom-space"></view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{item && item.canDecide}}" class="quote-bottom-bar">
    <view class="quote-bottom-actions">
      <view
        class="quote-bottom-action quote-bottom-action--secondary {{submitting ? 'quote-bottom-action--disabled' : ''}}"
        bindtap="rejectQuote"
        hover-class="quote-bottom-action--pressed"
        role="button"
      >拒绝</view>
      <view
        class="quote-bottom-action quote-bottom-action--primary {{submitting ? 'quote-bottom-action--disabled' : ''}}"
        bindtap="acceptQuote"
        hover-class="quote-bottom-action--pressed"
        role="button"
      >{{submitting ? '正在生成…' : '同意并生成订单'}}</view>
    </view>
  </view>

  <view wx:elif="{{item && item.orderId}}" class="quote-bottom-bar">
    <view class="quote-bottom-actions quote-bottom-actions--single">
      <view class="quote-bottom-action quote-bottom-action--primary" bindtap="viewOrder" hover-class="quote-bottom-action--pressed" role="button">查看对应订单</view>
    </view>
  </view>


  <view wx:if="{{deliveryEditorVisible}}" class="delivery-sheet-mask" bindtap="closeDeliveryEditor">
    <view class="delivery-sheet" catchtap="preventEditorClose">
      <view class="delivery-sheet__handle"></view>
      <view class="delivery-sheet__head">
        <view>
          <text class="delivery-sheet__title">确认配送信息</text>
          <text class="delivery-sheet__subtitle">先选择期望时间，商家会在后台确认或提出调整。</text>
        </view>
        <view class="delivery-sheet__close" bindtap="closeDeliveryEditor" role="button">×</view>
      </view>

      <view class="delivery-form-group">
        <text class="delivery-form-label">收货地址</text>
        <picker range="{{addressOptions}}" range-key="label" value="{{deliveryForm.addressIndex}}" bindchange="onAddressChange">
          <view class="delivery-picker-card">
            <view class="delivery-picker-card__copy">
              <text class="delivery-picker-card__title">{{selectedAddress.label}}</text>
              <text class="delivery-picker-card__description">{{selectedAddress.description}}</text>
            </view>
            <view class="delivery-picker-card__arrow"></view>
          </view>
        </picker>
      </view>

      <view class="delivery-form-grid">
        <view class="delivery-form-group">
          <text class="delivery-form-label">期望配送日期</text>
          <picker mode="date" value="{{deliveryForm.requestedDeliveryDate}}" start="{{minDeliveryDate}}" end="{{maxDeliveryDate}}" bindchange="onDeliveryDateChange">
            <view class="delivery-picker-value">
              <text>{{deliveryForm.requestedDeliveryDate}}</text>
              <view class="delivery-picker-card__arrow"></view>
            </view>
          </picker>
        </view>

        <view class="delivery-form-group">
          <text class="delivery-form-label">期望配送时段</text>
          <picker range="{{deliverySlots}}" value="{{deliveryForm.deliverySlotIndex}}" bindchange="onDeliverySlotChange">
            <view class="delivery-picker-value">
              <text>{{selectedDeliverySlot}}</text>
              <view class="delivery-picker-card__arrow"></view>
            </view>
          </picker>
        </view>
      </view>

      <view class="delivery-form-group">
        <text class="delivery-form-label">配送备注</text>
        <textarea
          class="delivery-form-textarea"
          value="{{deliveryForm.requestedDeliveryNote}}"
          maxlength="120"
          placeholder="例如：送达前电话联系、请勿按门铃"
          bindinput="onDeliveryNoteInput"
        ></textarea>
      </view>

      <view class="delivery-sheet__notice">商家确认后会显示最终配送时间；如需调整，会再次请你确认。</view>
      <view class="delivery-sheet__submit {{submitting ? 'delivery-sheet__submit--disabled' : ''}}" bindtap="confirmDeliveryAndCreate" role="button">
        {{submitting ? '正在生成订单…' : '确认并生成订单'}}
      </view>
    </view>
  </view>

</view>
