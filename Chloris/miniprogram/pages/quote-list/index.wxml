<view class="safe-page quote-list-page {{wideLayout ? 'quote-list-page--wide' : ''}} {{compactLayout ? 'quote-list-page--compact' : ''}}">
  <app-nav title="定制报价" showBack solid></app-nav>

  <scroll-view class="quote-list-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="quote-list-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <view class="quote-list-hero">
        <view>
          <text class="quote-list-hero__eyebrow">CUSTOM QUOTE</text>
          <text class="quote-list-hero__title">我的定制报价</text>
          <text class="quote-list-hero__sub">查看商户回复，确认报价后生成对应订单。</text>
        </view>
        <view class="quote-list-hero__button" bindtap="createNew" role="button">发起新需求</view>
      </view>

      <view class="quote-tabs">
        <view wx:for="{{tabs}}" wx:key="value" class="quote-tab {{activeTab === item.value ? 'quote-tab--active' : ''}}" data-value="{{item.value}}" bindtap="selectTab" role="button">
          <text>{{item.label}}</text>
          <text wx:if="{{counts[item.value] > 0}}" class="quote-tab__count">{{item.count}}</text>
        </view>
      </view>

      <view class="quote-list-head">
        <text>报价记录</text>
        <view class="quote-list-refresh" bindtap="refresh" role="button">刷新</view>
      </view>

      <flower-loader wx:if="{{loading}}" compact text="正在同步报价记录…"></flower-loader>

      <view wx:elif="{{items.length}}" class="quote-card-list">
        <view wx:for="{{items}}" wx:key="_id" class="quote-record" data-id="{{item._id}}" bindtap="openItem" role="button">
          <image wx:if="{{item.coverUrl}}" class="quote-record__image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="quote-record__image quote-record__placeholder">CHLORIS</view>

          <view class="quote-record__copy">
            <view class="quote-record__top">
              <text class="quote-record__number">{{item.requestNo}}</text>
              <text class="quote-status quote-status--{{item.statusTone}}">{{item.statusLabel}}</text>
            </view>
            <text class="quote-record__message">{{item.message || '未填写补充说明'}}</text>
            <view class="quote-record__bottom">
              <text>{{item.createdAtText}}</text>
              <text wx:if="{{item.quotedPriceText}}" class="quote-record__price">¥{{item.quotedPriceText}}</text>
              <text wx:else>等待报价</text>
            </view>
          </view>

          <view class="quote-record__arrow"></view>
        </view>
      </view>

      <view wx:else class="quote-empty">
        <text class="quote-empty__title">暂无相关报价记录</text>
        <text class="quote-empty__sub">上传参考图片后，商户会在这里回复方案和价格。</text>
        <view class="quote-empty__button" bindtap="createNew" role="button">发起定制需求</view>
      </view>

      <view class="quote-list-bottom-space"></view>
    </view>
  </scroll-view>
</view>
