.care-page {
  min-height: 100vh;
  padding-bottom: 0;
  background: #fbfaf7;
}

.care-hero {
  padding: 54rpx 42rpx 46rpx;
  background: linear-gradient(135deg, #f9e9eb, #fff8f6);
}

.care-hero__eyebrow,
.care-hero__title,
.care-hero__sub {
  display: block;
}

.care-hero__eyebrow {
  color: #bd7584;
  font-family: Georgia, serif;
  font-size: 17rpx;
  letter-spacing: 4rpx;
}

.care-hero__title {
  margin-top: 18rpx;
  color: #302d2c;
  font-family: "Songti SC", serif;
  font-size: 42rpx;
  line-height: 1.35;
}

.care-hero__sub {
  margin-top: 13rpx;
  color: #887f7d;
  font-size: 20rpx;
  line-height: 1.7;
}

.guide-tabs {
  width: 100%;
  border-bottom: 1rpx solid #eeeae3;
  background: #ffffff;
}

.guide-tabs__inner {
  display: flex;
  padding: 20rpx 24rpx;
  white-space: nowrap;
}

.guide-tab {
  display: inline-flex;
  height: 54rpx;
  align-items: center;
  margin-right: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e8e3dc;
  border-radius: 27rpx;
  color: #79756e;
  font-size: 19rpx;
}

.guide-tab--active {
  border-color: #d98899;
  background: #d98899;
  color: #ffffff;
}

.guide-content {
  padding: 42rpx 30rpx 0;
}

.guide-eyebrow,
.guide-title,
.guide-intro {
  display: block;
}

.guide-eyebrow {
  color: #bb7a87;
  font-family: Georgia, serif;
  font-size: 16rpx;
  letter-spacing: 3rpx;
}

.guide-title {
  margin-top: 12rpx;
  color: #302e2b;
  font-family: "Songti SC", serif;
  font-size: 38rpx;
}

.guide-intro {
  margin-top: 14rpx;
  color: #827d75;
  font-size: 21rpx;
  line-height: 1.75;
}

.guide-step {
  display: flex;
  margin-top: 26rpx;
  padding: 27rpx;
  border: 1rpx solid #ece8e1;
  border-radius: 18rpx;
  background: #ffffff;
}

.guide-step__number {
  flex: 0 0 54rpx;
  color: #d48697;
  font-family: Georgia, serif;
  font-size: 22rpx;
}

.guide-step__copy {
  min-width: 0;
  flex: 1;
}

.guide-step__title,
.guide-step__body {
  display: block;
}

.guide-step__title {
  color: #35322f;
  font-size: 23rpx;
  font-weight: 600;
}

.guide-step__body {
  margin-top: 9rpx;
  color: #858078;
  font-size: 19rpx;
  line-height: 1.7;
}

.tips-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #f3f5ef;
}

.tips-card__title {
  display: block;
  margin-bottom: 14rpx;
  color: #596548;
  font-size: 23rpx;
  font-weight: 600;
}

.tip-row {
  display: flex;
  margin-top: 9rpx;
  color: #747b6d;
  font-size: 19rpx;
  line-height: 1.65;
}

.tip-dot {
  margin-right: 12rpx;
  color: #80905f;
}

.care-bottom-space {
  height: calc(156rpx + env(safe-area-inset-bottom));
}

.care-fixed-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(74, 68, 58, 0.08);
  background: rgba(251, 250, 247, 0.98);
  box-shadow: 0 -10rpx 30rpx rgba(55, 50, 42, 0.07);
}

.care-fixed-bar__inner {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.care-action {
  display: flex;
  height: 78rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d98899;
  border-radius: 39rpx;
  background: #d98899;
  color: #ffffff;
  font-size: 21rpx;
}

.care-action--light {
  background: #ffffff;
  color: #b66f7d;
}
