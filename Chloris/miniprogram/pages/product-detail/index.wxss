.product-detail-page {
  min-height: 100vh;
  background: #ffffff;
  color: #171717;
}

.detail-hero {
  position: relative;
  width: 100%;
  height: 1030rpx;
  overflow: hidden;
  background: #f3f3f1;
}

.detail-hero__swiper,
.detail-hero__video,
.detail-hero__image,
.detail-hero__placeholder {
  width: 100%;
  height: 100%;
}

.detail-hero__video {
  display: block;
  background: #f3f3f1;
}

.detail-hero__image {
  display: block;
  box-sizing: border-box;
  padding: 116rpx 64rpx 122rpx;
}

.detail-hero__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a4a49e;
  font-family: serif;
  font-size: 30rpx;
  letter-spacing: 12rpx;
}

.detail-floating-back {
  position: absolute;
  left: 24rpx;
  z-index: 20;
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(30, 30, 30, 0.08);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}

.detail-floating-back__icon {
  width: 22rpx;
  height: 22rpx;
  border-bottom: 4rpx solid #111111;
  border-left: 4rpx solid #111111;
  transform: rotate(45deg);
}

.detail-hero__dots {
  position: absolute;
  right: 0;
  bottom: 58rpx;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.detail-hero__dot {
  width: 13rpx;
  height: 13rpx;
  background: rgba(25, 25, 25, 0.18);
  transform: rotate(45deg);
}

.detail-hero__dot--active {
  background: #111111;
}

.detail-summary {
  padding: 48rpx 42rpx 52rpx;
  border-bottom: 1rpx solid #eeeeeb;
  background: #ffffff;
}

.detail-summary__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.detail-summary__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-badge {
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: #f5f5f3;
  color: #242424;
  font-size: 26rpx;
  line-height: 1;
}

.detail-sku {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
  color: #525252;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.detail-copy-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid #4a4a4a;
}

.detail-copy-icon::before {
  position: absolute;
  top: -7rpx;
  left: -7rpx;
  width: 15rpx;
  height: 15rpx;
  border: 2rpx solid #4a4a4a;
  background: #ffffff;
  content: '';
}

.detail-summary__title {
  display: block;
  margin-top: 30rpx;
  color: #151515;
  font-size: 42rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.32;
}

.detail-summary__price {
  display: flex;
  align-items: baseline;
  margin-top: 24rpx;
  color: #1a1a1a;
  font-size: 42rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.detail-summary__currency {
  margin-right: 10rpx;
  font-size: 34rpx;
}

.detail-summary__description {
  display: block;
  margin-top: 32rpx;
  color: #292929;
  font-size: 30rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.detail-operation-note {
  margin-top: 30rpx;
  padding: 22rpx 24rpx;
  background: #f7f7f5;
}

.detail-operation-note__line {
  display: block;
  color: #4a4a4a;
  font-size: 26rpx;
  line-height: 1.75;
}

.detail-accordion {
  background: #ffffff;
}

.detail-section {
  border-bottom: 1rpx solid #eeeeeb;
}

.detail-section__head {
  display: flex;
  min-height: 126rpx;
  padding: 0 42rpx;
  align-items: center;
  justify-content: space-between;
  color: #151515;
  font-size: 29rpx;
  font-weight: 650;
}

.detail-section__symbol {
  color: #111111;
  font-size: 39rpx;
  font-weight: 400;
  line-height: 1;
}

.detail-section__body {
  padding: 0 42rpx 42rpx;
}

.detail-section__paragraph {
  display: block;
  padding: 30rpx 32rpx;
  background: #f6f6f4;
  color: #292929;
  font-size: 28rpx;
  line-height: 1.85;
  white-space: pre-wrap;
}

.detail-section__paragraph + .detail-section__paragraph {
  margin-top: 16rpx;
}

.detail-section__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.detail-section__tag {
  padding: 10rpx 16rpx;
  border: 1rpx solid #e4e4df;
  border-radius: 999rpx;
  color: #5b5b56;
  font-size: 26rpx;
}

.detail-bottom-space {
  height: calc(154rpx + env(safe-area-inset-bottom));
}

.detail-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  box-sizing: border-box;
  gap: 18rpx;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ececea;
  background: rgba(255, 255, 255, 0.98);
}

.detail-action-button {
  display: flex;
  min-width: 0;
  height: 92rpx;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.detail-action-button--light {
  background: #ffffff;
  color: #111111;
}

.detail-error {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 240rpx 56rpx 100rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  background: #ffffff;
}

.detail-error__title {
  color: #242424;
  font-size: 30rpx;
  font-weight: 650;
}

.detail-error__button {
  margin-top: 34rpx;
  padding: 20rpx 42rpx;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  color: #111111;
  font-size: 28rpx;
}
