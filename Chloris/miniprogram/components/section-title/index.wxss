.section-title {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 48rpx;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title__copy {
  flex: 1 1 auto;
  min-width: 0;
}

.section-title__main,
.section-title__sub {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title__main {
  color: #292824;
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.28;
}

.section-title__sub {
  margin-top: 7rpx;
  color: #97928a;
  font-size: 18rpx;
  line-height: 1.35;
}

.section-title__more {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  margin-left: 16rpx;
  padding: 8rpx 0 8rpx 14rpx;
  color: #8b877f;
  font-size: 19rpx;
  white-space: nowrap;
}

.section-title__more-arrow {
  width: 11rpx;
  height: 11rpx;
  margin-left: 7rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.section-title__more { min-height: 44rpx; line-height: 1; }
.section-title__more text { display: block; line-height: 1.2; }
.section-title__more-arrow { display: block; align-self: center; transform: rotate(45deg); }
