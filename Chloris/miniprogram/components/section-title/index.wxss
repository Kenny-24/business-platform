.section-title { display:flex; width:100%; min-width:0; min-height:48rpx; align-items:center; justify-content:space-between; margin-bottom:25rpx; }
.section-title__copy { flex:1 1 auto; min-width:0; }
.section-title__main,.section-title__sub { display:block; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.section-title__main { color:#171717; font-family:inherit; font-size: 31rpx; font-weight:650; letter-spacing:1rpx; line-height:1.28; }
.section-title__sub { margin-top:7rpx; color:#8d8d88; font-size: 24rpx; line-height:1.35; }
.section-title__more { display:flex; min-height:44rpx; flex:0 0 auto; align-items:center; margin-left:16rpx; padding:8rpx 0 8rpx 14rpx; color:#5b5b56; font-size: 26rpx; line-height:1; white-space:nowrap; }
.section-title__more text { display:block; line-height:1.2; }
.section-title__more-arrow { display:block; width:11rpx; height:11rpx; align-self:center; margin-left:7rpx; border-top:2rpx solid currentColor; border-right:2rpx solid currentColor; transform:rotate(45deg); }


/* 首页紧凑模块标题：只在 compact=true 时生效 */
.section-title--compact { min-height:44rpx; margin-bottom:20rpx; }
.section-title--compact .section-title__main { font-size:28rpx; letter-spacing:.5rpx; line-height:1.3; }
.section-title--compact .section-title__sub { margin-top:6rpx; font-size:21rpx; }
