.section-more {
  display: flex;
  width: 286rpx;
  height: 68rpx;
  min-width: 0;
  align-items: center;
  justify-content: center;
  margin: 28rpx auto 2rpx;
  padding: 0 28rpx;
  border: 1rpx solid #6f7d55;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5d6c43;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1;
  transition: opacity 140ms ease, transform 140ms ease, background 140ms ease;
}

.section-more--pressed {
  background: #f2f4ee;
  opacity: 0.84;
  transform: scale(0.98);
}
