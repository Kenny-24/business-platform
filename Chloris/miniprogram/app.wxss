page {
  --bg: #f7f7f5;
  --surface: #ffffff;
  --surface-soft: #f6f6f4;
  --surface-muted: #f3f3f1;
  --primary: #111111;
  --primary-dark: #111111;
  --accent: #111111;
  --accent-dark: #111111;
  --text: #171717;
  --text-2: #5b5b56;
  --text-3: #9b9b96;
  --line: #eeeeeb;
  --line-dark: #d8d8d3;
  --shadow: none;
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

view, scroll-view, swiper, swiper-item, image, text, button, input, textarea, picker {
  box-sizing: border-box;
}

button {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1;
  text-align: inherit;
}

button::after { border: 0; }
image { display: block; }

.safe-page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.card {
  border: 1rpx solid var(--line);
  border-radius: 0;
  background: var(--surface);
  box-shadow: none;
}

.song-font { font-family: inherit; }
.muted { color: var(--text-2); }
.price { color: var(--text); }

/* V6.14 luxury-neutral interaction defaults */
input, textarea {
  color: #171717;
  caret-color: #111111;
}

.luxury-primary-button {
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.luxury-secondary-button {
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #111111;
  border-radius: 999rpx;
  background: #ffffff;
  color: #111111;
  font-size: 30rpx;
  font-weight: 650;
}

/* V6.16 LV-inspired typography baseline */
page {
  --font-display: 48rpx;
  --font-title: 34rpx;
  --font-heading: 30rpx;
  --font-body: 28rpx;
  --font-secondary: 24rpx;
  --font-caption: 22rpx;
  line-height: 1.5;
}

input,
textarea {
  font-size: var(--font-body);
  line-height: 1.55;
  text-align: left;
}

button {
  font-size: var(--font-body);
}

/* V6.18 全局响应式尺寸基线：以 rpx 为主，兼顾窄屏、常规手机与平板 */
page {
  --page-gutter: 36rpx;
  --section-gap: 28rpx;
  --block-gap: 18rpx;
  --radius-large: 28rpx;
  --radius-medium: 20rpx;
  --radius-small: 14rpx;
  --touch-height: 80rpx;
  --font-display: 44rpx;
  --font-title: 32rpx;
  --font-heading: 28rpx;
  --font-body: 26rpx;
  --font-secondary: 22rpx;
  --font-caption: 20rpx;
}

text,
input,
textarea,
button {
  overflow-wrap: anywhere;
}

input,
textarea {
  width: 100%;
  max-width: 100%;
}

@media (max-width: 360px) {
  page {
    --page-gutter: 28rpx;
    --section-gap: 22rpx;
    --block-gap: 14rpx;
    --radius-large: 24rpx;
    --radius-medium: 18rpx;
    --touch-height: 74rpx;
    --font-display: 40rpx;
    --font-title: 30rpx;
    --font-heading: 26rpx;
    --font-body: 24rpx;
    --font-secondary: 21rpx;
    --font-caption: 19rpx;
  }
}

@media (min-width: 600px) {
  page {
    --page-gutter: 48rpx;
    --section-gap: 34rpx;
    --block-gap: 22rpx;
    --radius-large: 30rpx;
    --radius-medium: 22rpx;
    --touch-height: 84rpx;
    --font-display: 46rpx;
    --font-title: 34rpx;
    --font-heading: 30rpx;
    --font-body: 27rpx;
    --font-secondary: 23rpx;
    --font-caption: 21rpx;
  }
}
