page{
  --forest:#2f5f47;--forest-dark:#254b38;--forest-soft:#3b6c53;--leaf:#86a58f;--mint:#e7efe9;
  --cream:#f7f3ea;--paper:#fffdf8;--ink:#1b241e;--muted:#626d65;--line:#e7e3d9;
  --orange:#e96d3d;--gold:#b89a5a;background:var(--cream);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif
}
.card{background:var(--paper);border:1rpx solid rgba(47,95,71,.07);border-radius:26rpx;box-shadow:0 8rpx 24rpx rgba(37,75,56,.045)}
.green{color:var(--forest)}.page-shell{min-height:100vh;background:var(--cream)}
.custom-nav{position:relative;padding-left:30rpx;padding-right:30rpx}.nav-row{height:88rpx;display:flex;align-items:center;justify-content:space-between}
.nav-title{font-size:36rpx;font-weight:700;letter-spacing:1rpx;color:var(--ink)}.nav-kicker{display:block;margin-bottom:5rpx;font-size:21rpx;letter-spacing:2.4rpx;color:var(--muted)}
.section{padding:0 28rpx;margin-top:40rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:20rpx}.section-title{font-size:34rpx;line-height:1.2;font-weight:720;letter-spacing:.5rpx}.section-subtitle{display:block;margin-top:7rpx;font-size:20rpx;color:var(--muted)}.section-link{min-height:64rpx;padding:18rpx 0 0 24rpx;font-size:21rpx;color:var(--forest)}
.eyebrow{font-size:21rpx;letter-spacing:2.8rpx;font-weight:650;color:var(--forest)}
.primary-btn,.secondary-btn{height:88rpx;border-radius:24rpx;font-size:26rpx;font-weight:650;display:flex;align-items:center;justify-content:center;transition:opacity .16s ease,transform .16s ease}.primary-btn{background:var(--forest);color:#fff}.secondary-btn{background:var(--mint);color:var(--forest)}.button-pressed{opacity:.86;transform:scale(.985)}.button-disabled{opacity:.54}.button-spinner{width:26rpx;height:26rpx;margin-right:12rpx;border:4rpx solid rgba(255,255,255,.34);border-top-color:#fff;border-radius:50%;animation:spin .72s linear infinite}
.empty-state{text-align:center;padding:150rpx 40rpx;color:var(--muted)}.empty-icon{font-size:72rpx;display:block;margin-bottom:22rpx}.empty-title{display:block;font-size:29rpx;font-weight:650;color:var(--ink)}.empty-desc{display:block;margin-top:11rpx;font-size:22rpx;line-height:1.7}
.state-panel{margin:80rpx 28rpx;padding:56rpx 40rpx;text-align:center;border-radius:28rpx;background:var(--paper);border:1rpx solid var(--line)}.state-mark{width:72rpx;height:72rpx;margin:0 auto 22rpx;border-radius:24rpx;background:var(--mint);color:var(--forest);font-size:25rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.state-title{display:block;font-size:28rpx;font-weight:700}.state-desc{display:block;margin-top:11rpx;font-size:21rpx;line-height:1.65;color:var(--muted)}.state-action{width:230rpx;height:72rpx;margin:28rpx auto 0;border-radius:22rpx;background:var(--forest);color:#fff;font-size:23rpx;line-height:72rpx}
.loading-line{text-align:center;color:var(--muted);font-size:21rpx;padding:32rpx 0 52rpx}.loading-dots{display:inline-flex;align-items:center;gap:8rpx;margin-right:10rpx}.loading-dots text{width:8rpx;height:8rpx;border-radius:50%;background:var(--forest);animation:dotPulse 1.05s ease-in-out infinite}.loading-dots text:nth-child(2){animation-delay:.15s}.loading-dots text:nth-child(3){animation-delay:.3s}
.tag{display:inline-flex;align-items:center;height:40rpx;padding:0 14rpx;border-radius:20rpx;background:var(--mint);color:var(--forest);font-size:20rpx}.divider{height:1rpx;background:var(--line)}.line1{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.line2{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.skeleton{position:relative;overflow:hidden;background:#e9e9e1!important;color:transparent!important;border-color:transparent!important}.skeleton:after{content:"";position:absolute;top:0;bottom:0;left:-70%;width:55%;background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.68),rgba(255,255,255,0));animation:shimmer 1.35s ease-in-out infinite}.image-placeholder{position:absolute;inset:0;background:#ebeae2;transition:opacity .28s ease}.image-placeholder.hidden{opacity:0;pointer-events:none}.fade-image{opacity:0;transition:opacity .28s ease}.fade-image.loaded{opacity:1}.safe-fixed{padding-bottom:calc(16rpx + env(safe-area-inset-bottom))}.inline-error-home{margin:-5rpx 28rpx 16rpx;padding:14rpx 17rpx;border-radius:16rpx;background:#f5e5dd;color:#9e593b;font-size:17rpx;display:flex;justify-content:space-between}.inline-error-home text+text{font-weight:700}
@keyframes shimmer{0%{left:-70%}100%{left:125%}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes dotPulse{0%,70%,100%{opacity:.28;transform:translateY(0)}35%{opacity:1;transform:translateY(-5rpx)}}
