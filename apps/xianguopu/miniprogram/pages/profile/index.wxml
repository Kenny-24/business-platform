<view class="container">
  <view class="profile card">
    <view class="avatar">🍏</view>
    <view wx:if="{{logged}}"><view class="name">鲜果铺用户</view><view class="muted uid">ID {{user.id}}</view></view>
    <view wx:else bindtap="login"><view class="name">登录 / 注册</view><view class="muted uid">登录后查看订单与地址</view></view>
  </view>
  <view class="section card"><view class="section-title">我的订单</view><view class="order-grid"><view data-status="PENDING_PAYMENT" bindtap="orders"><text>💳</text><view>待付款</view></view><view data-status="PAID" bindtap="orders"><text>📦</text><view>待发货</view></view><view data-status="SHIPPED" bindtap="orders"><text>🚚</text><view>配送中</view></view><view data-status="" bindtap="orders"><text>🧾</text><view>全部</view></view></view></view>
  <view class="menu card"><view class="row" bindtap="addresses"><text>📍 收货地址</text><text>›</text></view><view class="row"><text>🛡️ 售后与保障</text><text>›</text></view><view class="row"><text>☎️ 联系客服</text><text>›</text></view><view class="row"><text>ℹ️ 关于鲜果铺</text><text>›</text></view></view>
</view>
