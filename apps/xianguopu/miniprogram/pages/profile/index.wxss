.profile{padding:34rpx;display:flex;align-items:center}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#eaf4ed;display:flex;align-items:center;justify-content:center;font-size:56rpx;margin-right:24rpx}.name{font-size:32rpx;font-weight:800}.uid{font-size:22rpx;margin-top:8rpx}.section{margin-top:22rpx;padding:28rpx}.section-title{font-size:28rpx;font-weight:700}.order-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:28rpx;text-align:center;font-size:22rpx;color:#606762}.order-grid text{display:block;font-size:42rpx;margin-bottom:8rpx}.menu{margin-top:22rpx;padding:0 26rpx}.row{height:100rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #f0f0ed;font-size:26rpx}.row:last-child{border-bottom:none}.row text:last-child{font-size:36rpx;color:#aeb2af}
