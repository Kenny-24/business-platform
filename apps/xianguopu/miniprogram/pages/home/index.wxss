.home-page{width:100%;min-height:100vh;overflow-x:hidden;padding-bottom:150rpx}
.brand-wrap{display:flex;align-items:center}
.brand-mark{width:50rpx;height:50rpx;margin-right:12rpx;border-radius:50%;background:#2f5f47;color:#fff;font-size:20rpx;font-weight:700;display:flex;align-items:center;justify-content:center}
.brand{display:block;font-size:31rpx;line-height:1;font-weight:750}
.brand-place{display:block;max-width:340rpx;margin-top:7rpx;overflow:hidden;font-size:20rpx;color:#626d65;white-space:nowrap;text-overflow:ellipsis}
.search-row{margin:12rpx 28rpx 16rpx;display:flex;align-items:center;gap:14rpx}
.search-box{height:76rpx;min-width:0;padding:0 21rpx;border:1rpx solid #e5e1d7;border-radius:28rpx;background:#fffdf8;display:flex;align-items:center;color:#7d867f;font-size:21rpx;flex:1;transition:opacity .16s}
.search-pressed{opacity:.75}.search-icon{margin-right:11rpx;font-size:31rpx}.search-copy{min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.search-action{margin-left:auto;padding-left:10rpx;color:#2f5f47;font-weight:650;flex:none}
.home-cart{width:76rpx;height:76rpx;border:1rpx solid #e5e1d7;border-radius:50%;background:#fffdf8;display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 7rpx 17rpx rgba(37,75,56,.05);transition:transform .15s ease}
.home-cart-icon{width:36rpx;height:36rpx}.home-cart-badge{position:absolute;right:-5rpx;top:-5rpx;min-width:30rpx;height:30rpx;padding:0 5rpx;border:3rpx solid #f7f3ea;border-radius:18rpx;background:#e96d3d;color:#fff;font-size:14rpx;line-height:27rpx;text-align:center}.cart-pressed{transform:scale(.94)}
.delivery-strip{min-height:94rpx;margin:0 28rpx 22rpx;padding:14rpx 18rpx;border:1rpx solid rgba(47,95,71,.11);border-radius:25rpx;background:#e7efe9;display:flex;align-items:center;transition:opacity .15s ease}
.delivery-pressed{opacity:.77}.delivery-mark{width:52rpx;height:52rpx;margin-right:14rpx;border-radius:17rpx;background:#fffdf8;color:#2f5f47;font-size:19rpx;font-weight:700;display:flex;align-items:center;justify-content:center;flex:none}.delivery-strip>view:nth-child(2){min-width:0;flex:1}.delivery-strip>view:nth-child(2) text{display:block;font-size:22rpx;color:#254b38;font-weight:700}.delivery-strip>view:nth-child(2) text+text{margin-top:5rpx;font-size:19rpx;color:#626d65;font-weight:400}.delivery-arrow{padding-left:12rpx;color:#2f5f47;font-size:37rpx}
.scene-row{margin:0 23rpx 25rpx;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6rpx}
.scene-item{min-width:0;padding:0 2rpx;text-align:center;line-height:normal;display:flex;flex-direction:column;align-items:center;transition:opacity .15s ease,transform .15s ease}.scene-pressed{opacity:.7;transform:scale(.96)}
.scene-icon{width:78rpx;height:78rpx;border:6rpx solid #fffdf8;border-radius:50%;background:#dfeadf;color:#2f5f47;font-size:24rpx;font-weight:750;display:flex;align-items:center;justify-content:center;box-shadow:0 6rpx 16rpx rgba(37,75,56,.07)}
.scene-gift{background:#f2ead7;color:#946f2f}.scene-pair{background:#e5eee9;color:#315d48}.scene-invite{background:#f5e5dd;color:#bd5b35}
.scene-name{display:block;margin-top:9rpx;font-size:20rpx;font-weight:650;white-space:nowrap}.scene-note{display:block;margin-top:4rpx;font-size:16rpx;color:#7c847e;white-space:nowrap}
.inline-error-home{margin:0 28rpx 16rpx}
.hero{height:374rpx;margin:0 28rpx;border-radius:31rpx;background:#dfe4d9;position:relative;overflow:hidden}
.hero-image{width:100%;height:100%;display:block}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(33,66,49,.91),rgba(35,70,52,.57) 55%,rgba(35,70,52,.04))}
.hero-copy{position:absolute;z-index:2;left:29rpx;top:39rpx;width:430rpx;color:#fff}.hero-kicker{font-size:20rpx;letter-spacing:2rpx;color:#dce9df}.hero-title{display:block;margin-top:18rpx;font-size:42rpx;line-height:1.2;font-weight:760;letter-spacing:1rpx}.hero-desc{display:block;margin-top:13rpx;font-size:20rpx;color:#eef5ef}.hero-button{width:214rpx;height:64rpx;margin-top:27rpx;border-radius:22rpx;background:#fffdf8;color:#2f5f47;font-size:20rpx;font-weight:650;line-height:64rpx}.hero-button text{margin-left:7rpx}
.taste-section{padding-right:0}.taste-section .section-head{padding-right:28rpx}.category-scroll{white-space:nowrap}.category-row{display:inline-flex;padding-right:28rpx}.category-card{width:178rpx;height:138rpx;margin-right:14rpx;padding:17rpx;border-radius:23rpx;background:#fffdf8;border:1rpx solid #e7e3d9;transition:transform .15s}.category-pressed{transform:scale(.97)}.category-icon{display:block;font-size:25rpx;color:#2f5f47}.category-name{display:block;margin-top:10rpx;font-size:22rpx;font-weight:650}.category-note{display:block;margin-top:6rpx;font-size:20rpx;color:#626d65}
.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}
.refresh-note{text-align:center;padding:30rpx 0 0;color:#626d65;font-size:20rpx}.home-footer{text-align:center;padding:56rpx 20rpx 10rpx;color:#8f9690}.home-footer text{display:block;font-size:19rpx}.home-footer text+text{margin-top:8rpx;font-size:14rpx;letter-spacing:3rpx}
