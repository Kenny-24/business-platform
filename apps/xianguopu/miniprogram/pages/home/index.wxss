.page{min-height:100vh}.nav{padding-left:30rpx;padding-right:30rpx;padding-bottom:18rpx;background:#f8f7f2}.brand{font-size:42rpx;font-weight:800;letter-spacing:2rpx}.tagline{font-size:21rpx;color:#8a918d;margin-top:4rpx}.search{height:82rpx;border-radius:41rpx;background:#fff;display:flex;align-items:center;padding:0 28rpx;color:#9ca29e;font-size:26rpx}.search-icon{font-size:40rpx;margin-right:12rpx;color:#6f7772}.hero{height:300rpx;margin-top:24rpx;border-radius:30rpx;padding:38rpx;background:linear-gradient(135deg,#1f8b59,#67b47f);color:#fff;position:relative;overflow:hidden}.hero-kicker{font-size:18rpx;letter-spacing:4rpx;opacity:.78}.hero-title{font-size:50rpx;font-weight:800;margin-top:26rpx}.hero-desc{font-size:23rpx;line-height:1.6;opacity:.86;width:480rpx;margin-top:16rpx}.hero-bubbles{position:absolute;right:20rpx;bottom:18rpx;display:flex;gap:4rpx;align-items:flex-end}.hero-bubbles text{font-size:88rpx}.hero-bubbles text:nth-child(2){font-size:70rpx}.hero-bubbles text:nth-child(3){font-size:76rpx}.cats{width:100%;margin-top:26rpx}.cat-row{display:flex;gap:14rpx;width:max-content}.cat{width:138rpx;height:132rpx;border-radius:22rpx;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:22rpx;color:#626963}.cat-icon{font-size:44rpx;margin-bottom:9rpx}.section-head{display:flex;align-items:flex-end;justify-content:space-between;margin:38rpx 0 20rpx}.section-title{font-size:34rpx;font-weight:800}.section-sub{font-size:21rpx;color:#9aa09c;margin-top:5rpx}.more{font-size:23rpx;color:#6d756f}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.loading{text-align:center;color:#929892;padding:80rpx 0}
