.cart-page{padding-bottom:180rpx}.head{display:flex;align-items:flex-end;justify-content:space-between;margin:8rpx 0 24rpx}.sub{font-size:22rpx;color:#999}.item{display:flex;padding:20rpx;margin-bottom:18rpx;align-items:center}.check{width:38rpx;height:38rpx;border:2rpx solid #c9ceca;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:23rpx;flex:none}.check.on{background:#167a4a;border-color:#167a4a}.pic{width:150rpx;height:150rpx;border-radius:18rpx;margin:0 18rpx;background:#edf1ed}.info{flex:1;min-width:0}.name{font-size:29rpx;font-weight:700}.spec{font-size:22rpx;color:#8f9691;margin-top:10rpx}.row{display:flex;align-items:flex-end;justify-content:space-between;margin-top:16rpx}.price{color:#e55332;font-size:30rpx;font-weight:800}.price text{font-size:19rpx;color:#9ba09d;font-weight:400}.step{height:52rpx;display:flex;align-items:center;background:#f3f4f1;border-radius:26rpx}.step button{width:52rpx;height:52rpx;font-size:30rpx}.step text{min-width:48rpx;text-align:center;font-size:23rpx}.remove{font-size:20rpx;color:#aaa;margin-top:12rpx}.bottom{position:fixed;left:0;right:0;bottom:0;height:122rpx;padding:14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));background:#fff;display:flex;align-items:center;box-shadow:0 -6rpx 20rpx rgba(0,0,0,.04)}.all{display:flex;align-items:center;gap:10rpx;font-size:23rpx}.sum{margin-left:auto;margin-right:24rpx;font-size:22rpx}.sum .price{margin-left:8rpx}.checkout{width:190rpx;height:78rpx;border-radius:39rpx;background:#167a4a;color:#fff;display:flex;align-items:center;justify-content:center;font-size:28rpx;font-weight:700}.empty{text-align:center;padding-top:220rpx;color:#676e69}.empty-icon{font-size:100rpx;margin-bottom:20rpx}.empty .muted{font-size:23rpx;margin-top:10rpx}
