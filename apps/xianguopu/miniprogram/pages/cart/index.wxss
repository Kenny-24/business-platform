.cart-page{padding-bottom:180rpx}.cart-count{font-size:20rpx;color:#626d65}.basket-label{margin:18rpx 30rpx 17rpx;display:flex;justify-content:space-between;align-items:flex-end}.basket-label>view text{display:block}.basket-label>view text:first-child{font-size:29rpx;font-weight:700}.basket-label>view text+text{margin-top:6rpx;font-size:20rpx;color:#626d65;font-weight:400}.basket-label>text{font-size:19rpx;color:#7c847e}
.cart-list{padding:0 28rpx;display:flex;flex-direction:column;gap:15rpx}.cart-item{padding:19rpx;display:flex;align-items:center}.check{width:36rpx;height:36rpx;border:2rpx solid #c9cec9;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:19rpx;box-sizing:border-box;flex:none;transition:background .16s ease,border-color .16s ease}.check.checked{background:#2f5f47;border-color:#2f5f47}.item-image{width:130rpx;height:130rpx;margin:0 16rpx;border-radius:20rpx;background:#ece8df;flex:none}.item-body{min-width:0;flex:1;min-height:130rpx;display:flex;flex-direction:column;justify-content:space-between}.item-name{display:block;font-size:25rpx;font-weight:700}.item-spec{display:block;margin-top:8rpx;font-size:20rpx;color:#626d65}.item-footer{display:flex;align-items:flex-end;justify-content:space-between;gap:8rpx}.item-price{padding-bottom:6rpx;font-size:25rpx;line-height:1;color:#e96d3d;font-weight:750;white-space:nowrap}.item-controls{display:flex;align-items:center;gap:8rpx;flex:none}.stepper{height:46rpx;border:1rpx solid #e1ded6;border-radius:23rpx;background:#faf8f2;display:flex;align-items:center;overflow:hidden}.stepper text{width:39rpx;text-align:center;font-size:23rpx;color:#2f5f47}.stepper .quantity{width:43rpx;font-size:18rpx;color:#263d32}.step-pressed{background:#e7efe9}
.trash-button{width:46rpx;height:46rpx;border:1rpx solid #e3dfd6;border-radius:50%;background:#fffdf8;color:#7b837d;display:flex;align-items:center;justify-content:center;transition:transform .15s ease}.trash-pressed{transform:scale(.9);background:#f5e5dd}.trash-glyph{width:20rpx;height:24rpx;position:relative}.trash-lid{position:absolute;left:2rpx;right:2rpx;top:2rpx;height:3rpx;border-radius:2rpx;background:currentColor}.trash-lid:before{content:"";position:absolute;left:5rpx;top:-4rpx;width:6rpx;height:4rpx;border:2rpx solid currentColor;border-bottom:0;border-radius:3rpx 3rpx 0 0}.trash-bin{position:absolute;left:4rpx;right:4rpx;top:8rpx;bottom:1rpx;border:2rpx solid currentColor;border-radius:1rpx 1rpx 4rpx 4rpx}
.basket-service{min-height:112rpx;margin:18rpx 28rpx 0;padding:20rpx 23rpx;display:flex;align-items:center;justify-content:space-between}.basket-service>view{display:flex;align-items:center;flex:1}.service-icon{width:48rpx;height:48rpx;margin-right:14rpx;border-radius:16rpx;background:#f5e7df;color:#e96d3d;display:flex;align-items:center;justify-content:center;font-size:18rpx;font-weight:700}.basket-service>view>view:last-child text{display:block;font-size:22rpx;font-weight:650}.basket-service>view>view:last-child text+text{margin-top:5rpx;font-size:20rpx;color:#626d65;font-weight:400}.basket-service switch{transform:scale(.78)}.basket-row{height:86rpx;margin:14rpx 28rpx 0;padding:0 23rpx;display:flex;align-items:center;justify-content:space-between}.basket-row>view{display:flex;align-items:center;font-size:21rpx;font-weight:650}.row-icon{width:40rpx;height:40rpx;margin-right:12rpx;border-radius:13rpx;background:#e7efe9;color:#2f5f47;font-size:16rpx;display:flex;align-items:center;justify-content:center}.basket-row>text{font-size:20rpx;color:#626d65}.fresh-note{margin:28rpx;padding:25rpx;border-radius:22rpx;background:#e7efe9;color:#607169}.fresh-note text{display:block;font-size:20rpx;font-weight:650;color:#2f5f47}.fresh-note text+text{margin-top:8rpx;font-size:18rpx;line-height:1.65;font-weight:400;color:#626d65}.cart-empty{padding-top:150rpx;padding-bottom:80rpx}.empty-basket{width:104rpx;height:104rpx;margin:0 auto 26rpx;border-radius:34rpx;background:#e7efe9;color:#2f5f47;font-size:29rpx;font-weight:700;line-height:104rpx}.empty-button{width:288rpx;margin:36rpx auto 0}
.recommend-section{margin-top:38rpx;padding-bottom:24rpx}.recommend-head{margin:0 28rpx 18rpx;display:flex;align-items:flex-end;justify-content:space-between}.recommend-head>view text{display:block}.recommend-head>view text+text{margin-top:6rpx;font-size:30rpx;font-weight:720}.recommend-head>text{font-size:18rpx;color:#626d65}.recommend-error{margin:0 28rpx 16rpx;padding:15rpx 18rpx;border-radius:17rpx;background:#f5e5dd;color:#914b31;font-size:18rpx;display:flex;justify-content:space-between}.recommend-error text+text{font-weight:700}.recommend-scroll{white-space:nowrap}.recommend-row{display:inline-flex;padding:0 28rpx 8rpx}.recommend-card{width:238rpx;margin-right:14rpx;padding:12rpx;border:1rpx solid #e7e3d9;border-radius:24rpx;background:#fffdf8;box-shadow:0 7rpx 18rpx rgba(37,75,56,.035);transition:opacity .15s ease}.recommend-pressed{opacity:.75}.recommend-image{width:212rpx;height:170rpx;border-radius:18rpx;background:#ece9df}.recommend-name{display:block;margin-top:13rpx;font-size:22rpx;font-weight:700}.recommend-spec{display:block;margin-top:5rpx;font-size:17rpx;color:#626d65}.recommend-price{margin-top:12rpx;display:flex;align-items:flex-end;justify-content:space-between}.recommend-price>view text{display:block;font-size:21rpx;color:#e96d3d;font-weight:750}.recommend-price>view text+text{margin-top:4rpx;font-size:16rpx;color:#8b918d;font-weight:400;text-decoration:line-through}.recommend-price button{width:48rpx;height:48rpx;border-radius:50%;background:#2f5f47;color:#fff;font-size:29rpx;line-height:46rpx;transition:transform .15s ease}.recommend-add-pressed{transform:scale(.9)}.skeleton-card{height:300rpx}.recommend-line{height:20rpx;margin:14rpx 4rpx 0}.recommend-line.short{width:60%;height:17rpx}
.checkout-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;min-height:112rpx;padding:14rpx 23rpx calc(14rpx + env(safe-area-inset-bottom));background:rgba(255,253,248,.98);border-top:1rpx solid #e8e4da;box-shadow:0 -8rpx 24rpx rgba(37,75,56,.06);display:flex;align-items:center;box-sizing:border-box}.select-all{display:flex;align-items:center;font-size:19rpx;color:#68716b}.select-all .check{margin-right:8rpx}.total-wrap{margin-left:auto;margin-right:17rpx;text-align:right;font-size:16rpx;color:#626d65}.total-wrap>text{display:block;margin-bottom:3rpx}.total-wrap view{display:flex;align-items:baseline;justify-content:flex-end;color:#e96d3d;font-weight:700;white-space:nowrap}.total-wrap view>text:first-child{font-size:18rpx}.total{font-size:34rpx;line-height:1}.checkout-button{width:178rpx;height:76rpx;border-radius:23rpx;background:#2f5f47;color:#fff;font-size:24rpx;font-weight:700;line-height:76rpx}.checkout-button[disabled]{background:#c5cbc6;color:#f7f7f4}
