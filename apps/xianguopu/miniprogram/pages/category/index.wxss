.category-page{height:100vh;overflow:hidden}.nav-guide{padding:15rpx 0;font-size:20rpx;color:#2f5f47}
.search-box{height:70rpx;margin:10rpx 28rpx 14rpx;padding:0 20rpx;border-radius:24rpx;background:#fffdf8;border:1rpx solid #e5e1d7;display:flex;align-items:center;color:#7d867f;font-size:20rpx}.search-box text:first-child{margin-right:10rpx;font-size:29rpx}.search-box text:last-child{margin-left:auto;color:#2f5f47;font-weight:650}.search-pressed{opacity:.75}
.filter-toolbar{height:68rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between}.sort-chip,.filter-trigger{height:54rpx;border:1rpx solid #dfddd4;border-radius:27rpx;background:#fffdf8;color:#5f6962;font-size:19rpx;display:flex;align-items:center;position:relative;transition:opacity .15s ease}.sort-chip{padding:0 17rpx}.sort-chip text:first-child{margin-right:8rpx;color:#8a918c}.sort-chip text:last-child{margin-left:8rpx;color:#2f5f47}.filter-trigger{padding:0 20rpx 0 16rpx;color:#2f5f47;font-weight:650}.filter-pressed{opacity:.68}.filter-lines{width:30rpx;height:27rpx;margin-right:8rpx;display:flex;flex-direction:column;justify-content:space-around}.filter-lines text{height:2rpx;border-radius:2rpx;background:#2f5f47;position:relative}.filter-lines text:nth-child(1){width:25rpx}.filter-lines text:nth-child(2){width:19rpx}.filter-lines text:nth-child(3){width:23rpx}.filter-badge{position:absolute;right:-8rpx;top:-9rpx;min-width:27rpx;height:27rpx;padding:0 4rpx;border:2rpx solid #f7f3ea;border-radius:15rpx;background:#e96d3d;color:#fff;font-size:13rpx;line-height:25rpx;text-align:center}
.catalog-layout{min-height:650rpx;margin-top:5rpx;display:flex;border-top:1rpx solid #e7e3d9}.category-rail{width:142rpx;height:100%;background:#efede5;flex:none}.category-tab{min-height:88rpx;padding:13rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#737c76;font-size:19rpx;position:relative}.category-tab>text:first-child{font-size:22rpx}.category-tab>text+text{margin-top:6rpx}.category-tab.active{background:#f7f3ea;color:#2f5f47;font-weight:700}.category-tab.active:before{content:"";position:absolute;left:0;top:25rpx;width:6rpx;height:38rpx;border-radius:0 4rpx 4rpx 0;background:#2f5f47}
.product-scroll{height:100%;flex:1}.catalog-head{padding:22rpx 18rpx 16rpx;display:flex;align-items:flex-end;justify-content:space-between}.catalog-head>view text:first-child{font-size:26rpx;font-weight:700}.catalog-head>view text+text{margin-left:9rpx;font-size:18rpx;color:#626d65}.catalog-head>text{font-size:18rpx;color:#7c847e}.product-grid,.mini-grid{padding:0 18rpx;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.mini-card{height:400rpx;border-radius:22rpx;background:#fffdf8;overflow:hidden}.mini-photo{height:240rpx;border-radius:0}.mini-line{height:22rpx;margin:17rpx 14rpx 0}.mini-line.short{width:54%;height:18rpx}.inline-error{margin:0 18rpx 16rpx;padding:16rpx 18rpx;border-radius:17rpx;background:#f6e8df;color:#9e593b;font-size:18rpx;display:flex;justify-content:space-between}.inline-error text+text{font-weight:700}.scroll-spacer{height:150rpx}.empty-state{padding:95rpx 20rpx}.empty-reset{width:180rpx;height:62rpx;margin:22rpx auto 0;border-radius:20rpx;background:#e7efe9;color:#2f5f47;font-size:20rpx;line-height:62rpx}
.filter-modal{position:fixed;z-index:100;left:0;right:0;top:0;bottom:0}.filter-mask{position:absolute;inset:0;background:rgba(17,27,21,.45)}.filter-sheet{position:absolute;left:0;right:0;bottom:0;padding:13rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#fffdf8;box-shadow:0 -16rpx 48rpx rgba(18,43,30,.16)}.filter-grabber{width:72rpx;height:7rpx;margin:0 auto 22rpx;border-radius:5rpx;background:#d8d9d4}.filter-head{display:flex;align-items:flex-start;justify-content:space-between}.filter-head>view text{display:block;font-size:29rpx;font-weight:720}.filter-head>view text+text{margin-top:7rpx;font-size:18rpx;color:#626d65;font-weight:400}.filter-head>text{padding:0 4rpx 16rpx 20rpx;color:#8a918c;font-size:35rpx}.filter-group{margin-top:28rpx}.filter-title{display:block;margin-bottom:14rpx;font-size:22rpx;font-weight:700}.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:11rpx}.option-chip{height:64rpx;border:1rpx solid #e0ddd4;border-radius:19rpx;background:#f7f4ec;color:#626d65;font-size:20rpx;display:flex;align-items:center;justify-content:center}.option-chip.active{border-color:#2f5f47;background:#e7efe9;color:#2f5f47;font-weight:700}.condition-list{border-top:1rpx solid #ece9e0}.condition-row{min-height:88rpx;border-bottom:1rpx solid #ece9e0;display:flex;align-items:center}.condition-row>view:first-child{min-width:0;flex:1}.condition-row>view:first-child text{display:block;font-size:21rpx;font-weight:650}.condition-row>view:first-child text+text{margin-top:5rpx;font-size:17rpx;color:#7c847e;font-weight:400}.condition-check{width:35rpx;height:35rpx;border:2rpx solid #cbd0cb;border-radius:50%;color:#fff;font-size:18rpx;display:flex;align-items:center;justify-content:center}.condition-row.active .condition-check{border-color:#2f5f47;background:#2f5f47}.filter-actions{display:grid;grid-template-columns:1fr 1.8fr;gap:12rpx;margin-top:26rpx}.filter-actions button{height:78rpx;border:1rpx solid #dcded8;border-radius:22rpx;background:#fff;color:#5f6862;font-size:23rpx;font-weight:650;line-height:78rpx}.filter-actions .filter-confirm{border-color:#2f5f47;background:#2f5f47;color:#fff}
