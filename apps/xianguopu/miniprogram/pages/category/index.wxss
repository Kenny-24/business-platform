.layout{height:calc(100vh - env(safe-area-inset-bottom));display:flex;background:#f8f7f2}.side{width:176rpx;height:100%;background:#f1f1ec}.side-item{height:108rpx;padding:0 10rpx;display:flex;align-items:center;justify-content:center;gap:6rpx;font-size:23rpx;color:#777f79;position:relative}.side-item.active{background:#fff;color:#167a4a;font-weight:700}.side-item.active::before{content:"";position:absolute;left:0;width:6rpx;height:42rpx;border-radius:0 6rpx 6rpx 0;background:#167a4a}.emoji{font-size:30rpx}.content{flex:1;height:100%;background:#fff}.content-inner{padding:26rpx 20rpx 120rpx}.cat-title{font-size:32rpx;font-weight:800;margin-bottom:22rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.empty{text-align:center;color:#999;padding:100rpx 0}
.more-tip{text-align:center;color:#a1a7a2;font-size:20rpx;padding:34rpx 0 10rpx}
