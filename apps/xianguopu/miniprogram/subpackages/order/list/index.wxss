.orders-page{min-height:100vh;padding-bottom:70rpx;background:#f7f3ea}.order-tabs{height:78rpx;padding-top:13rpx;white-space:nowrap}.tab-row{display:inline-flex;padding:0 27rpx}.tab-row text{height:52rpx;margin-right:10rpx;padding:0 21rpx;border-radius:20rpx;background:#ebe9e1;color:#677169;font-size:19rpx;line-height:52rpx}.tab-row text.active{background:#2f5f47;color:#fff}.refresh-line{text-align:center;padding:11rpx 0;color:#7c847e;font-size:17rpx}.inline-error{margin:14rpx 28rpx 0;padding:17rpx 19rpx;border-radius:18rpx;background:#f5e5dd;color:#a05a3d;font-size:18rpx;display:flex;justify-content:space-between}.inline-error text+text{font-weight:700}.order-list{padding:18rpx 28rpx;display:flex;flex-direction:column;gap:15rpx}.order-card{padding:22rpx;transition:opacity .15s}.card-pressed{opacity:.75}.order-head{display:flex;justify-content:space-between}.order-head>view text{display:block;font-size:18rpx;color:#565f59}.order-head>view text+text{margin-top:5rpx;font-size:15rpx;color:#9a9e9b}.status{font-size:19rpx;color:#2f5f47;font-weight:700}.quiet-status{color:#929793}.goods-row{height:112rpx;margin:19rpx 0;display:flex;gap:9rpx;overflow:hidden;position:relative}.goods-thumb{width:112rpx;height:112rpx;border-radius:18rpx;background:#ede9df;flex:none}.goods-thumb:nth-child(n+5){display:none}.more{position:absolute;right:0;top:0;width:112rpx;height:112rpx;border-radius:18rpx;background:rgba(37,75,56,.78);color:#fff;font-size:22rpx;display:flex;align-items:center;justify-content:center}.order-foot{padding-top:17rpx;border-top:1rpx solid #ece9e1;display:flex;align-items:center;justify-content:space-between}.order-foot>text{font-size:17rpx;color:#878e89}.order-foot>view{display:flex;align-items:baseline}.order-foot>view text:first-child{font-size:16rpx;color:#737b76}.order-foot>view text:nth-child(2){margin-left:6rpx;font-size:28rpx;font-weight:750;color:#e96d3d}.order-foot>view text:last-child{margin-left:14rpx;padding:7rpx 12rpx;border-radius:14rpx;background:#e7efe9;color:#2f5f47;font-size:16rpx}.empty-button{width:278rpx;margin:34rpx auto 0}.empty-icon{width:78rpx;height:78rpx;margin:0 auto 23rpx;border-radius:25rpx;background:#e7efe9;color:#2f5f47;font-size:23rpx;line-height:78rpx}
