<view class="container"><view class="order card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="head"><text>{{item.orderNo}}</text><text class="status-text">{{item.statusText}}</text></view><view class="goods"><image wx:for="{{item.items}}" wx:for-item="g" wx:key="id" src="{{g.img}}" mode="aspectFill"/></view><view class="foot"><text>共 {{item.items.length}} 种</text><text>实付 <text class="paid-price">¥{{item.totalAmount}}</text></text></view></view><view class="empty" wx:if="{{!items.length}}">暂无订单</view></view>
