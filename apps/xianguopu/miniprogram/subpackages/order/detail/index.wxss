.order-page{min-height:100vh;padding:24rpx 28rpx 80rpx;background:#f7f3ea;box-sizing:border-box}.status-card{height:176rpx;padding:30rpx;border-radius:30rpx;background:linear-gradient(135deg,#254b38,#3b6c53);color:#fff;display:flex;align-items:center}.status-symbol{width:82rpx;height:82rpx;margin-right:23rpx;border-radius:27rpx;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:29rpx;font-weight:700}.status-name{display:block;font-size:35rpx;font-weight:700}.status-desc{display:block;margin-top:9rpx;color:#d6e4d9;font-size:20rpx}.progress-card{margin-top:18rpx;padding:32rpx 25rpx 25rpx}.progress-line{height:6rpx;margin:0 60rpx;border-radius:3rpx;background:#e4e4dd;overflow:hidden}.progress-done{height:100%;background:#6f9779}.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:-15rpx}.steps>view{text-align:center;color:#9aa09c;font-size:17rpx}.steps>view>text:first-child{width:34rpx;height:34rpx;margin:0 auto 11rpx;border:5rpx solid #fffdf8;border-radius:50%;background:#d9ddd8;color:#fff;font-size:15rpx;line-height:34rpx;display:block;box-sizing:content-box}.steps>view.done{color:#315c46}.steps>view.done>text:first-child{background:#3b6c53}
.address-card,.goods-card,.fee-card,.info-card,.logistics-card{margin-top:18rpx;padding:27rpx}.card-kicker{display:block;font-size:16rpx;letter-spacing:3rpx;color:#8c928e}.address-card>view{display:flex;align-items:center;margin-top:13rpx}.receiver{font-size:27rpx;font-weight:700;margin-right:13rpx}.address-card>view text+text{font-size:20rpx;color:#777f7a}.address{display:block;margin-top:10rpx;font-size:21rpx;line-height:1.55;color:#626c66}.card-title{display:flex;justify-content:space-between;margin-bottom:6rpx}.card-title text:first-child{font-size:27rpx;font-weight:700}.card-title text+text{font-size:19rpx;color:#8d938f}.goods{padding:19rpx 0;border-bottom:1rpx solid #ece9e1;display:flex;align-items:center}.goods:last-child{border-bottom:0;padding-bottom:2rpx}.goods-image{width:112rpx;height:112rpx;margin-right:17rpx;border-radius:18rpx;background:#ece8de;flex:none}.goods-main{flex:1;min-width:0}.goods-name{display:block;font-size:24rpx;font-weight:650}.goods-spec{display:block;margin-top:8rpx;font-size:18rpx;color:#8d928f}.goods-price{font-size:23rpx;font-weight:700;color:#e96d3d}.fee-card>view{display:flex;justify-content:space-between;padding:8rpx 0;font-size:21rpx;color:#626b65}.fee-card .total{margin-top:13rpx;padding-top:20rpx;border-top:1rpx solid #ece9e1;color:#263b30;font-weight:650}.fee-card .total text+text{font-size:31rpx;color:#e96d3d}.info-card>view{display:flex;align-items:center;padding:9rpx 0;font-size:19rpx;color:#858c87}.info-card>view>text:first-child{width:128rpx}.info-card>view>text:nth-child(2){color:#505a54}.copy{margin-left:auto;padding:5rpx 12rpx;border-radius:13rpx;background:#e6eee4;color:#2f5f47}.logistics-card{display:flex;align-items:center}.logistics-icon{width:58rpx;height:58rpx;margin-right:18rpx;border-radius:19rpx;background:#e7efe9;color:#2f5f47;display:flex;align-items:center;justify-content:center;font-weight:700}.logistics-card>view:last-child text{display:block;font-size:23rpx;font-weight:650}.logistics-card>view:last-child text+text{font-size:19rpx;color:#828984;margin-top:7rpx;font-weight:400}.service-button{width:100%;height:80rpx;margin-top:30rpx;border:1rpx solid #2f5f47;border-radius:40rpx;color:#2f5f47;font-size:24rpx;line-height:80rpx}.service-note{display:block;margin-top:13rpx;text-align:center;font-size:17rpx;color:#989d99}.order-loading{padding-top:300rpx}
