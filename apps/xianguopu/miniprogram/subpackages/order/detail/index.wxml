<page-skeleton wx:if="{{loading}}" type="list" />
<view class="state-panel" wx:elif="{{error}}"><view class="state-mark">单</view><text class="state-title">订单详情暂时打不开</text><text class="state-desc">{{error}}</text><button class="state-action" bindtap="retry">重新加载</button></view>
<view class="order-page" wx:elif="{{order}}">
  <view class="status-card"><view class="status-symbol">{{order.status==='SHIPPED'?'送':(order.status==='COMPLETED'?'好':'果')}}</view><view><text class="status-name">{{order.statusText}}</text><text class="status-desc">{{order.statusDesc}}</text></view></view>
  <view class="progress-card card" wx:if="{{order.statusIndex>=0}}"><view class="progress-line"><view class="progress-done" style="width:{{order.statusIndex/3*100}}%"></view></view><view class="steps"><view wx:for="{{steps}}" wx:key="*this" class="{{order.statusIndex>=index?'done':''}}"><text>{{order.statusIndex>=index?'✓':''}}</text><text>{{item}}</text></view></view></view>
  <view class="address-card card"><text class="card-kicker">DELIVERY TO</text><view><text class="receiver">{{order.receiver}}</text><text>{{order.phone}}</text></view><text class="address">{{order.fullAddress}}</text></view>
  <view class="goods-card card"><view class="card-title"><text>商品清单</text><text>{{order.items.length}} 种水果</text></view><view class="goods" wx:for="{{order.items}}" wx:key="id"><view class="goods-image"><safe-image src="{{item.img}}" mode="aspectFill" /></view><view class="goods-main"><text class="goods-name line1">{{item.name}}</text><text class="goods-spec line1">{{item.specText}} · ×{{item.quantityText}}{{item.unitName}}</text></view><text class="goods-price" style="white-space:nowrap">¥{{item.priceText}}/{{item.unitName}}</text></view></view>
  <view class="fee-card card"><view><text>商品金额</text><text>¥{{order.subtotalText}}</text></view><view><text>配送费</text><text>{{order.freightText==='0'?'已免':'¥'+order.freightText}}</text></view><view class="total"><text>实付金额</text><text>¥{{order.totalText}}</text></view></view>
  <view class="info-card card"><view><text>订单编号</text><text>{{order.orderNo}}</text><text class="copy" bindtap="copyNo">复制</text></view><view><text>下单时间</text><text>{{order.createdText}}</text></view><view wx:if="{{order.paidText}}"><text>付款时间</text><text>{{order.paidText}}</text></view><view wx:if="{{order.deliverySlot}}"><text>配送时段</text><text>{{order.deliverySlot}}</text></view><view wx:if="{{order.isGift}}"><text>礼赠包装</text><text>需要精心包装</text></view><view wx:if="{{order.remark}}"><text>订单备注</text><text>{{order.remark}}</text></view></view>
  <view class="logistics-card card" wx:if="{{order.trackingNo}}"><view class="logistics-icon">运</view><view><text>物流信息</text><text>{{order.logisticsName}} · {{order.trackingNo}}</text></view></view>
  <button class="service-button" open-type="contact">联系水果顾问</button>
  <text class="service-note">签收如有运输造成的明显损伤，请保留照片并及时联系我们</text>
</view>
