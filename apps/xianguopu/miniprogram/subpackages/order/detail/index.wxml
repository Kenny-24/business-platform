<view class="container" wx:if="{{order}}"><view class="status card"><view class="icon">📦</view><view><text class="status-name">{{order.statusText}}</text><text>订单号 {{order.orderNo}}</text></view></view><view class="address card"><text class="receiver">{{order.receiver}} {{order.phone}}</text><text>{{order.fullAddress}}</text></view><view class="goods card"><view class="g" wx:for="{{order.items}}" wx:key="id"><image src="{{item.img}}" mode="aspectFill"/><view><text class="g-name">{{item.name}}</text><text>{{item.specText}}</text></view><view class="right">¥{{item.price}}<text>×{{item.quantity}}{{item.unitName}}</text></view></view></view><view class="fee card"><view><text>商品金额</text><text>¥{{order.subtotal}}</text></view><view><text>运费</text><text>¥{{order.freight}}</text></view><view class="total"><text>实付</text><text class="total-price">¥{{order.totalAmount}}</text></view></view><view class="logistics card" wx:if="{{order.trackingNo}}"><text class="log-title">物流信息</text><text>{{order.logisticsName}} {{order.trackingNo}}</text></view></view>
