.checkout-page{min-height:100vh;padding:23rpx 28rpx 190rpx;background:#f7f3ea;box-sizing:border-box}.refresh-pill{margin-bottom:13rpx;text-align:center;color:#718078;font-size:17rpx}.address-card{min-height:132rpx;padding:24rpx;display:flex;align-items:center}.pin{width:53rpx;height:53rpx;margin-right:16rpx;border-radius:17rpx;background:#e7efe9;color:#2f5f47;display:flex;align-items:center;justify-content:center;font-size:20rpx;font-weight:700;flex:none}.address-main{flex:1;min-width:0}.address-main>view{display:flex;align-items:center}.receiver{margin-right:11rpx;font-size:25rpx;font-weight:700}.address-main>view>text:nth-child(2){font-size:18rpx;color:#7b837e}.default{margin-left:9rpx;padding:3rpx 8rpx;border-radius:9rpx;background:#e0ebde;color:#2f5f47;font-size:14rpx}.full-address{display:block;margin-top:8rpx;font-size:19rpx;line-height:1.5;color:#606a64}.delivery-note{display:block;margin-top:7rpx;font-size:15rpx;color:#2f5f47}.arrow{margin-left:auto;color:#9ba09c;font-size:31rpx}.empty-address>view:nth-child(2){flex:1}.empty-address>view:nth-child(2) text{display:block;font-size:23rpx;font-weight:650}.empty-address>view:nth-child(2) text+text{margin-top:6rpx;font-size:17rpx;color:#8b918d;font-weight:400}.section-label{margin:29rpx 3rpx 13rpx;display:flex;align-items:flex-end;justify-content:space-between}.section-label text:first-child{font-size:22rpx;font-weight:700}.section-label text+text{font-size:16rpx;color:#8c928e}.slot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11rpx}.slot{height:82rpx;border:1rpx solid #e1ded4;border-radius:20rpx;background:#fffdf8;display:flex;align-items:center;justify-content:center;flex-direction:column}.slot text{font-size:19rpx;font-weight:650}.slot text+text{margin-top:5rpx;font-size:14rpx;color:#8c928e;font-weight:400}.slot.active{border:2rpx solid #2f5f47;background:#e7efe9;color:#2f5f47}.goods-card{padding:5rpx 22rpx}.goods-item{padding:18rpx 0;border-bottom:1rpx solid #ece9e1;display:flex;align-items:center}.goods-item:last-child{border:0}.goods-image{width:104rpx;height:104rpx;margin-right:15rpx;border-radius:18rpx;background:#ede9df;flex:none}.goods-main{flex:1;min-width:0}.goods-name{display:block;font-size:23rpx;font-weight:650}.goods-spec{display:block;margin-top:7rpx;font-size:17rpx;color:#898f8b}.goods-price{margin-left:10rpx;font-size:22rpx;font-weight:700;color:#e96d3d}.option-card{margin-top:15rpx;padding:0 23rpx}.option-row{min-height:92rpx;border-bottom:1rpx solid #ece9e1;display:flex;align-items:center;justify-content:space-between}.option-row:last-child{border:0}.option-row>view{display:flex;align-items:center;flex:1}.option-icon{width:43rpx;height:43rpx;margin-right:13rpx;border-radius:14rpx;background:#e7efe9;color:#2f5f47;font-size:16rpx;font-weight:700;display:flex;align-items:center;justify-content:center}.option-icon.gift{background:#f5e6de;color:#e96d3d}.option-row>view>view text{display:block;font-size:20rpx;font-weight:650}.option-row>view>view text+text{margin-top:4rpx;font-size:15rpx;color:#8d938f;font-weight:400}.option-row switch{transform:scale(.76)}.remark-row>text:first-child{font-size:20rpx;font-weight:650}.remark-row input{flex:1;margin-left:22rpx;text-align:right;font-size:18rpx}.fee-card{margin-top:15rpx;padding:19rpx 24rpx}.fee-card>view:not(.fee-tip){display:flex;justify-content:space-between;padding:8rpx 0;font-size:20rpx}.fee-card .free{color:#2f5f47;font-weight:650}.fee-tip{margin-top:13rpx;padding-top:14rpx;border-top:1rpx solid #ece9e1}.fee-tip text{display:block;font-size:16rpx;color:#858c87}.fee-tip text+text{margin-top:5rpx;color:#9da19e}.service-card{margin-top:24rpx;display:flex;justify-content:space-around;color:#68746c;font-size:17rpx}.service-card view{display:flex;align-items:center}.service-card view text:first-child{margin-right:5rpx;color:#2f5f47;font-weight:700}.submit-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:13rpx 27rpx calc(13rpx + env(safe-area-inset-bottom));background:rgba(255,253,248,.98);border-top:1rpx solid #e8e4d9;display:flex;align-items:center}.submit-bar>view>text{display:block;font-size:16rpx;color:#7c847f}.submit-bar>view>view{color:#e96d3d;font-weight:700}.submit-bar>view>view text:first-child{font-size:19rpx}.submit-bar>view>view text+text{font-size:35rpx}.submit-bar button{width:250rpx;height:78rpx;margin-left:auto;border-radius:23rpx;background:#2f5f47;color:#fff;font-size:23rpx;font-weight:650;display:flex;align-items:center;justify-content:center}.submit-bar button[disabled]{opacity:.72}
