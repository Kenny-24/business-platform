<view class="container checkout safe-bottom"><view class="address card" bindtap="chooseAddress" wx:if="{{address}}"><view class="pin">📍</view><view class="a-main"><view><text class="receiver">{{address.receiver}}</text><text>{{address.phone}}</text></view><view>{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view></view><text class="arrow">›</text></view><view class="address card empty-address" bindtap="chooseAddress" wx:else>＋ 添加收货地址</view><view class="goods card"><view class="g" wx:for="{{items}}" wx:key="skuId"><image src="{{item.img}}" mode="aspectFill"/><view class="g-main"><text class="g-name">{{item.name}}</text><text>{{item.specText}}</text></view><view class="g-price">¥{{item.price}}<text> × {{item.quantity}}{{item.unitName}}</text></view></view></view><view class="fee card"><view><text>商品金额</text><text>¥{{subtotal}}</text></view><view><text>运费</text><text>{{freight==='0.00'?'免运费':'¥'+freight}}</text></view></view><view class="remark card"><text>订单备注</text><input placeholder="选填，例如熟度、配送备注" bindinput="remark"/></view></view><view class="bottom"><view><text>合计 </text><text class="total-price">¥{{total}}</text></view><button bindtap="submit" loading="{{submitting}}">提交订单</button></view>
