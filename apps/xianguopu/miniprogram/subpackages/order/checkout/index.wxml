<page-skeleton wx:if="{{loading&&!loaded}}" type="form" />
<view class="state-panel" wx:elif="{{error&&!loaded}}"><view class="state-mark">单</view><text class="state-title">订单信息没有准备好</text><text class="state-desc">{{error}}</text><button class="state-action" bindtap="retry">重新加载</button></view>
<view class="checkout-page" wx:else>
  <view class="refresh-pill" wx:if="{{refreshing}}"><view class="loading-dots"><text></text><text></text><text></text></view>正在同步地址</view>
  <view class="checkout-error" wx:if="{{error}}"><text>{{error}}</text><text bindtap="retry">重试</text></view>
  <view class="address-card card" bindtap="chooseAddress" wx:if="{{address}}"><view class="pin">址</view><view class="address-main"><view><text class="receiver">{{address.receiver}}</text><text>{{address.phone}}</text><text class="default" wx:if="{{address.isDefault}}">默认</text></view><text class="full-address">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text><text class="delivery-note">配送范围与运费已确认</text></view><text class="arrow">›</text></view>
  <view class="address-card card empty-address" bindtap="chooseAddress" wx:else><view class="pin">＋</view><view><text>添加收货地址</text><text>用于确认配送范围与运费</text></view><text class="arrow">›</text></view>

  <view class="section-label"><text>送达时间</text><text>以实际配送运力为准</text></view>
  <view class="slot-grid"><view class="slot {{slot===item.key?'active':''}}" wx:for="{{slots}}" wx:key="key" data-key="{{item.key}}" bindtap="selectSlot"><text>{{item.name}}</text><text>{{item.time}}</text></view></view>

  <view class="section-label"><text>{{directPurchase?'直接购买':'商品清单'}}</text><text>{{items.length}} 种好果</text></view>
  <view class="goods-card card"><view class="goods-item" wx:for="{{items}}" wx:key="skuId"><view class="goods-image"><safe-image src="{{item.img}}" mode="aspectFill" /></view><view class="goods-main"><text class="goods-name line1">{{item.name}}</text><text class="goods-spec line1">{{item.specText}} · ×{{item.quantityText}}{{item.unitName}}</text></view><text class="goods-price" style="white-space:nowrap">¥{{item.priceText}}/{{item.unitName}}</text></view></view>

  <view class="option-card card"><view class="option-row"><view><text class="option-icon gift">礼</text><view><text>礼赠服务</text><text>包装需求会直接同步给客服</text></view></view><switch checked="{{giftEnabled}}" color="#2F5F47" bindchange="toggleGift" /></view><view class="option-row"><view><text class="option-icon">券</text><view><text>优惠服务</text><text>会员活动即将上线</text></view></view><text class="arrow">›</text></view><view class="option-row remark-row"><text>订单备注</text><input maxlength="80" value="{{remark}}" placeholder="偏好熟度、门牌补充等" bindinput="remark"/><text class="arrow">›</text></view></view>

  <view class="fee-card card"><view><text>商品金额</text><text>¥{{subtotal}}</text></view><view><text>基础配送费</text><text class="free" wx:if="{{freight==='0'}}">已免</text><text wx:else>¥{{freight}}</text></view><view class="fee-tip"><text>满 ¥{{freeShippingThreshold}} 免基础配送费</text><text>系统会在提交前再次校验库存与金额</text></view></view>
  <view class="submit-bar"><view><text>应付合计</text><view><text>¥</text><text>{{total}}</text></view></view><button bindtap="submit" disabled="{{submitting||error}}" hover-class="button-pressed"><view class="button-spinner" wx:if="{{submitting}}"></view>{{submitting?'正在提交':'提交订单'}}</button></view>
</view>
