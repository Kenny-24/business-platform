.address-page{min-height:100vh;padding:23rpx 28rpx 180rpx;background:#f7f3ea;box-sizing:border-box}.select-tip{margin-bottom:17rpx;padding:18rpx 21rpx;border-radius:19rpx;background:#e7efe9;color:#486353;font-size:18rpx;display:flex;align-items:center}.select-tip text:first-child{margin-right:9rpx;color:#2f5f47;font-weight:700}.refresh-line{text-align:center;padding:10rpx 0 18rpx;color:#7c847e;font-size:17rpx}.inline-error{margin-bottom:16rpx;padding:17rpx 19rpx;border-radius:18rpx;background:#f5e5dd;color:#a05a3d;font-size:18rpx;display:flex;justify-content:space-between}.inline-error text+text{font-weight:700}.address-list{display:flex;flex-direction:column;gap:15rpx}.address-card{min-height:144rpx;padding:24rpx 21rpx;display:flex;align-items:center;transition:opacity .15s}.address-card.default-card{border-color:#86a58f}.address-pressed{opacity:.72}.address-mark{width:64rpx;height:64rpx;margin-right:17rpx;border-radius:21rpx;background:#e7efe9;color:#2f5f47;display:flex;align-items:center;justify-content:center;font-size:23rpx;font-weight:700;flex:none}.address-main{flex:1;min-width:0}.address-main>view{display:flex;align-items:center}.receiver{font-size:25rpx;font-weight:700}.phone{margin-left:11rpx;font-size:18rpx;color:#7b837e}.default{margin-left:9rpx;padding:3rpx 8rpx;border-radius:9rpx;background:#dfeade;color:#2f5f47;font-size:14rpx}.detail{display:block;margin-top:8rpx;font-size:19rpx;line-height:1.5;color:#606a64}.choose-note{display:block;margin-top:7rpx;font-size:15rpx;color:#2f5f47}.edit{width:74rpx;height:50rpx;margin-left:10rpx;border-radius:18rpx;background:#f0eee7;color:#526159;font-size:18rpx;line-height:50rpx}.add-button{position:fixed;z-index:10;left:28rpx;right:28rpx;bottom:calc(23rpx + env(safe-area-inset-bottom));box-shadow:0 10rpx 28rpx rgba(47,95,71,.14)}.empty-icon{width:78rpx;height:78rpx;margin:0 auto 23rpx;border-radius:25rpx;background:#e7efe9;color:#2f5f47;font-size:23rpx;line-height:78rpx}
