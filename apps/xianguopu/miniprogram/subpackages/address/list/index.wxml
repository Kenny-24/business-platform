<view class="container safe-bottom"><view class="addr card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="choose"><view class="main"><view><text class="receiver">{{item.receiver}}</text><text>{{item.phone}}</text><text class="default" wx:if="{{item.isDefault}}">默认</text></view><view class="detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view></view><button class="edit" data-id="{{item.id}}" catchtap="edit">编辑</button></view><view class="empty" wx:if="{{!items.length}}">还没有收货地址</view><button class="primary-btn add" bindtap="add">新增收货地址</button></view>
