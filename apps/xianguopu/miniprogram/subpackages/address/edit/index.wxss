.edit-page{min-height:100vh;padding:23rpx 28rpx 80rpx;background:#f7f3ea;box-sizing:border-box}.form-card{padding:0 25rpx}.form-row{min-height:100rpx;border-bottom:1rpx solid #ece9e1;display:flex;align-items:center;font-size:21rpx}.form-row:last-child{border:0}.form-row>text:first-child{width:138rpx;font-weight:650;color:#35493e}.form-row input,.form-row>view{flex:1;text-align:right;font-size:20rpx;color:#525d56}.arrow{margin-left:9rpx;color:#9ba09c;font-size:31rpx}.detail-row{align-items:flex-start;padding:26rpx 0}.detail-row textarea{flex:1;min-height:135rpx;text-align:right;font-size:20rpx;line-height:1.6}.default-card{min-height:106rpx;margin-top:16rpx;padding:21rpx 25rpx;display:flex;align-items:center}.default-card>view{flex:1}.default-card text{display:block;font-size:21rpx;font-weight:650}.default-card text+text{margin-top:6rpx;font-size:16rpx;color:#8d938f;font-weight:400}.default-card switch{transform:scale(.8)}.form-error{margin:17rpx 2rpx 0;padding:15rpx 18rpx;border-radius:17rpx;background:#f5e5dd;color:#a05a3d;font-size:18rpx;display:flex;align-items:center}.form-error text:first-child{width:31rpx;height:31rpx;margin-right:9rpx;border-radius:50%;background:#e96d3d;color:#fff;text-align:center;line-height:31rpx;font-weight:700}.privacy-tip{margin:24rpx 7rpx;display:flex;align-items:flex-start;color:#828984}.privacy-tip text:first-child{width:35rpx;height:35rpx;margin-right:9rpx;border-radius:11rpx;background:#e7efe9;color:#2f5f47;text-align:center;line-height:35rpx;font-size:15rpx;font-weight:700}.privacy-tip text+text{flex:1;font-size:17rpx;line-height:1.6}.save-button{width:100%;margin-top:31rpx}.save-button[disabled]{opacity:.7}.delete-button{width:100%;height:76rpx;margin-top:16rpx;border-radius:23rpx;background:#f1e7e2;color:#b55635;font-size:21rpx;display:flex;align-items:center;justify-content:center}.delete-spinner{width:23rpx;height:23rpx;margin-right:9rpx;border:3rpx solid rgba(181,86,53,.25);border-top-color:#b55635;border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
