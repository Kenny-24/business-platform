<view class="container"><view class="form card"><view class="row"><text>收货人</text><input placeholder="姓名" value="{{receiver}}" data-k="receiver" bindinput="field"/></view><view class="row"><text>手机号</text><input type="number" placeholder="手机号码" value="{{phone}}" data-k="phone" bindinput="field"/></view><picker mode="region" value="{{region}}" bindchange="region"><view class="row"><text>所在地区</text><view>{{region[0]}} {{region[1]}} {{region[2]}}</view></view></picker><view class="row detail"><text>详细地址</text><textarea placeholder="街道、门牌号、小区等" value="{{detail}}" data-k="detail" bindinput="field"/></view><view class="row"><text>设为默认</text><switch checked="{{isDefault}}" color="#167A4A" bindchange="toggle"/></view></view><button class="primary-btn save" bindtap="save">保存地址</button></view>
