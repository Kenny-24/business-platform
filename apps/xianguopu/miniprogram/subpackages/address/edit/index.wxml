<page-skeleton wx:if="{{loading}}" type="form" />
<view class="state-panel" wx:elif="{{error}}"><view class="state-mark">址</view><text class="state-title">地址信息没有加载好</text><text class="state-desc">{{error}}</text><button class="state-action" bindtap="retry">重新加载</button></view>
<view class="edit-page" wx:else>
  <view class="form-card card">
    <view class="form-row"><text>收货人</text><input maxlength="20" placeholder="请填写姓名" value="{{receiver}}" data-key="receiver" bindinput="field"/></view>
    <view class="form-row"><text>手机号码</text><input type="number" maxlength="11" placeholder="用于配送联系" value="{{phone}}" data-key="phone" bindinput="field"/></view>
    <picker mode="region" value="{{region}}" bindchange="region"><view class="form-row"><text>所在地区</text><view>{{region[0]}} {{region[1]}} {{region[2]}}</view><text class="arrow">›</text></view></picker>
    <view class="form-row detail-row"><text>详细地址</text><textarea maxlength="100" auto-height="true" placeholder="街道、门牌号、小区等" value="{{detail}}" data-key="detail" bindinput="field"/></view>
  </view>
  <view class="default-card card"><view><text>设为默认地址</text><text>下单时优先使用此地址</text></view><switch checked="{{isDefault}}" color="#2F5F47" bindchange="toggle"/></view>
  <view class="form-error" wx:if="{{formError}}"><text>!</text><text>{{formError}}</text></view>
  <view class="privacy-tip"><text>隐</text><text>地址信息仅用于订单配送，我们会妥善保护你的隐私。</text></view>
  <button class="primary-btn save-button" disabled="{{saving||deleting}}" bindtap="save" hover-class="button-pressed"><view class="button-spinner" wx:if="{{saving}}"></view>{{saving?'正在保存':'保存地址'}}</button>
  <button class="delete-button" wx:if="{{id}}" disabled="{{saving||deleting}}" bindtap="remove"><view class="delete-spinner" wx:if="{{deleting}}"></view>{{deleting?'正在删除':'删除地址'}}</button>
</view>
