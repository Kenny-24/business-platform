<view class="container"><view class="search"><input auto-focus="true" placeholder="水果、品种、产地" value="{{keyword}}" bindinput="input" bindconfirm="search" confirm-type="search"/><button bindtap="search">搜索</button></view><view class="result-title" wx:if="{{searched}}">找到 {{products.length}} 个商品</view><view class="grid"><product-card wx:for="{{products}}" wx:key="id" product="{{item}}" bind:open="openProduct" bind:add="addCart" /></view><view class="empty" wx:if="{{searched&&!products.length}}">没有找到相关水果</view><view class="more-tip" wx:if="{{products.length}}">{{loading?'加载中…':(hasMore?'继续下滑查看更多':'已经到底了')}}</view></view>
