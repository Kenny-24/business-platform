.search-page{min-height:100vh;padding:22rpx 28rpx 80rpx;background:#f7f3ea;box-sizing:border-box}
.search-bar{height:74rpx;padding-left:20rpx;border:1rpx solid #e2ded3;border-radius:23rpx;background:#fffdf8;display:flex;align-items:center}
.search-icon{margin-right:9rpx;font-size:31rpx;color:#718078}
.search-bar input{flex:1;height:74rpx;font-size:22rpx}
.clear{padding:14rpx;font-size:28rpx;color:#9ba09c}
.search-bar button{width:82rpx;height:62rpx;margin-right:6rpx;border-radius:19rpx;background:#2f5f47;color:#fff;font-size:20rpx;line-height:62rpx;display:flex;align-items:center;justify-content:center}
.search-spinner{width:22rpx;height:22rpx;border:3rpx solid rgba(255,255,255,.32);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
.keyword-section{margin-top:38rpx}
.keyword-head{display:flex;align-items:flex-end;justify-content:space-between}
.keyword-head>view text{display:block}
.keyword-head>view text+text{margin-top:7rpx;font-size:27rpx;font-weight:700}
.keyword-head>text{font-size:17rpx;color:#8d938f}
.chips{display:flex;flex-wrap:wrap;gap:11rpx;margin-top:18rpx}
.chips text{height:52rpx;padding:0 19rpx;border:1rpx solid #e5e1d6;border-radius:20rpx;background:#fffdf8;color:#5f6c64;font-size:19rpx;line-height:52rpx}
.chips.hot text:first-child{background:#e7efe9;color:#2f5f47;border-color:#e7efe9}
.taste-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:18rpx}
.taste-card{height:122rpx;padding:15rpx 9rpx;border-radius:21rpx;background:#e7efe9;position:relative}
.taste-card text{display:block;font-size:21rpx;font-weight:700;color:#2f5f47}
.taste-card text+text{margin-top:7rpx;font-size:18rpx;color:#66766d;font-weight:400}
.taste-card text:last-child{position:absolute;right:10rpx;bottom:9rpx;font-size:18rpx}
.taste-1{background:#f5e5dd}
.taste-1 text{color:#c45e39}
.taste-2{background:#eee8f2}
.taste-2 text{color:#785d86}
.taste-3{background:#eeecd9}
.taste-3 text{color:#77703f}
.trend-list{display:flex;flex-direction:column;gap:11rpx;margin-top:18rpx}
.trend-item{min-height:116rpx;padding:12rpx;display:flex;align-items:center}
.trend-image{width:92rpx;height:92rpx;margin-right:15rpx;border-radius:17rpx;background:#ece9df;flex:none}
.trend-copy{flex:1;min-width:0}
.trend-copy text{display:block;font-size:21rpx;font-weight:650}
.trend-copy>text+text{margin-top:5rpx;font-size:18rpx;color:#626d65;font-weight:400}
.trend-price{margin-top:8rpx;display:flex;align-items:baseline;white-space:nowrap}.trend-price text{color:#e96d3d;font-size:20rpx;font-weight:700}.trend-price text+text{margin-left:9rpx;color:#8a908b;font-size:16rpx;font-weight:400;text-decoration:line-through}
.trend-item>text{padding:15rpx;font-size:29rpx;color:#9ba09c}
.trend-skeleton{margin-top:18rpx}
.trend-skeleton>view{height:116rpx;margin-bottom:11rpx;padding:12rpx;border-radius:23rpx;background:#fffdf8;display:flex;align-items:center}
.trend-skeleton>view>view:first-child{width:92rpx;height:92rpx;flex:none}
.trend-skeleton>view>view:last-child{flex:1}
.trend-skeleton>view>view:last-child view{height:22rpx;margin:0 15rpx 12rpx}
.trend-skeleton .short{width:48%;height:17rpx}
.inline-error{margin-top:18rpx;padding:18rpx;border-radius:19rpx;background:#f5e5dd;color:#a15b3c;font-size:18rpx;display:flex;justify-content:space-between}
.inline-error text+text{font-weight:700}
.result-head{margin:34rpx 2rpx 20rpx;display:flex;align-items:flex-end;justify-content:space-between}
.result-head>view text{font-size:29rpx;font-weight:700}
.result-head>view text+text{margin-left:10rpx;font-size:18rpx;color:#8b918d;font-weight:400}
.result-head>text{font-size:17rpx;color:#7b847e}
.product-grid,.result-skeleton{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15rpx}
.result-skeleton>view{height:335rpx;border-radius:23rpx;background:#fffdf8;overflow:hidden}
.result-skeleton>view>view:first-child{height:230rpx;border-radius:0}
.result-skeleton>view>view:nth-child(2){height:22rpx;margin:15rpx}
.result-skeleton .short{width:48%;height:17rpx;margin:0 15rpx}
.empty-state{padding-top:120rpx}
@keyframes spin{to{transform:rotate(360deg)}
}
