<page-skeleton wx:if="{{loading}}" type="detail" />
<view class="state-panel" wx:elif="{{error}}"><view class="state-mark">果</view><text class="state-title">这份水果档案暂时打不开</text><text class="state-desc">{{error}}</text><button class="state-action" bindtap="retry">重新读取</button></view>
  <view class="detail-page" wx:elif="{{product}}">
  <view class="product-visual">
    <view class="product-image"><safe-image src="{{product.displayImage}}" mode="aspectFill" lazy="{{false}}" /></view>
    <view class="visual-tags"><text>{{product.freshnessLabel}}</text></view><view class="favorite {{favorite?'active':''}}" bindtap="favorite">{{favorite?'♥':'♡'}}</view>
  </view>

  <view class="product-sheet">
    <view class="summary">
      <text class="origin-label">产地：{{product.originText}} · 时令：{{product.seasonText}}</text>
      <text class="product-name">{{product.name}}</text>
      <text class="product-subtitle">{{product.subtitle||product.guide.taste}}</text>
      <view class="price-row"><view class="price-main"><text class="yen">¥</text><text class="price">{{sku.price}}</text><text class="unit">/{{sku.unitName}}</text><text class="market" wx:if="{{sku.marketPrice}}">¥{{sku.marketPrice}}</text></view><text class="stock">现货 {{sku.stock}}{{sku.unitName}}</text></view>
    </view>

    <view class="detail-card taste-card"><view class="detail-head"><view><text class="eyebrow">TASTE PROFILE</text><text class="detail-title">风味档案</text></view><text class="taste-word">{{product.guide.taste}}</text></view><view class="taste-meter"><text>甜度</text><view><view style="width:{{product.sweetWidth}}%"></view></view><text>{{product.guide.sweetness}}/10</text></view><view class="taste-meter"><text>汁水</text><view><view style="width:{{product.juiceWidth}}%"></view></view><text>{{product.guide.juiciness}}/10</text></view><view class="season-note"><text>最佳赏味期</text><text>{{product.seasonText}}</text></view></view>

    <view class="detail-card purchase-card"><view class="detail-head"><view><text class="eyebrow">CHOOSE YOUR BOX</text><text class="detail-title">选择规格</text></view><text class="purchase-note">按批次供应</text></view><view class="sku-list"><view class="sku {{sku.id===item.id?'active':''}}" wx:for="{{product.skus}}" wx:key="id" data-id="{{item.id}}" bindtap="selectSku"><text>{{item.specText}}</text><text style="white-space:nowrap">¥{{item.price}}/{{item.unitName}}</text></view></view><view class="quantity-line"><view><text>购买数量</text><text>库存 {{sku.stock}}{{sku.unitName}}</text></view><view class="stepper"><text bindtap="minus">−</text><text class="qty">{{qtyText}}</text><text bindtap="plus">＋</text></view></view></view>

    <view class="detail-card"><view class="detail-head"><view><text class="eyebrow">ORIGIN STORY</text><text class="detail-title">产地与品种</text></view><text class="origin-pin">源</text></view><text class="story">{{product.originStory}}</text><view class="origin-facts"><view><text>产地</text><text>{{product.originText}}</text></view><view><text>品种</text><text>{{product.varietyText}}</text></view></view></view>

    <view class="detail-card guide-card"><view class="detail-head"><view><text class="eyebrow">FRUIT GUIDE</text><text class="detail-title">赏味与保存指南</text></view></view><view class="guide-item"><text>01</text><view><text>收到时怎么看</text><text>{{product.guide.select}}</text></view></view><view class="guide-item"><text>02</text><view><text>什么时候最好吃</text><text>{{product.guide.ripeness}}</text></view></view><view class="guide-item"><text>03</text><view><text>如何保存</text><text>{{product.guide.storage}}</text></view></view></view>
    <view class="detail-footer-note"><text>图片为品种参考，天然果实外观略有差异</text><text>口感刻度为品种风味参考，并非批次仪器检测值</text></view>
  </view>

  <view class="action-bar"><view class="cart-shortcut" bindtap="goCart"><text class="bag">篮</text><text>果篮</text><text class="badge" wx:if="{{cartCount}}">{{cartCount>99?'99+':cartCount}}</text></view><view class="action-total"><text>本次小计</text><text>¥{{subtotal}}</text></view><view class="action-buttons"><button class="add-button {{adding?'adding':''}}" disabled="{{adding||soldOut}}" bindtap="add" hover-class="button-pressed">{{soldOut?'售罄':(adding?'已加入':'加入果篮')}}</button><button class="buy-button" disabled="{{buying||soldOut}}" bindtap="buy" hover-class="button-pressed"><view class="button-spinner" wx:if="{{buying}}"></view>{{buying?'正在进入':'立即购买'}}</button></view></view>
</view>
