<view wx:if="{{product}}" class="page safe-bottom">
  <image class="hero" src="{{img}}" mode="aspectFill" />
  <view class="content">
    <view class="name">{{product.name}}</view><view class="subtitle">{{product.subtitle}}</view>
    <view class="origin">产地 {{product.origin}}<text wx:if="{{product.variety}}"> · 品种 {{product.variety}}</text></view>
    <view class="price"><text>¥</text>{{sku.price}}<text class="unit">/{{sku.unitName}}</text></view>
    <view class="block"><view class="label">选择规格</view><view class="sku-list"><view wx:for="{{product.skus}}" wx:key="id" class="sku {{sku.id===item.id?'active':''}}" data-id="{{item.id}}" bindtap="selectSku"><view>{{item.specText}}</view><text>¥{{item.price}} / {{item.unitName}}</text></view></view></view>
    <view class="block qty-row"><view><view class="label">购买数量</view><view class="tip">库存 {{sku.stock}} {{sku.unitName}}</view></view><view class="step"><button bindtap="minus">−</button><text>{{qty}}</text><button bindtap="plus">＋</button></view></view>
    <view class="block"><view class="label">商品介绍</view><view class="desc">{{product.description}}</view></view>
    <view class="promise"><view><text class="ok">✓</text> 坏果售后</view><view><text class="ok">✓</text> 品质分级</view><view><text class="ok">✓</text> 全国配送</view></view>
  </view>
  <view class="bottom"><button class="cart" open-type="none" bindtap="add">加入购物车</button><button class="buy" bindtap="buy">立即购买</button></view>
</view>
