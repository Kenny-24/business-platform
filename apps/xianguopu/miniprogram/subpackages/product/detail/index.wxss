.page{background:#fff;min-height:100vh;padding-bottom:130rpx}.hero{width:100%;height:750rpx;background:#eef1ed}.content{padding:32rpx}.name{font-size:44rpx;font-weight:800}.subtitle{font-size:25rpx;color:#707873;margin-top:10rpx}.origin{font-size:22rpx;color:#9aa09c;margin-top:16rpx}.price{font-size:48rpx;color:#e55332;font-weight:800;margin-top:20rpx}.price>text{font-size:25rpx}.price .unit{font-size:22rpx;color:#999;font-weight:400}.block{border-top:1rpx solid #f0f0ed;padding:30rpx 0;margin-top:28rpx}.label{font-size:27rpx;font-weight:700}.sku-list{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:18rpx}.sku{border:2rpx solid #e6e8e5;border-radius:16rpx;padding:18rpx 22rpx;font-size:24rpx}.sku text{display:block;font-size:19rpx;color:#8f9691;margin-top:5rpx}.sku.active{border-color:#167a4a;background:#eef8f1;color:#167a4a}.qty-row{display:flex;align-items:center;justify-content:space-between}.tip{font-size:20rpx;color:#999;margin-top:7rpx}.step{display:flex;align-items:center;background:#f4f5f2;border-radius:28rpx;height:56rpx}.step button{width:58rpx;height:56rpx;font-size:32rpx}.step text{min-width:54rpx;text-align:center}.desc{font-size:25rpx;color:#626a65;line-height:1.8;margin-top:18rpx}.promise{display:flex;justify-content:space-around;background:#f7faf7;border-radius:18rpx;padding:24rpx 10rpx;font-size:22rpx;color:#57615b}.promise .ok{color:#167a4a}.bottom{position:fixed;left:0;right:0;bottom:0;padding:14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;background:#fff;box-shadow:0 -5rpx 20rpx rgba(0,0,0,.05)}.bottom button{flex:1;height:82rpx;border-radius:41rpx;display:flex;align-items:center;justify-content:center;font-size:27rpx;font-weight:700}.cart{background:#eef6f1;color:#167a4a}.buy{background:#167a4a;color:#fff}
