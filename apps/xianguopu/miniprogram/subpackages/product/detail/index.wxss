.detail-page{min-height:100vh;padding-bottom:180rpx;background:#f7f3ea}
.product-visual{height:540rpx;position:relative;background:#ece9df;overflow:hidden}
.product-image{width:100%;height:100%;display:block}
.visual-tags{position:absolute;left:25rpx;top:23rpx;display:flex;gap:9rpx}
.visual-tags text{height:38rpx;padding:0 14rpx;border-radius:19rpx;background:rgba(255,253,248,.93);color:#2f5f47;font-size:17rpx;font-weight:650;line-height:38rpx}
.favorite{position:absolute;right:25rpx;top:21rpx;width:58rpx;height:58rpx;border-radius:50%;background:rgba(255,253,248,.9);color:#2f5f47;font-size:31rpx;text-align:center;line-height:58rpx}
.favorite.active{color:#e96d3d}
.product-sheet{position:relative;margin-top:-35rpx;padding-top:1rpx;border-radius:35rpx 35rpx 0 0;background:#f7f3ea}
.summary{padding:34rpx 31rpx 27rpx;border-radius:35rpx 35rpx 0 0;background:#fffdf8}
.origin-label{display:block;font-size:18rpx;color:#718078;letter-spacing:1rpx}
.product-name{display:block;margin-top:10rpx;font-size:40rpx;font-weight:760}
.product-subtitle{display:block;margin-top:8rpx;font-size:21rpx;color:#747d77}
.price-row{display:flex;align-items:flex-end;justify-content:space-between;margin-top:23rpx}
.price-main{display:flex;align-items:baseline;white-space:nowrap}
.yen{font-size:22rpx;color:#e96d3d;font-weight:700}
.price{font-size:42rpx;line-height:1;color:#e96d3d;font-weight:760}
.unit{font-size:18rpx;color:#e96d3d;font-weight:650}
.market{margin-left:10rpx;font-size:17rpx;color:#a5aaa6;text-decoration:line-through}
.stock{font-size:17rpx;color:#718078}
.quality-strip{height:88rpx;padding:0 23rpx;background:#e7efe9;display:grid;grid-template-columns:repeat(3,1fr)}
.quality-strip>view{display:flex;align-items:center;justify-content:center;font-size:17rpx;color:#496353}
.quality-strip>view>text:first-child{margin-right:6rpx;color:#2f5f47;font-weight:700}
.detail-card{margin:17rpx 28rpx 0;padding:28rpx;border-radius:27rpx;background:#fffdf8;border:1rpx solid rgba(47,95,71,.07)}
.detail-head{display:flex;align-items:flex-start;justify-content:space-between}
.detail-title{display:block;margin-top:7rpx;font-size:28rpx;font-weight:700}
.taste-word{margin-top:8rpx;color:#2f5f47;font-size:21rpx;font-weight:650}
.taste-meter{display:grid;grid-template-columns:62rpx 1fr 52rpx;align-items:center;gap:11rpx;margin-top:23rpx;font-size:18rpx;color:#5d6a62}
.taste-meter>view{height:9rpx;border-radius:5rpx;background:#e9e7df;overflow:hidden}
.taste-meter>view>view{height:100%;border-radius:5rpx;background:linear-gradient(90deg,#abc1b1,#3b6c53)}
.taste-meter>text:last-child{text-align:right;color:#8a918c}
.season-note{margin-top:21rpx;padding:18rpx 20rpx;border-radius:17rpx;background:#f0ecdf}
.season-note text{display:block;font-size:17rpx;color:#7c725d}
.season-note text+text{margin-top:6rpx;font-size:19rpx;color:#5d5139;font-weight:650}
.purchase-note{font-size:17rpx;color:#929793}
.sku-list{display:flex;flex-wrap:wrap;gap:11rpx;margin:19rpx 0 26rpx}
.sku{min-width:190rpx;padding:15rpx 18rpx;border:2rpx solid #e4e2da;border-radius:17rpx}
.sku text{display:block;font-size:20rpx}
.sku text+text{margin-top:5rpx;font-size:16rpx;color:#8b918d}
.sku.active{border-color:#2f5f47;background:#e7efe9;color:#2f5f47}
.quantity-line{padding-top:24rpx;border-top:1rpx solid #ece9e1;display:flex;align-items:center;justify-content:space-between}
.quantity-line>view:first-child text{display:block;font-size:21rpx;font-weight:650}
.quantity-line>view:first-child text+text{margin-top:5rpx;font-size:16rpx;color:#929793;font-weight:400}
.stepper{height:54rpx;border:1rpx solid #dedcd4;border-radius:27rpx;background:#faf8f2;display:flex;align-items:center}
.stepper text{width:50rpx;text-align:center;color:#2f5f47;font-size:25rpx}
.stepper .qty{width:57rpx;font-size:19rpx;color:#2e4137}
.origin-pin{width:51rpx;height:51rpx;border-radius:17rpx;background:#e7efe9;color:#2f5f47;display:flex;align-items:center;justify-content:center;font-size:19rpx;font-weight:700}
.story{display:block;margin-top:21rpx;font-size:20rpx;line-height:1.82;color:#5f6963}
.origin-facts{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:22rpx}
.origin-facts>view{padding:17rpx;border-radius:16rpx;background:#f2f0e8}
.origin-facts text{display:block;font-size:16rpx;color:#8d928e}
.origin-facts text+text{margin-top:6rpx;font-size:20rpx;color:#2c4136;font-weight:650}
.guide-item{display:flex;padding:23rpx 0;border-bottom:1rpx solid #ece9e0}
.guide-item:last-child{border:0;padding-bottom:2rpx}
.guide-item>text{width:48rpx;color:#86a58f;font-size:16rpx}
.guide-item>view{flex:1}
.guide-item>view text{display:block;font-size:21rpx;font-weight:650}
.guide-item>view text+text{margin-top:8rpx;font-size:19rpx;line-height:1.7;color:#717974;font-weight:400}
.detail-footer-note{text-align:center;padding:37rpx 22rpx 6rpx;color:#9a9e9a}
.detail-footer-note text{display:block;font-size:15rpx}
.detail-footer-note text+text{margin-top:6rpx}
.action-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:13rpx 21rpx calc(13rpx + env(safe-area-inset-bottom));background:rgba(255,253,248,.98);border-top:1rpx solid #e8e4d9;display:flex;align-items:center}
.cart-shortcut{width:72rpx;text-align:center;position:relative;color:#657168;font-size:16rpx;flex:none}
.bag{display:block;font-size:24rpx;color:#2f5f47;font-weight:700}
.badge{position:absolute;right:1rpx;top:-8rpx;min-width:27rpx;height:27rpx;padding:0 4rpx;border-radius:14rpx;background:#e96d3d;color:#fff;font-size:13rpx;line-height:27rpx}
.action-total{margin-left:13rpx}
.action-total text{display:block;font-size:15rpx;color:#888e8a}
.action-total text+text{margin-top:2rpx;font-size:28rpx;color:#e96d3d;font-weight:750}
.add-button{width:275rpx;height:78rpx;margin-left:auto;border-radius:23rpx;background:#2f5f47;color:#fff;font-size:23rpx;font-weight:650;display:flex;align-items:center;justify-content:center}
.add-button.adding{background:#3b6c53}
.add-button[disabled]{opacity:.72}
