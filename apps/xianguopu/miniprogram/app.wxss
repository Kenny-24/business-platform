page { background:#F8F7F2; color:#1F2924; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
view,text,image,button,input,textarea,scroll-view { box-sizing:border-box; }
button { margin:0; padding:0; background:none; border:none; line-height:1.2; }
button::after { border:none; }
.container { padding:24rpx 28rpx 40rpx; }
.card { background:#fff; border-radius:24rpx; }
.title { font-size:36rpx; font-weight:700; letter-spacing:-1rpx; }
.muted { color:#8A918D; }
.price { color:#E55332; font-weight:700; }
.primary-btn { background:#167A4A; color:#fff; height:88rpx; border-radius:44rpx; display:flex; align-items:center; justify-content:center; font-size:30rpx; font-weight:600; }
.safe-bottom { padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); }
