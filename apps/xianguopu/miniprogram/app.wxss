@import "./styles/theme.wxss";
@import "./styles/refinements.wxss";
page { min-height:100%; background:#F7F3EA; color:#1B241E; font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif; }
view,text,image,button,input,textarea,scroll-view { box-sizing:border-box; }
button { margin:0; padding:0; background:none; border:none; }
button::after { border:none; }
.container { padding:24rpx 28rpx; }
.safe-bottom { padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }
