:host{display:block;width:100%;height:100%;overflow:hidden;background:#ebeae2}
.safe-image-root{position:relative;width:100%;height:100%;overflow:hidden;background:#ebeae2}
.safe-image-placeholder{position:absolute;z-index:0;inset:0;overflow:hidden;background:#e8e8df}
.safe-image-placeholder:after{content:"";position:absolute;top:0;bottom:0;left:-70%;width:55%;background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.7),rgba(255,255,255,0));animation:safe-shimmer 1.3s ease-in-out infinite}
.safe-image-placeholder.hidden{opacity:0;pointer-events:none}
.safe-image-media{position:absolute;z-index:1;inset:0;width:100%;height:100%;display:block;opacity:1}
.safe-image-error{position:absolute;z-index:2;inset:0;display:flex;align-items:center;justify-content:center;gap:7rpx;background:rgba(245,243,235,.94);color:#405d4b;font-size:20rpx}
.safe-image-retry{font-size:25rpx;line-height:1}
@keyframes safe-shimmer{0%{left:-70%}100%{left:125%}}
