ight:1rpx;margin:30rpx 0;background:#e5e3da}.sk-meter{height:18rpx;margin-top:22rpx}.sk-profile-hero{height:280rpx;margin:-28rpx -28rpx 0;border-radius:0 0 36rpx 36rpx}.sk-panel{height:210rpx;margin-top:18rpx;border-radius:26rpx}.sk-panel.tall{height:330rpx}.sk-list-head{width:220rpx;height:52rpx;margin:28rpx 0 24rpx}.sk-list-card{min-height:154rpx;margin-top:18rpx;padding:22rpx;border-radius:25rpx;background:#fffdf8;display:flex;align-items:center}.sk-avatar{width:82rpx;height:82rpx;border-radius:50%}.sk-thumb{width:116rpx;height:116rpx;flex:none}.sk-copy{flex:1}.sk-copy .sk-line{margin-top:13rpx}.sk-copy .sk-line:first-child{margin-top:0}.sk-form-card{padding:0 25rpx;border-radius:26rpx;background:#fffdf8}.sk-form-row{height:108rpx;border-bottom:1rpx solid #ece9df;display:flex;align-items:center;justify-content:space-between}.sk-form-row view:first-child{width:120rpx;height:24rpx}.sk-form-row view+view{width:260rpx;height:24rpx}.sk-submit{height:88rpx;margin-top:36rpx;border-radius:24rpx}@keyframes shimmer{0%{left:-70%}100%{left:125%}}
