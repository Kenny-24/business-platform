.order-detail-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #f7f6f3;
}

.order-detail-scroll,
.order-detail-content,
.order-detail-layout,
.order-detail-main,
.order-detail-side {
  width: 100%;
  min-width: 0;
}

.order-detail-content {
  min-height: 100%;
  padding-top: 18rpx;
}

.status-card {
  padding: 24rpx 22rpx 20rpx;
  border: 1rpx solid #e7e4de;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(38, 34, 30, 0.035);
}

.status-card__topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.status-card__copy {
  min-width: 0;
  flex: 1;
}

.status-card__label,
.status-card__description,
.status-card__meta text,
.detail-card__eyebrow,
.detail-card__title,
.detail-card__count,
.delivery-overview__headline,
.delivery-overview__label,
.delivery-overview__time,
.delivery-overview__caption,
.delivery-compare__label,
.delivery-compare__value,
.delivery-note__label,
.delivery-note__value,
.delivery-address__full,
.logistics-card__state,
.logistics-company,
.logistics-number,
.logistics-updated,
.logistics-trace__context,
.logistics-trace__time,
.detail-product__name,
.detail-product__price,
.message-detail text,
.timeline-item__title,
.timeline-item__note,
.timeline-item__time {
  display: block;
}

.status-card__label {
  color: #171717;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.status-card__description {
  margin-top: 8rpx;
  color: #777269;
  font-size: 22rpx;
  line-height: 1.5;
}

.status-card__mark {
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 18rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #171717;
  box-shadow: 0 0 0 7rpx rgba(23, 23, 23, 0.07);
}

.status-card--pendingPayment .status-card__mark { background: #171717; }
.status-card--making .status-card__mark { background: #557293; }
.status-card--delivering .status-card__mark { background: #627e57; }
.status-card--completed .status-card__mark { background: #4e5b49; }
.status-card--cancelled .status-card__mark,
.status-card--refunded .status-card__mark { background: #8c8177; }

.status-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #efede8;
}

.status-card__meta text:first-child {
  color: #aaa59d;
  font-size: 19rpx;
}

.status-card__meta text:last-child {
  max-width: 75%;
  overflow: hidden;
  color: #625e57;
  font-size: 20rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-card {
  width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e8e5df;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(38, 34, 30, 0.028);
}

.detail-card__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 22rpx 16rpx;
}

.detail-card__eyebrow {
  color: #9a958d;
  font-family: Georgia, serif;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.detail-card__title {
  margin-top: 5rpx;
  color: #171717;
  font-size: 27rpx;
  font-weight: 700;
}

.detail-card__count {
  margin-top: 15rpx;
  color: #9a958d;
  font-size: 20rpx;
}

.delivery-card__header {
  align-items: center;
  padding-bottom: 14rpx;
}

.delivery-status-pill {
  display: inline-flex;
  min-height: 40rpx;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
  padding: 0 14rpx;
  border: 1rpx solid #e1ddd6;
  border-radius: 999rpx;
  background: #f7f5f1;
  color: #5d5952;
  font-size: 18rpx;
  font-weight: 600;
}

.delivery-status-pill__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.delivery-status-pill--confirmed { color: #5d7554; }
.delivery-status-pill--action { color: #9b763e; }
.delivery-status-pill--rejected { color: #936568; }
.delivery-status-pill--cancelled { color: #88766b; }
.delivery-status-pill--neutral { color: #6f6b65; }

.delivery-overview {
  display: flex;
  gap: 15rpx;
  margin: 0 18rpx;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: #f6f4ef;
}

.delivery-card--action .delivery-overview { background: #fbf6eb; }
.delivery-card--rejected .delivery-overview { background: #faf2f2; }
.delivery-card--cancelled .delivery-overview { background: #f5f2ef; }

.delivery-overview__accent {
  width: 4rpx;
  flex: 0 0 4rpx;
  align-self: stretch;
  border-radius: 4rpx;
  background: #171717;
}

.delivery-card--confirmed .delivery-overview__accent { background: #637d58; }
.delivery-card--action .delivery-overview__accent { background: #b68d48; }
.delivery-card--rejected .delivery-overview__accent { background: #9d7073; }
.delivery-card--cancelled .delivery-overview__accent { background: #88766b; }

.delivery-overview__content {
  min-width: 0;
  flex: 1;
}

.delivery-overview__topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.delivery-overview__headline {
  min-width: 0;
  flex: 1;
  color: #24221f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.delivery-method-text {
  flex: 0 0 auto;
  color: #8c877f;
  font-size: 18rpx;
  line-height: 1.5;
}

.delivery-overview__label {
  margin-top: 17rpx;
  color: #99948c;
  font-size: 18rpx;
}

.delivery-overview__time {
  margin-top: 6rpx;
  color: #171717;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.delivery-overview__time--empty {
  color: #9b9790;
  font-size: 24rpx;
  font-weight: 500;
}

.delivery-overview__caption {
  margin-top: 8rpx;
  color: #777269;
  font-size: 19rpx;
  line-height: 1.55;
}

.delivery-steps {
  display: flex;
  margin: 18rpx 18rpx 0;
  padding: 16rpx 8rpx 14rpx;
  border-top: 1rpx solid #efede8;
  border-bottom: 1rpx solid #efede8;
}

.delivery-step {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.delivery-step__rail {
  position: relative;
  display: flex;
  height: 28rpx;
  align-items: center;
  justify-content: center;
}

.delivery-step__dot {
  position: relative;
  z-index: 2;
  display: flex;
  width: 22rpx;
  height: 22rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d7d3cc;
  border-radius: 50%;
  background: #ffffff;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
}

.delivery-step__line {
  position: absolute;
  z-index: 1;
  top: 13rpx;
  right: -50%;
  left: 50%;
  height: 2rpx;
  background: #dedad3;
}

.delivery-step--done .delivery-step__dot {
  border-color: #171717;
  background: #171717;
}

.delivery-step--done .delivery-step__line {
  background: #9c9891;
}

.delivery-step--current .delivery-step__dot {
  border: 5rpx solid #ece9e4;
  background: #171717;
  box-shadow: 0 0 0 1rpx #bdb8af;
}

.delivery-step__title {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  color: #9a958d;
  font-size: 18rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delivery-step--done .delivery-step__title,
.delivery-step--current .delivery-step__title {
  color: #56524b;
  font-weight: 600;
}

.delivery-compare {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 14rpx 18rpx 0;
  padding: 14rpx 16rpx;
  border: 1rpx dashed #ddd8d0;
  border-radius: 14rpx;
}

.delivery-compare__label {
  flex: 0 0 auto;
  color: #99948c;
  font-size: 18rpx;
}

.delivery-compare__value {
  min-width: 0;
  color: #4f4b45;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: left;
}

.delivery-notes {
  margin: 14rpx 18rpx 0;
  overflow: hidden;
  border: 1rpx solid #ebe7e0;
  border-radius: 15rpx;
}

.delivery-note {
  padding: 14rpx 16rpx;
}

.delivery-note + .delivery-note {
  border-top: 1rpx solid #ebe7e0;
}

.delivery-note--adjustment {
  background: #fbf7ee;
}

.delivery-note__label {
  color: #99948c;
  font-size: 18rpx;
}

.delivery-note__value {
  margin-top: 5rpx;
  color: #5f5b54;
  font-size: 20rpx;
  line-height: 1.55;
}

.delivery-address {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 14rpx 18rpx 0;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f7f6f3;
}

.delivery-address:active {
  background: #f0eee9;
}

.delivery-address__pin {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border: 2rpx solid #171717;
  border-radius: 50% 50% 50% 8rpx;
  transform: rotate(-45deg) scale(0.72);
  background: #ffffff;
}

.delivery-address__pin-core {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #171717;
  transform: translate(-50%, -50%);
}

.delivery-address__content {
  min-width: 0;
  flex: 1;
}

.delivery-address__person {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  color: #2b2926;
  font-size: 21rpx;
  font-weight: 600;
}

.delivery-address__person text:last-child {
  color: #8e8981;
  font-size: 18rpx;
  font-weight: 400;
}

.delivery-address__full {
  margin-top: 5rpx;
  color: #66615a;
  font-size: 19rpx;
  line-height: 1.5;
}

.delivery-address__action {
  flex: 0 0 auto;
  color: #777269;
  font-size: 18rpx;
}

.pickup-location__hours,
.pickup-location__notice {
  display: block;
  margin-top: 4rpx;
  color: #8e8981;
  font-size: 18rpx;
  line-height: 1.5;
}

.delivery-footnote {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 14rpx 18rpx 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #efede8;
  color: #8f8a83;
  font-size: 18rpx;
  line-height: 1.5;
}

.delivery-footnote__dot {
  width: 9rpx;
  height: 9rpx;
  flex: 0 0 9rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #171717;
}

.text-action,
.outline-action {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border: 1rpx solid #dedad3;
  border-radius: 999rpx;
  color: #4f4b45;
  font-size: 18rpx;
}

.detail-row {
  display: flex;
  min-height: 60rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 22rpx;
  border-bottom: 1rpx solid #efede8;
  color: #6a655e;
  font-size: 19rpx;
}

.detail-row text:last-child {
  color: #2b2926;
  font-weight: 500;
  text-align: right;
}

.detail-row--total {
  min-height: 76rpx;
  border-bottom: 0;
  color: #171717;
  font-weight: 700;
}

.detail-row--total text:last-child {
  font-size: 28rpx;
  font-weight: 700;
}

.detail-line {
  display: none;
}

.detail-product {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 22rpx;
  border-top: 1rpx solid #efede8;
}

.detail-product__image {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  overflow: hidden;
  border-radius: 13rpx;
  background: #f0efeb;
}

.detail-product__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f5b54;
  font-size: 15rpx;
  font-weight: 700;
}

.detail-product__copy {
  min-width: 0;
  flex: 1;
}

.detail-product__name {
  overflow: hidden;
  color: #24221f;
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-product__price {
  margin-top: 5rpx;
  color: #8e8981;
  font-size: 18rpx;
}

.detail-product__right {
  flex: 0 0 auto;
  text-align: right;
}

.detail-product__right text {
  display: block;
}

.detail-product__right text:first-child {
  color: #9a958d;
  font-size: 17rpx;
}

.detail-product__right text:last-child {
  margin-top: 5rpx;
  color: #171717;
  font-size: 21rpx;
  font-weight: 700;
}

.message-detail {
  padding: 15rpx 22rpx;
  border-top: 1rpx solid #efede8;
}

.message-detail text:first-child {
  color: #8e8981;
  font-size: 18rpx;
}

.message-detail text:last-child {
  margin-top: 6rpx;
  color: #4f4b45;
  font-size: 20rpx;
  line-height: 1.6;
}

.timeline-item {
  position: relative;
  display: flex;
  gap: 14rpx;
  margin: 0 22rpx;
  padding-bottom: 18rpx;
}

.timeline-item::before {
  position: absolute;
  top: 15rpx;
  bottom: 0;
  left: 6rpx;
  width: 2rpx;
  background: #dedad3;
  content: "";
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-item__dot {
  position: relative;
  z-index: 2;
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 14rpx;
  margin-top: 5rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #171717;
  box-shadow: 0 0 0 1rpx #c9c4bc;
}

.timeline-item__copy {
  min-width: 0;
  flex: 1;
}

.timeline-item__title {
  color: #2f2c28;
  font-size: 20rpx;
  font-weight: 600;
}

.timeline-item__note {
  margin-top: 5rpx;
  color: #777269;
  font-size: 18rpx;
  line-height: 1.5;
}

.timeline-item__time {
  margin-top: 5rpx;
  color: #a09b93;
  font-size: 17rpx;
}

.info-card__bottom {
  height: 8rpx;
}

.order-detail-bottom-space {
  height: calc(130rpx + env(safe-area-inset-bottom));
}

.order-detail-fixed-bar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 12rpx;
  padding: 14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8e4de;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(12px);
}

.detail-secondary-button,
.detail-primary-button {
  display: flex;
  height: 70rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.detail-secondary-button {
  border: 1rpx solid #d8d4cd;
  background: #ffffff;
  color: #4f4b45;
}

.detail-primary-button {
  background: #171717;
  color: #ffffff;
}

.order-detail-page--wide .order-detail-content {
  max-width: 1040rpx;
  margin: 0 auto;
}

.order-detail-page--wide .order-detail-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(280rpx, 0.85fr);
  gap: 18rpx;
  align-items: start;
}

.order-detail-page--wide .order-detail-side .detail-card:first-child {
  margin-top: 18rpx;
}

.order-detail-page--compact .status-card__label {
  font-size: 28rpx;
}

.order-detail-page--compact .delivery-overview__time {
  font-size: 25rpx;
}

.order-detail-page--compact .detail-card__title {
  font-size: 25rpx;
}

.order-detail-page--compact .delivery-step__title {
  font-size: 16rpx;
}



/* V6.19.4 顺丰物流简约卡片 */
.logistics-card--compact {
  padding: 0 22rpx;
}

.logistics-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0 18rpx;
}

.logistics-status-pill {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  gap: 9rpx;
  padding: 0 14rpx;
  border: 1rpx solid #e4e0d9;
  border-radius: 999rpx;
  color: #625e57;
  font-size: 18rpx;
}

.logistics-status-pill__dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #6f895f;
}

.logistics-latest {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7f6f3;
}

.logistics-latest__mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #111111;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.logistics-latest__copy {
  min-width: 0;
  flex: 1;
}

.logistics-latest__context,
.logistics-latest__time {
  display: block;
}

.logistics-latest__context {
  color: #282521;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}

.logistics-latest__time {
  margin-top: 7rpx;
  color: #979188;
  font-size: 17rpx;
  line-height: 1.4;
}

.logistics-latest__arrow {
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 14rpx;
  border-top: 2rpx solid #8e8981;
  border-right: 2rpx solid #8e8981;
  transform: rotate(45deg);
}

.logistics-card__footer {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 10rpx 0 16rpx;
}

.logistics-waybill {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #969087;
  font-size: 18rpx;
}

.logistics-waybill text:last-child {
  max-width: 290rpx;
  overflow: hidden;
  color: #47433d;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logistics-card__actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 18rpx;
}

.logistics-link {
  color: #777168;
  font-size: 18rpx;
}

.logistics-link--primary {
  color: #111111;
  font-weight: 650;
}
