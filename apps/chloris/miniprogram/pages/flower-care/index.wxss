.care-page {
  min-height: 100vh;
  padding-bottom: 0;
  background: #f7f6f3;
}

.care-hero {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx 24rpx;
  background: linear-gradient(180deg, #fbfaf8 0%, #f4f1eb 100%);
}

.care-hero__copy {
  min-width: 0;
  flex: 1;
}

.care-hero__eyebrow,
.care-hero__title,
.care-hero__sub,
.guide-eyebrow,
.guide-title,
.guide-intro,
.section-head__title,
.section-head__sub,
.mini-note__title,
.mini-note__body {
  display: block;
}

.care-hero__eyebrow {
  color: #7e7a73;
  font-family: Georgia, serif;
  font-size: 14rpx;
  letter-spacing: 4rpx;
}

.care-hero__title {
  margin-top: 14rpx;
  color: #171614;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.28;
}

.care-hero__sub {
  margin-top: 14rpx;
  color: #68645d;
  font-size: 23rpx;
  line-height: 1.62;
}

.care-hero__visual {
  position: relative;
  display: flex;
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(34, 30, 25, 0.06);
  overflow: hidden;
}

.care-hero__icon {
  position: relative;
  z-index: 2;
  width: 66rpx;
  height: 66rpx;
}

.care-hero__petal {
  position: absolute;
  border-radius: 999rpx;
  background: #f2ece2;
}

.care-hero__petal--one {
  top: 18rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
}

.care-hero__petal--two {
  bottom: 22rpx;
  left: 18rpx;
  width: 36rpx;
  height: 36rpx;
  background: #ebe4d9;
}

.care-hero__petal--three {
  bottom: 12rpx;
  right: 28rpx;
  width: 24rpx;
  height: 24rpx;
  background: #f5efe7;
}

.guide-tabs {
  width: 100%;
  background: #ffffff;
  border-top: 1rpx solid #eeebe6;
  border-bottom: 1rpx solid #eeebe6;
}

.guide-tabs__inner {
  display: flex;
  padding: 15rpx 22rpx;
  white-space: nowrap;
}

.guide-tab {
  display: inline-flex;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  padding: 0 21rpx;
  border: 1rpx solid #e8e3da;
  border-radius: 999rpx;
  background: #ffffff;
  color: #69655f;
  font-size: 22rpx;
  line-height: 1;
}

.guide-tab--active {
  border-color: #111111;
  background: #111111;
  color: #ffffff;
}

.guide-content {
  padding: 20rpx 22rpx 0;
}

.card,
.tips-card,
.mini-note {
  border: 1rpx solid #ece8e2;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(39, 35, 30, 0.04);
}

.guide-overview {
  padding: 22rpx;
}

.card--soft-green {
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfa 100%);
}

.card--rose {
  background: linear-gradient(180deg, #ffffff 0%, #fff9fa 100%);
}

.card--hydrangea {
  background: linear-gradient(180deg, #ffffff 0%, #fafcff 100%);
}

.card--tulip {
  background: linear-gradient(180deg, #ffffff 0%, #fffbf8 100%);
}

.guide-overview__head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.guide-overview__main {
  min-width: 0;
  flex: 1;
}

.guide-eyebrow {
  color: #8a857e;
  font-family: Georgia, serif;
  font-size: 14rpx;
  letter-spacing: 3rpx;
}

.guide-title {
  margin-top: 12rpx;
  color: #1c1a18;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.guide-intro {
  margin-top: 12rpx;
  color: #6a6660;
  font-size: 22rpx;
  line-height: 1.75;
}

.guide-overview__thumb {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #f7f4ef;
}

.guide-overview__image {
  width: 62rpx;
  height: 62rpx;
}

.guide-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.guide-highlight {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #f6f3ee;
}

.guide-highlight__dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #111111;
}

.guide-highlight__text {
  color: #47433d;
  font-size: 20rpx;
}

.guide-facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.guide-fact {
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: #faf8f4;
}

.guide-fact__label,
.guide-fact__value,
.guide-step__title,
.guide-step__body,
.tips-card__title,
.tip-row__text {
  display: block;
}

.guide-fact__label {
  color: #918c84;
  font-size: 18rpx;
}

.guide-fact__value {
  margin-top: 10rpx;
  color: #191816;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.45;
}

.section-head {
  margin-top: 28rpx;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.section-head--tight {
  margin-top: 0;
  margin-bottom: 18rpx;
  padding: 0;
}

.section-head__title {
  color: #191816;
  font-size: 28rpx;
  font-weight: 700;
}

.section-head__sub {
  margin-top: 8rpx;
  color: #7a766f;
  font-size: 20rpx;
}

.steps-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #ece7e0;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(39, 35, 30, 0.03);
}

.guide-step__badge {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #111111;
}

.guide-step__number {
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
}

.guide-step__copy {
  min-width: 0;
  flex: 1;
}

.guide-step__title {
  color: #1b1917;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.guide-step__body {
  margin-top: 10rpx;
  color: #66625c;
  font-size: 22rpx;
  line-height: 1.8;
}

.tips-card {
  margin-top: 26rpx;
  padding: 20rpx;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 14rpx;
}

.tip-row__icon {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f1ea;
  color: #111111;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.tip-row__text {
  flex: 1;
  color: #66625c;
  font-size: 22rpx;
  line-height: 1.75;
}

.mini-note {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fcfbf8;
}

.mini-note__title {
  color: #181715;
  font-size: 25rpx;
  font-weight: 700;
}

.mini-note__body {
  margin-top: 10rpx;
  color: #6d6962;
  font-size: 22rpx;
  line-height: 1.75;
}

.care-bottom-space {
  height: calc(148rpx + env(safe-area-inset-bottom));
}

.care-fixed-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(74, 68, 58, 0.08);
  background: rgba(247, 246, 243, 0.96);
  backdrop-filter: blur(10px);
}

.care-fixed-bar__inner {
  display: flex;
  width: 100%;
}

.care-action {
  display: flex;
  width: 100%;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
}


/* V6.17.5：统一使用 rpx 字号，并针对小屏幕进一步压缩 */
@media (max-width: 360px) {
  .care-hero__title { font-size: 38rpx; }
  .care-hero__sub { font-size: 22rpx; }
  .guide-tab { height: 50rpx; padding: 0 18rpx; font-size: 20rpx; }
  .guide-title { font-size: 32rpx; }
  .guide-intro,
  .guide-step__body,
  .tip-row__text,
  .mini-note__body { font-size: 20rpx; }
  .guide-step__title,
  .mini-note__title { font-size: 23rpx; }
  .care-action { height: 76rpx; font-size: 24rpx; }
}
