.logistics-page{height:100vh;background:#f5f5f2;overflow:hidden}.logistics-content{padding-top:22rpx}.status-card,.summary-card,.timeline-card,.destination-card{margin-bottom:18rpx;padding:28rpx;border:1rpx solid #e8e4dd;border-radius:24rpx;background:#fff}.status-card{background:linear-gradient(135deg,#f0f4ec,#fff)}.status-card__eyebrow,.status-card__title,.status-card__desc,.destination-card__title,.destination-card__name,.destination-card__address{display:block}.status-card__eyebrow{font-size:16rpx;letter-spacing:4rpx;color:#7f8976}.status-card__title{margin-top:16rpx;font-size:36rpx;font-weight:750}.status-card__desc{margin-top:10rpx;color:#747067;font-size:21rpx}.summary-row{display:flex;min-height:72rpx;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eeeae4}.summary-row:last-child{border-bottom:0}.summary-row text{color:#7d766c;font-size:21rpx}.summary-row strong{max-width:66%;color:#222;font-size:21rpx;text-align:right}.section-head{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:700}.refresh{font-size:20rpx;font-weight:500;color:#637658}.timeline{margin-top:24rpx}.timeline-item{position:relative;display:flex;gap:20rpx;padding-bottom:30rpx}.timeline-item::after{position:absolute;top:20rpx;bottom:0;left:8rpx;width:1rpx;background:#ddd7ce;content:""}.timeline-item:last-child::after{display:none}.timeline-dot{position:relative;z-index:2;width:17rpx;height:17rpx;flex:0 0 17rpx;border:4rpx solid #fff;border-radius:50%;background:#b7b1a8;box-shadow:0 0 0 1rpx #cfc8bd}.timeline-item--active .timeline-dot{background:#64864f;box-shadow:0 0 0 2rpx #64864f}.timeline-copy{min-width:0;flex:1}.timeline-copy strong,.timeline-copy span{display:block}.timeline-copy strong{font-size:23rpx;line-height:1.55}.timeline-copy span{margin-top:8rpx;color:#9a9388;font-size:19rpx}.timeline-empty{padding:50rpx 0;color:#989187;text-align:center;font-size:21rpx}.destination-card__title{font-size:27rpx;font-weight:700}.destination-card__name{margin-top:18rpx;font-size:23rpx;font-weight:650}.destination-card__address{margin-top:10rpx;color:#777067;font-size:21rpx;line-height:1.6}.logistics-bottom-space{height:50rpx}

.summary-copy{margin-left:12rpx;color:#637658;font-size:19rpx;font-weight:500}
