.select-page{height:100vh;background:#f7f6f3;overflow:hidden}.select-content{padding-top:22rpx;padding-bottom:50rpx}.no-coupon{display:flex;height:86rpx;align-items:center;justify-content:space-between;padding:0 24rpx;border:1rpx solid #e9e4dc;border-radius:20rpx;background:#fff;font-size:23rpx}.no-coupon--active{border-color:#111}.select-list{display:flex;flex-direction:column;gap:16rpx;margin-top:18rpx}.select-card{display:flex;min-height:170rpx;align-items:center;padding:22rpx;border:1rpx solid #e8e3db;border-radius:22rpx;background:#fff}.select-card--active{border-color:#111}.select-card--disabled{opacity:.52}.select-card__value{width:150rpx;text-align:center;border-right:1rpx dashed #d8d1c7}.select-card__value text{font-size:22rpx}.select-card__value strong{font-size:46rpx}.select-card__value span{display:block;margin-top:8rpx;color:#7d766d;font-size:18rpx}.select-card__copy{min-width:0;flex:1;padding-left:22rpx}.select-card__copy strong,.select-card__copy span{display:block}.select-card__copy strong{font-size:25rpx}.select-card__copy span{margin-top:10rpx;color:#8b847a;font-size:19rpx}.select-card__reason{color:#b0685f!important}.select-card__check{width:42rpx;color:#111;font-size:26rpx;text-align:center}
