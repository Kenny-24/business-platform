.result-page {
  width: 100%;
  min-height: 100vh;
  padding-bottom: 0;
  background: #f7f7f5;
}

.result-content {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 44rpx 0;
  box-sizing: border-box;
  text-align: center;
}

.result-mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f6f6f4;
  color: #292929;
  font-size: 43rpx;
  font-weight: 700;
}

.result-title {
  margin-top: 25rpx;
  color: #292929;
  font-size: 30rpx;
  font-weight: 700;
}

.result-description {
  margin-top: 10rpx;
  color: #777772;
  font-size: 24rpx;
}

.result-number {
  margin-top: 18rpx;
  color: #9b9b96;
  font-size: 22rpx;
}

.result-notice {
  max-width: 620rpx;
  margin-top: 28rpx;
  padding: 17rpx 20rpx;
  border: 1rpx solid #eeeeeb;
  border-radius: 6rpx;
  background: #f6f6f4;
  color: #777772;
  font-size: 22rpx;
  line-height: 1.65;
}

.result-bottom-space {
  height: calc(146rpx + env(safe-area-inset-bottom));
}

.result-fixed-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(74, 68, 58, 0.08);
  background: rgba(250, 251, 248, 0.98);
  box-shadow: none;
}

.result-fixed-bar__inner {
  display: flex;
  gap: 13rpx;
}

.result-button {
  display: flex;
  flex: 1;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid #dce2d8;
  border-radius: 39rpx;
  background: #ffffff;
  color: #697167;
  font-size: 26rpx;
}

.result-button--primary {
  border-color: #111111;
  background: #111111;
  color: #ffffff;
}

/* V6.14 unified luxury-neutral visual layer */
.result-page { background:#fff; }
.result-mark { border:2rpx solid #111; background:#111; color:#fff; }
.result-title { color:#171717; font-family:inherit; font-weight:650; }
.result-notice { border:1rpx solid #eeeeeb; border-radius:0; background:#f6f6f4; color:#5b5b56; }
.result-fixed-bar { border-top:1rpx solid #eeeeeb; background:rgba(255,255,255,.98); box-shadow:none; }
.result-button { border:2rpx solid #111; border-radius:999rpx; background:#fff; color:#111; }
.result-button--primary { background:#111; color:#fff; }
