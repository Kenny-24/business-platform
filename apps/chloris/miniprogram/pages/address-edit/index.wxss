.edit-page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: #f7f6f3;
}

.edit-scroll,
.edit-content {
  width: 100%;
}

.edit-content {
  min-height: 100%;
  padding-top: 18rpx;
}

.edit-section {
  margin-top: 18rpx;
  padding: 26rpx 22rpx;
  border: 1rpx solid #eceae4;
  border-radius: 24rpx;
  background: #ffffff;
}

.edit-section:first-of-type {
  margin-top: 0;
}

.section-title {
  margin-bottom: 20rpx;
  color: #171717;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-block {
  padding-bottom: 4rpx;
}

.field-block--split-gap {
  height: 22rpx;
  padding: 0;
}

.field-block--interactive {
  cursor: pointer;
}

.field-block--textarea {
  padding-bottom: 0;
}

.field-block--switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-block--no-padding-bottom {
  padding-bottom: 0;
}

.field-block__label,
.field-block__hint,
.field-block__value {
  display: block;
  text-align: left;
}

.field-block__label {
  color: #171717;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.field-block__hint {
  margin-top: 8rpx;
  color: #8f897d;
  font-size: 26rpx;
  line-height: 1.55;
}

.field-block__input,
.field-block__textarea,
.field-block__value {
  margin-top: 14rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #f6f5f1;
  color: #1f1f1f;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: left;
  box-sizing: border-box;
}

.field-block__input {
  width: 100%;
  min-height: 88rpx;
}

.field-block__textarea {
  width: 100%;
  min-height: 168rpx;
}

.field-block__value.is-placeholder,
.field-block__input.placeholder-class,
.field-block__textarea.placeholder-class {
  color: #a39d92;
}

.field-block__inline {
  display: flex;
  align-items: center;
}

.field-block__inline .field-block__value {
  flex: 1;
  min-width: 0;
}

.field-block__inline--location .field-block__value {
  white-space: normal;
}

.field-block__chevron {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  margin-left: 14rpx;
  border-top: 2rpx solid #8d877b;
  border-right: 2rpx solid #8d877b;
  transform: rotate(45deg);
}

.label-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.label-option {
  display: inline-flex;
  min-width: 104rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid #e5e2db;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6e695f;
  font-size: 26rpx;
}

.label-option--active {
  border-color: #111111;
  background: #111111;
  color: #ffffff;
}

.edit-bottom-space {
  height: calc(124rpx + env(safe-area-inset-bottom));
}

.edit-fixed-bar {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eceae4;
  background: rgba(247, 246, 243, 0.98);
}

.edit-submit {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #111111;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.edit-submit--disabled {
  background: #b9b4aa;
}

.edit-page--wide .edit-content {
  max-width: 920rpx;
  margin: 0 auto;
}

.edit-page--compact .section-title {
  font-size: 30rpx;
}

.edit-page--compact .field-block__label {
  font-size: 28rpx;
}

.edit-page--compact .field-block__input,
.edit-page--compact .field-block__textarea,
.edit-page--compact .field-block__value,
.edit-page--compact .label-option,
.edit-page--compact .edit-submit {
  font-size: 26rpx;
}
