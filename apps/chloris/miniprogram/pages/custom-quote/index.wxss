.quote-page {
  min-height: 100vh;
  padding: 0 22rpx 0;
  background: var(--bg);
}

.quote-intro {
  padding: 28rpx 4rpx 12rpx;
}

.quote-intro__eyebrow,
.quote-intro__title,
.quote-intro__sub,
.quote-card__title,
.quote-card__hint,
.quote-notice__title,
.quote-notice__line {
  display: block;
}

.quote-intro__eyebrow {
  color: #748060;
  font-family: Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.quote-intro__title {
  margin-top: 12rpx;
  color: #2f312c;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  line-height: 1.35;
}

.quote-intro__sub {
  margin-top: 10rpx;
  color: #7f8077;
  font-size: 26rpx;
  line-height: 1.72;
}

.quote-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
}

.quote-card__title {
  color: #292929;
  font-size: 28rpx;
  font-weight: 600;
}

.quote-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.quote-image-card,
.quote-add {
  position: relative;
  height: 210rpx;
  overflow: hidden;
  border-radius: 17rpx;
  background: #f6f3ee;
}

.quote-image-card__image {
  width: 100%;
  height: 100%;
}

.quote-image-card__remove {
  position: absolute;
  top: 9rpx;
  right: 9rpx;
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(33, 30, 28, 0.56);
  color: #ffffff;
  font-size: 30rpx;
}

.quote-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #d7d0c7;
}

.quote-add__plus {
  color: #292929;
  font-size: 48rpx;
  line-height: 1;
}

.quote-add__text {
  margin-top: 8rpx;
  color: #89837c;
  font-size: 24rpx;
}

.quote-card__hint {
  margin-top: 12rpx;
  color: #97918a;
  font-size: 22rpx;
  line-height: 1.6;
}

.quote-input,
.quote-textarea {
  width: 100%;
  margin-top: 13rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #eeeeeb;
  border-radius: 6rpx;
  background: #fcfbf8;
  color: #37312d;
  font-size: 24rpx;
  box-sizing: border-box;
}

.quote-input {
  height: 66rpx;
  line-height: 66rpx;
}

.quote-textarea {
  min-height: 172rpx;
  line-height: 1.6;
}

.quote-notice {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #e2e7dc;
  border-radius: 0;
  background: #f6f6f4;
}

.quote-notice__title {
  color: #4f5b3d;
  font-size: 26rpx;
  font-weight: 600;
}

.quote-notice__line {
  margin-top: 8rpx;
  color: #6b7461;
  font-size: 24rpx;
}

.quote-contact-note {
  display: block;
  margin-top: 12rpx;
  color: #8b857e;
  font-size: 22rpx;
  line-height: 1.65;
}

.quote-bottom-space {
  height: calc(146rpx + env(safe-area-inset-bottom));
}

.quote-fixed-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(74, 68, 58, 0.08);
  background: rgba(251, 250, 247, 0.98);
  box-shadow: none;
}

.quote-fixed-bar__inner {
  width: 100%;
}

.quote-submit {
  display: flex;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 26rpx;
  box-shadow: none;
}

.quote-submit--disabled {
  opacity: 0.48;
}

@media (min-width: 720px) {
  .quote-page {
    max-width: 1120rpx;
    margin: 0 auto;
  }

  .quote-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

/* V6.14 unified luxury-neutral visual layer */
.edit-page,.profile-edit-page,.quote-page { background:#f7f7f5; }
.edit-card,.profile-edit-card,.quote-card,.quote-notice { border:1rpx solid #eeeeeb; border-radius:0; background:#fff; box-shadow:none; }
.form-row,.profile-form-row { border-bottom:1rpx solid #eeeeeb; }
.form-row__label,.profile-form-row__label,.quote-card__title { color:#171717; font-weight:650; }
.form-row__input,.form-row__textarea,.profile-form-row__input,.quote-input,.quote-textarea { border:1rpx solid #eeeeeb; border-radius:0; background:#f6f6f4; }
.label-option { border:1rpx solid #deded9; border-radius:999rpx; background:#fff; color:#5b5b56; }
.label-option--active { border-color:#111; background:#111; color:#fff; }
.avatar-visual,.quote-image-card,.quote-add { border:1rpx solid #eeeeeb; border-radius:0; background:#f3f3f1; }
.edit-fixed-bar,.profile-edit-fixed-bar,.quote-fixed-bar { border-top:1rpx solid #eeeeeb; background:rgba(255,255,255,.98); box-shadow:none; }
.edit-submit,.profile-edit-submit,.quote-submit { border:2rpx solid #111; border-radius:999rpx; background:#111; color:#fff; }
