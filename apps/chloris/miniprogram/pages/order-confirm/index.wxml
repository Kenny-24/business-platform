<view class="safe-page confirm-page {{wideLayout ? 'confirm-page--wide' : ''}} {{compactLayout ? 'confirm-page--compact' : ''}}">
  <app-nav title="订单结算" showBack solid></app-nav>

  <scroll-view class="confirm-scroll" style="height: {{contentHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="confirm-content" style="padding-left: {{horizontalPadding}}px; padding-right: {{horizontalPadding}}px;">
      <flower-loader wx:if="{{loading}}" compact text="正在核对订单信息…"></flower-loader>

      <block wx:elif="{{preview}}">
        <view class="checkout-block checkout-block--methods">
          <view class="checkout-title-row">
            <text class="checkout-title">配送方式</text>
            <text class="checkout-title__hint">请选择一种方式</text>
          </view>

          <view class="method-list">
            <view
              wx:for="{{options.deliveryMethods}}"
              wx:key="id"
              class="method-item"
              data-id="{{item.id}}"
              bindtap="selectDeliveryMethod"
              role="button"
            >
              <view class="square-check {{deliveryMethodId === item.id ? 'square-check--active' : ''}}">
                <text wx:if="{{deliveryMethodId === item.id}}">✓</text>
              </view>
              <view class="method-item__copy">
                <text class="method-item__name">{{item.name}}</text>
                <text class="method-item__description">{{item.description}}</text>
              </view>
            </view>
          </view>
        </view>

        <view
          wx:if="{{deliveryMethodId === 'delivery'}}"
          class="checkout-block checkout-block--address"
          bindtap="chooseAddress"
          role="button"
        >
          <view class="checkout-title-row checkout-title-row--address">
            <text class="checkout-title">配送地址</text>
            <view class="checkout-link">
              <text>{{address ? '更换地址' : '添加地址'}}</text>
              <view class="chevron"></view>
            </view>
          </view>

          <view wx:if="{{address}}" class="address-summary">
            <text class="address-summary__name">{{address.receiverName}} · {{address.phoneMasked || address.phone}}</text>
            <text class="address-summary__detail">{{address.fullAddress}}</text>
          </view>
          <view wx:else class="address-empty-state">
            <text class="address-empty-state__title">请添加收货地址</text>
            <text class="address-empty-state__description">用于配送鲜花与联系收货人</text>
          </view>

          <view class="address-tip">
            <text class="address-tip__title">温馨提示</text>
            <text class="address-tip__body">收货人姓名、手机号和地址仅用于本次订单履约与配送。</text>
          </view>
        </view>

        <view
          wx:else
          class="checkout-block checkout-block--address"
          bindtap="choosePickupLocation"
          role="button"
        >
          <view class="checkout-title-row checkout-title-row--address">
            <text class="checkout-title">自提门店</text>
            <view class="checkout-link">
              <text>{{pickupLocation ? '更换门店' : '选择门店'}}</text>
              <view class="chevron"></view>
            </view>
          </view>

          <view wx:if="{{pickupLocation}}" class="address-summary">
            <text class="address-summary__name">{{pickupLocation.name}}</text>
            <text class="address-summary__detail">{{pickupLocation.address}}</text>
            <text class="address-summary__meta">营业时间：{{pickupLocation.businessHours}}</text>
          </view>
          <view wx:else class="address-empty-state">
            <text class="address-empty-state__title">请选择自提门店</text>
            <text class="address-empty-state__description">查看门店地址与营业时间</text>
          </view>
        </view>

        <view class="checkout-block product-block">
          <view class="checkout-title-row">
            <text class="checkout-title">商品信息</text>
            <text class="checkout-title__hint">共 {{preview.items.length}} 种商品</text>
          </view>

          <scroll-view class="product-strip" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="product-strip__inner">
              <view wx:for="{{preview.items}}" wx:key="productId" class="product-mini">
                <image wx:if="{{item.imageUrl}}" class="product-mini__image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
                <view wx:else class="product-mini__image product-mini__placeholder">CHLORIS</view>
                <text class="product-mini__name">{{item.name}}</text>
                <view class="product-mini__meta">
                  <text class="product-mini__price">¥{{item.unitPriceText}}</text>
                  <text class="product-mini__quantity">×{{item.quantity}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="checkout-block option-block">
          <view class="flat-option" bindtap="openDeliveryTimePicker" role="button">
            <view class="flat-option__copy">
              <text class="flat-option__title">{{deliveryMethodId === 'pickup' ? '预约自提时间' : '预期送达时间'}}</text>
              <text class="flat-option__value">{{deliveryTimeText}}</text>
            </view>
            <view class="chevron"></view>
          </view>
        </view>


        <view class="checkout-block coupon-block" bindtap="chooseCoupon" role="button">
          <view class="flat-option">
            <view class="flat-option__copy">
              <text class="flat-option__title">优惠券</text>
              <text wx:if="{{selectedCoupon}}" class="flat-option__value flat-option__value--coupon">{{selectedCoupon.name}} · 减¥{{selectedCoupon.discountText}}</text>
              <text wx:elif="{{options.coupons.length}}" class="flat-option__value">选择优惠券</text>
              <text wx:else class="flat-option__value">暂无可用优惠券</text>
            </view>
            <view class="coupon-option__right">
              <text wx:if="{{selectedCoupon}}" class="coupon-option__saving">-¥{{selectedCoupon.discountText}}</text>
              <view class="chevron"></view>
            </view>
          </view>
        </view>

        <view class="checkout-block message-block">
          <view class="checkout-title-row">
            <text class="checkout-title">贺卡与留言</text>
            <text class="checkout-title__hint">选填</text>
          </view>

          <view class="message-field">
            <view class="message-field__head">
              <text class="message-field__label">贺卡内容</text>
              <text class="message-field__count">{{cardMessage.length}}/120</text>
            </view>
            <textarea
              class="message-field__input"
              value="{{cardMessage}}"
              maxlength="120"
              auto-height
              placeholder="写下想对收花人说的话"
              bindinput="updateCardMessage"
            ></textarea>
          </view>

          <view class="message-field message-field--buyer">
            <view class="message-field__head">
              <text class="message-field__label">买家留言</text>
              <text class="message-field__count">{{buyerMessage.length}}/200</text>
            </view>
            <textarea
              class="message-field__input message-field__input--buyer"
              value="{{buyerMessage}}"
              maxlength="200"
              auto-height
              placeholder="颜色偏好、花材替换或其他要求"
              bindinput="updateBuyerMessage"
            ></textarea>
          </view>
        </view>

        <view class="checkout-block amount-block">
          <view class="checkout-title-row">
            <text class="checkout-title">费用明细</text>
          </view>
          <view class="amount-row">
            <text class="amount-row__label">商品金额</text>
            <text class="amount-row__value">¥{{preview.amounts.goodsAmountText}}</text>
          </view>
          <view wx:if="{{preview.amounts.discountFen > 0}}" class="amount-row">
            <text class="amount-row__label">优惠券</text>
            <text class="amount-row__value amount-row__value--discount">-¥{{preview.amounts.discountText}}</text>
          </view>
          <view class="amount-row">
            <text class="amount-row__label">{{deliveryMethodId === 'pickup' ? '自提费用' : '配送费用'}}</text>
            <text class="amount-row__value amount-row__value--muted">{{deliveryMethodId === 'pickup' ? '无需配送费' : (preview.amounts.deliveryFeeFen > 0 ? '¥' + preview.amounts.deliveryFeeText : '按地址核算')}}</text>
          </view>
        </view>

        <view class="checkout-notice">
          {{deliveryMethodId === 'pickup' ? '付款后，工作室将按预约时间准备商品；到店时请出示订单号。' : '提交后将创建待付款订单，并按所选时间安排配送。'}}
        </view>

        <view class="confirm-bottom-space"></view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{preview}}" class="confirm-fixed-bar">
    <view class="confirm-total">
      <text class="confirm-total__label">订单金额</text>
      <text class="confirm-total__currency">¥</text>
      <text class="confirm-total__amount">{{preview.amounts.totalAmountText}}</text>
    </view>
    <view class="confirm-submit {{submitting ? 'confirm-submit--disabled' : ''}}" bindtap="submitOrder" role="button">
      {{submitting ? '处理中…' : '提交订单'}}
    </view>
  </view>

  <view wx:if="{{deliveryPickerVisible}}" class="delivery-time-mask" bindtap="closeDeliveryTimePicker">
    <view class="delivery-time-sheet" catchtap="stopDeliveryPickerTap">
      <view class="delivery-time-sheet__head">
        <text class="delivery-time-sheet__title">{{deliveryMethodId === 'pickup' ? '选择自提时间' : '选择配送时间'}}</text>
        <view class="delivery-time-sheet__close" bindtap="closeDeliveryTimePicker"></view>
      </view>
      <view class="delivery-time-columns">
        <scroll-view class="delivery-time-column delivery-time-column--dates" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:for="{{deliveryPickerDates}}" wx:key="value" class="delivery-date-option {{item.selected ? 'delivery-date-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectPickerDate">
            <text>{{item.label}}</text>
          </view>
        </scroll-view>
        <scroll-view class="delivery-time-column delivery-time-column--slots" scroll-y enhanced show-scrollbar="{{false}}">
          <view wx:for="{{deliveryPickerSlots}}" wx:key="value" class="delivery-slot-option {{item.selected ? 'delivery-slot-option--active' : ''}}" data-value="{{item.value}}" bindtap="selectPickerSlot">
            <text>{{item.value}}</text>
            <view wx:if="{{item.selected}}" class="delivery-slot-option__check">✓</view>
          </view>
        </scroll-view>
      </view>
      <view class="delivery-time-confirm" bindtap="confirmDeliveryTimePicker">完成</view>
    </view>
  </view>
</view>
